!*.*
# A negation cannot re-include a file whose PARENT directory is excluded, so
# every new file under these directories was silently unstaged by `git add -A`
# (the gate scripts are tracked only because they were force-added). Name the
# directory, then its contents.
!nkv-cpu-probe/
!nkv-cpu-probe/**
!snapshots/
!laya/
!laya/golden/
!laya/convert/
!laya/convert/**/
!laya/parity/
!laya/parity/text/
!laya/parity/results/
!decision/
!decision/golden/
!decision/bench/
!clef/
!clef/golden/
*.o
ggml-common.h
**/*.swp
!peg-parser
