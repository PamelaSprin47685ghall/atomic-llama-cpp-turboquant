#version 450

#include "rope_head.glsl"
#include "rope_funcs.glsl"

void main() {
    const uint i0 = 2*gl_GlobalInvocationID.y;
    // Host may split oversized row counts across Z (elements[0] capped).
    // Use NumWorkGroups.x — never hardcode the 32768 host cap.
    const uint row = gl_GlobalInvocationID.x + gl_NumWorkGroups.x * gl_GlobalInvocationID.z;
    if (row >= pc.nrows) {
        return;
    }
    const uint i3 = row / (pc.ne01*pc.ne02);
    const uint i2 = (row - i3 * pc.ne01*pc.ne02) / pc.ne01;
    const uint i1 = (row - i3 * pc.ne01*pc.ne02 - i2 * pc.ne01);

    rope_neox(i0, i1, i2, i3, pc);
}
