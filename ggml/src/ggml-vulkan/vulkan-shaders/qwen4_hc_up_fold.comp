#version 450

// TP5 HC F3: fold four HC streams after local up+sigmoid (TP5.md §9.3).
// Standalone shader; integration gated by GGML_TP5_HC_F3 until target-machine validation.

#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer GateBuf {
    float gate[];
};

layout(std430, binding = 1) readonly buffer LoBuf {
    float lo[];
};

layout(std430, binding = 2) writeonly buffer OutBuf {
    float out_data[];
};

layout(push_constant) uniform Params {
    uint n_elems;
    uint n_streams;
    float inv_c;
} p;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.n_elems) {
        return;
    }
    float acc = 0.0;
    for (uint s = 0u; s < p.n_streams; ++s) {
        acc += gate[s * p.n_elems + i] * lo[s * p.n_elems + i];
    }
    out_data[i] = acc * p.inv_c;
}
