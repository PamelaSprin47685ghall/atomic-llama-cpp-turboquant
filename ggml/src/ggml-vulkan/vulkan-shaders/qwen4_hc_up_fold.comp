#version 450

// Fold four HC streams after their gates have been computed. Each invocation
// owns four adjacent hidden elements; no cross-workgroup synchronization.

layout(local_size_x = 64) in;

layout(std430, binding = 0) readonly buffer GateBuf {
    vec4 gate[];
};

layout(std430, binding = 1) readonly buffer LoBuf {
    vec4 lo[];
};

layout(std430, binding = 2) writeonly buffer OutBuf {
    vec4 out_data[];
};

layout(push_constant) uniform Params {
    uint n_elems;
    uint n_streams;
    float inv_c;
} p;

void main() {
    uint i = gl_GlobalInvocationID.x;
    uint stride = p.n_elems / 4u;
    if (i >= stride) {
        return;
    }
    // Match the unfused MUL, ADD, ADD, ADD, SCALE order. In particular, do
    // not contract a multiply into an add or introduce an initial +0.
    precise vec4 acc = gate[i] * lo[i];
    for (uint s = 1u; s < p.n_streams; ++s) {
        precise vec4 product = gate[s * stride + i] * lo[s * stride + i];
        acc                  = acc + product;
    }
    precise vec4 result = acc * p.inv_c;
    out_data[i]         = result;
}
