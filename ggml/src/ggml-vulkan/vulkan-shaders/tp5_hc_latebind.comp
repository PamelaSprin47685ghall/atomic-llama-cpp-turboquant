#version 450
#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_shuffle : require

// Only INJECT and the exact Q contraction fold across subgroups via
// tp5_hc_sum32; the Q8 kernels do their own wave-local reductions. Keeping
// the include off the Q8 variants avoids compiling a dead 128-byte shared
// array (and its barrier pair) into ACT_Q8 / Q8DOT / UP_Q8DOT.
#if defined(TP5_LATE_INJECT) || defined(TP5_LATE_Q)
#include "tp5_hc_subgroup.glsl"
#endif
#if defined(TP5_LATE_Q_Q8DOT) || defined(TP5_LATE_UP_Q8DOT) || defined(TP5_LATE_PACK_WEIGHTS)
#extension GL_EXT_integer_dot_product : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#endif

// Exact LateBind-TP for Qwen4EXP HC.
//
// INJECT: compute the four exact scatter weights from the already-known HC
// inject inputs.
// Q:      precompute W_down,b * gamma_b * (rank0 ? R_b : 0 + s_b*z_p)
//         before the full TP sum is available.
// Y/Q point-of-use waits and the exact residual/RMS/LO consumers live in
// tp5_hc_resume.comp; sidecar publication lives in tp5_hc_publish.comp.

struct late_q8_0 {
    float16_t d;
    int16_t   qs[16];
};

// Definition-time packed weight layout (P1-B). The dot-product inner loop
// consumes uint32 words directly, so no per-iteration i16->i32 packing ALU
// remains in the hot path. Same block count and indexing as late_q8_0; only
// the element size differs (36B vs 34B). Conversion is bit-exact.
struct late_q8_packed {
    float   d;
    uint    qs_words[8];
};

#ifdef TP5_LATE_PACK_WEIGHTS
// One-shot weight repack: late_q8_0 -> late_q8_packed, recorded once at plan
// definition into cmd_late_pre. The first uint of the destination is a
// persistent done flag: after the first execution every later replay of this
// command buffer exits immediately (weights are immutable model data; the
// plan owns the destination buffer for its whole lifetime).
layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer SrcWeights { late_q8_0 src[]; };
layout(std430, binding = 1) coherent buffer DstPacked { late_q8_packed dst[]; };

layout(push_constant) uniform PackParams {
    uint blocks;
} p;

void main() {
    if (floatBitsToUint(dst[0].d) == 1u) return;
    const uint block = gl_GlobalInvocationID.x;
    if (block >= p.blocks) return;
    const late_q8_0 s = src[block];
    late_q8_packed out_block;
    out_block.d = float(s.d);
    [[unroll]] for (uint w = 0u; w < 8u; ++w) {
        const uint lo = uint(uint16_t(s.qs[2u * w]));
        const uint hi = uint(uint16_t(s.qs[2u * w + 1u]));
        out_block.qs_words[w] = (lo & 0xffffu) | ((hi & 0xffffu) << 16u);
    }
    dst[block + 1u] = out_block;
    memoryBarrierBuffer();
    barrier();
    if (gl_GlobalInvocationID.x == 0u) {
        if (floatBitsToUint(dst[0].d) != 1u) dst[0].d = uintBitsToFloat(1u);
    }
}
#endif

#ifdef TP5_LATE_INJECT
// Aggressive long-K inject: four stream workgroups remain independent, but
// each uses 256 lanes so the 10K projection is spread across multiple
// subgroups instead of one deep wave. tp5_hc_sum32 performs the final
// cross-subgroup fold; reassociation is explicitly permitted for fast mode.
layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer InjectWeights {
    late_q8_0 w[];
};
layout(std430, binding = 1) readonly buffer InjectInput {
    float x[];
};
layout(std430, binding = 2) writeonly buffer Scatter {
    float scatter[];
};
// Runtime active-row count published by the CPU in the RELAY broadcast header
// (word 5) before this precompute command buffer is submitted. The push
// constant keeps the capacity only as a fail-safe fallback; a maximum-capacity
// definition must not execute padded-row work (M3 invariant 2).
layout(std430, binding = 3) readonly buffer RowsHeader {
    uint rows_header[];
};

layout(push_constant) uniform InjectParams {
    uint width;
    uint streams;
    uint active_rows;
} p;

void main() {
    const uint stream = gl_WorkGroupID.x;
    const uint lane   = gl_LocalInvocationID.x;
    if (stream >= p.streams) {
        return;
    }
    const uint active_rows = rows_header[5u] != 0u ? rows_header[5u] : p.active_rows;
    const uint k_dim = p.width * p.streams;
    [[unroll]] for (uint token = 0u; token < 4u; ++token) {
        if (token >= active_rows) break;
        float acc = 0.0;
        const uint token_x_offset = token * k_dim;
        for (uint col = 8u * lane; col < k_dim; col += 8u * 256u) {
            const uint valid = min(8u, k_dim - col);
            float xv[8];
            [[unroll]] for (uint e = 0u; e < 8u; ++e) {
                xv[e] = e < valid ? x[token_x_offset + col + e] : 0.0;
            }
            const uint ib  = (stream * k_dim + col) / 32u;
            const uint iqs = col % 32u;
            const i8vec2 q0 = unpack8(int32_t(w[ib].qs[iqs / 2u])).xy;
            const i8vec2 q1 = unpack8(int32_t(w[ib].qs[iqs / 2u + 1u])).xy;
            const i8vec2 q2 = unpack8(int32_t(w[ib].qs[iqs / 2u + 2u])).xy;
            const i8vec2 q3 = unpack8(int32_t(w[ib].qs[iqs / 2u + 3u])).xy;
            const vec4 v0 = vec4(q0.x, q0.y, q1.x, q1.y);
            const vec4 v1 = vec4(q2.x, q2.y, q3.x, q3.y);
            const vec4 b0 = vec4(xv[0], xv[1], xv[2], xv[3]);
            const vec4 b1 = vec4(xv[4], xv[5], xv[6], xv[7]);
            // Match the established HC inject Q8 two-dot/FMA contraction order.
            float rowtmp = dot(b1, v1);
            rowtmp       = fma(b0.w, v0.w, rowtmp);
            rowtmp       = fma(b0.z, v0.z, rowtmp);
            rowtmp       = fma(b0.y, v0.y, rowtmp);
            rowtmp       = fma(b0.x, v0.x, rowtmp);
            acc          = fma(rowtmp, float(w[ib].d), acc);
        }
        acc = tp5_hc_sum32(acc);
        if (lane == 0u) {
            precise float scaled = acc * 0.25 + 0.0;
            precise float sig    = 1.0 / (1.0 + exp(-scaled));
            scatter[token * p.streams + stream] = sig * 2.0 + 0.0;
        }
    }
}
#endif

#ifdef TP5_LATE_UP_Q8DOT
// Aggressive approximate HC up/fold. LO is quantized once by resume_lo_q8.
// §4.1 geometry: four rows per wave, eight lanes each (32 lanes, zero idle;
// 32 rows per 256-thread WG vs 24 before). Lanes 0-1 consume two of R320's
// ten Q8 blocks each, lanes 2-7 one; the row fold is a pure power-of-two
// butterfly (masks 1/2/4) inside the aligned 8-lane group, so the old
// up_partial[240] LDS round-trip (two barriers + 24 serial fold threads)
// disappears entirely.
layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer UpWeightsQ8 { late_q8_packed up_w[]; };
layout(std430, binding = 1) readonly buffer LoQ8Input { late_q8_packed lo_q8_in[]; };
layout(std430, binding = 2) readonly buffer NormalizedInput { float norm_in[]; };
layout(std430, binding = 3) writeonly buffer MixedOutput { float mixed_out[]; };
// Runtime active rows from the RELAY broadcast header (word 5).
layout(std430, binding = 4) readonly buffer RowsHeader {
    uint rows_header[];
};

layout(push_constant) uniform UpQ8Params {
    uint width;
    uint rank_dim;
    uint streams;
    uint rows_per_wg;
    uint active_rows;
} p;

void main() {
    const uint lane = gl_SubgroupInvocationID;
    if (p.rank_dim != 320u || p.streams != 4u || p.rows_per_wg != 32u || gl_NumSubgroups != 8u) return;
    const uint active_rows = rows_header[5u] != 0u ? rows_header[5u] : p.active_rows;
    const uint blocks = 10u;
    const uint wave = gl_SubgroupID;
    const uint row_in_wave = lane >> 3u;   // 4 rows per wave32
    const uint k_lane = lane & 7u;         // 8 K-lanes per row

    [[unroll]] for (uint token = 0u; token < 4u; ++token) {
        if (token >= active_rows) break;
        const uint row = gl_WorkGroupID.x * 32u + wave * 4u + row_in_wave;
        vec4 partial = vec4(0.0);
        if (row < p.width) {
            [[unroll]] for (uint b = k_lane; b < blocks; b += 8u) {
                const late_q8_packed a = lo_q8_in[token * blocks + b];
                [[unroll]] for (uint stream = 0u; stream < 4u; ++stream) {
                    const uint weight_row = stream * p.width + row;
                    // Packed weights (P1-B): block i lives at index i + 1;
                    // index 0 is the persistent pack done flag.
                    const late_q8_packed w = up_w[weight_row * blocks + b + 1u];
                    int32_t isum = 0;
                    [[unroll]] for (uint k = 0u; k < 8u; ++k) {
                        isum += dotPacked4x8EXT(int32_t(w.qs_words[k]), int32_t(a.qs_words[k]));
                    }
                    partial[stream] += float(isum) * (w.d * a.d);
                }
            }
        }
        // Power-of-two butterfly inside the aligned 8-lane group: masks 1/2/4
        // never leave the row. After three steps every lane of the group
        // holds the full 10-block row sum; lane 0 commits the epilogue.
        vec4 acc = partial;
        acc += subgroupShuffleXor(acc, 1u);
        acc += subgroupShuffleXor(acc, 2u);
        acc += subgroupShuffleXor(acc, 4u);
        if (k_lane == 0u && row < p.width) {
            const vec4 gate = vec4(1.0) / (vec4(1.0) + exp(-acc));
            const uint norm_token_offset = token * (4u * p.width);
            const vec4 n = vec4(norm_in[norm_token_offset + row],
                                norm_in[norm_token_offset + p.width + row],
                                norm_in[norm_token_offset + 2u * p.width + row],
                                norm_in[norm_token_offset + 3u * p.width + row]);
            mixed_out[token * p.width + row] = dot(n, gate) * 0.25;
        }
    }
}
#endif

#ifdef TP5_LATE_ACT_Q8
// Aggressive path: form each 32-element local sufficient-statistic activation
// once, quantize it to Q8_0, then reuse that block across every output row.
// One 256-thread WG contains eight wave32 subgroups: two blocks for each of
// four streams. This halves WG scheduling while preserving one wave32
// reduction per Q8 block.
layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer Gamma { float gamma[]; };
layout(std430, binding = 1) readonly buffer Residual { float residual[]; };
layout(std430, binding = 2) readonly buffer LocalZ { float local_z[]; };
layout(std430, binding = 3) readonly buffer Scatter { float scatter[]; };
layout(std430, binding = 4) writeonly buffer ActivationQ8 { late_q8_packed act_q8[]; };
// Runtime active rows from the RELAY broadcast header (word 5).
layout(std430, binding = 5) readonly buffer RowsHeader {
    uint rows_header[];
};

layout(push_constant) uniform ActQ8Params {
    uint width;
    uint streams;
    uint my_rank;
    uint active_rows;
} p;

shared int q_shared[256];
shared float z_shared[64];

void main() {
    const uint lane = gl_SubgroupInvocationID;
    const uint subgroup = gl_SubgroupID;
    const uint stream = subgroup & 3u;
    const uint block_slot = subgroup >> 2u;
    const uint block = gl_WorkGroupID.x * 2u + block_slot;
    const uint blocks = p.width / 32u;
    if (p.streams != 4u || gl_NumSubgroups != 8u || (blocks & 1u) != 0u || block >= blocks) return;
    const uint active_rows = rows_header[5u] != 0u ? rows_header[5u] : p.active_rows;

    [[unroll]] for (uint token = 0u; token < 4u; ++token) {
        if (token >= active_rows) break;
        const uint col = block * 32u + lane;
        const uint global_col = stream * p.width + col;
        if (stream == 0u) z_shared[block_slot * 32u + lane] = local_z[token * p.width + col];
        barrier();
        precise float value = z_shared[block_slot * 32u + lane] * scatter[token * p.streams + stream];
        if (p.my_rank == 0u) value = value + residual[token * (p.streams * p.width) + global_col];
        value = value * gamma[global_col];

        const float amax = subgroupMax(abs(value));
        const float d = amax * (1.0 / 127.0);
        const float inv_d = d != 0.0 ? 1.0 / d : 0.0;
        const int q = clamp(int(round(value * inv_d)), -127, 127);
        q_shared[subgroup * 32u + lane] = q;
        barrier();

        const uint out_block = token * (p.streams * blocks) + stream * blocks + block;
        if (lane == 0u) act_q8[out_block].d = d;
        if (lane < 8u) {
            const uint base = subgroup * 32u + 4u * lane;
            const uint w0 = uint(q_shared[base]) & 0xffu | (uint(q_shared[base + 1u]) & 0xffu) << 8u;
            const uint w1 = uint(q_shared[base + 2u]) & 0xffu | (uint(q_shared[base + 3u]) & 0xffu) << 8u;
            act_q8[out_block].qs_words[2u * lane] = w0;
            act_q8[out_block].qs_words[2u * lane + 1u] = w1;
        }
        barrier();
    }
}
#endif

#ifdef TP5_LATE_Q_Q8DOT
// Aggressive approximate sufficient-statistic contraction. R=320 output rows
// are packed two per wave32: 16 lanes cooperate on one row, each lane consumes
// five of the production width=2560's 80 Q8 blocks. A 256-thread WG therefore
// produces 16 rows with half the waves of one-row-per-wave scheduling.
layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer DownWeightsQ8 { late_q8_packed w_q8[]; };
layout(std430, binding = 1) readonly buffer ActivationQ8 { late_q8_packed act_q8[]; };
// Cached HOST_VISIBLE|HOST_COHERENT|DEVICE_COHERENT_AMD local VRAM. The
// The compact F16 sidecar starts at p.late_word_offset. The immediately
// preceding 64-byte cache line is Q-only control, avoiding false sharing with
// Y generation in the main relay header. CPU reads/reduces this BAR mapping
// in-place, so the aggressive path never stages Q through imported system RAM.
layout(std430, binding = 2) coherent volatile buffer QMailbox { uint qmail[]; };

layout(push_constant) uniform Q8DotParams {
    uint width;
    uint rank_dim;
    uint streams;
    uint rows_per_wg;
    uint n_workgroups;
    uint late_word_offset;
    uint active_rows;
} p;

shared uint publish_last;

void main() {
    if (p.streams != 4u || p.rows_per_wg != 16u || gl_WorkGroupID.x >= p.n_workgroups) return;
    // qmail[5] is RELAY header word 5: the CPU-published active-row count.
    const uint active_rows = qmail[5u] != 0u ? qmail[5u] : p.active_rows;
    const uint lid = gl_LocalInvocationID.x;
    const uint row_slot = lid >> 4u;
    const uint lane16 = lid & 15u;
    const uint row = gl_WorkGroupID.x * 16u + row_slot;
    const uint blocks = p.width / 32u;

    [[unroll]] for (uint token = 0u; token < 4u; ++token) {
        if (token >= active_rows) break;
        vec4 acc = vec4(0.0);
        const uint token_act_offset = token * (p.streams * blocks);
        for (uint block = lane16; block < blocks; block += 16u) {
            [[unroll]] for (uint stream = 0u; stream < 4u; ++stream) {
                // Packed weights (P1-B): block i lives at index i + 1;
                // index 0 is the persistent pack done flag.
                const uint wi = (row * 4u + stream) * blocks + block + 1u;
                const uint ai = token_act_offset + stream * blocks + block;
                int32_t isum = 0;
                [[unroll]] for (uint k = 0u; k < 8u; ++k) {
                    isum += dotPacked4x8EXT(int32_t(w_q8[wi].qs_words[k]),
                                            int32_t(act_q8[ai].qs_words[k]));
                }
                acc[stream] = fma(float(isum), w_q8[wi].d * act_q8[ai].d, acc[stream]);
            }
        }
        // §4.1 geometry: each row's 16 reduction lanes are exactly half of a
        // wave32 (rows_per_wg=16 over 256 threads => 2 rows per subgroup).
        // A shuffle tree inside that half-wave replaces the LDS round-trip
        // (write + barrier + serial 16-term sum + barrier) with 4 in-wave
        // exchanges. group_out and row_partial disappear entirely: after the
        // tree, every lane of subgroup s holds row (2s)'s sum in its lower
        // half and row (2s+1)'s in the upper half.
        [[unroll]] for (uint mask = 1u; mask < 16u; mask <<= 1u) {
            acc += subgroupShuffleXor(acc, mask);
        }
        // Cross-half exchange must run converged in the whole wave; only the
        // first 4 lanes of each subgroup then publish (one per stream). Each
        // subgroup owns row pair (2s, 2s+1) of this workgroup, so 8 subgroups
        // x 4 streams = the same 32 packed words the LDS version produced.
        const vec4 pair_hi = subgroupShuffleXor(acc, 16u);
        if (gl_SubgroupInvocationID < 4u) {
            const uint stream = gl_SubgroupInvocationID;
            const uint row0 = 2u * gl_SubgroupID;
            const uint elem = (token * p.streams + stream) * p.rank_dim +
                              gl_WorkGroupID.x * 16u + row0;
            const uint word = p.late_word_offset + elem / 2u;
            qmail[word] = packHalf2x16(vec2(acc[stream], pair_hi[stream]));
        }
    }

    // Device-wide completion protocol, matching the established fused HC
    // pattern: every WG publishes its sidecar stores before incrementing the
    // local-VRAM counter. The Q-only control line lives 16 uints immediately
    // before p.late_word_offset: control[0]=ready, control[1]=WG counter.
    memoryBarrierBuffer();
    barrier();
    if (gl_LocalInvocationID.x == 0u) {
        const uint prior = atomicAdd(qmail[p.late_word_offset - 15u], 1u);
        publish_last = (prior + 1u == p.n_workgroups) ? 1u : 0u;
    }
    barrier();
    if (publish_last != 0u) {
        if (gl_LocalInvocationID.x == 0u) {
            memoryBarrierBuffer();
            qmail[p.late_word_offset - 16u] = 1u;
            memoryBarrierBuffer();
        }
    }
}
#endif
#ifdef TP5_LATE_Q
// Match the native HC W_down single-subgroup topology. Using 64 lanes here
// with only one subgroupAdd drops the second subgroup on RDNA2/wave32.
layout(local_size_x = 32) in;

layout(std430, binding = 0) readonly buffer DownWeights {
    late_q8_0 w[];
};
layout(std430, binding = 1) readonly buffer Gamma4 {
    vec4 gamma4[];
};
layout(std430, binding = 2) readonly buffer Residual4 {
    vec4 residual4[];
};
layout(std430, binding = 3) readonly buffer LocalZ4 {
    vec4 local_z4[];
};
layout(std430, binding = 4) readonly buffer Scatter {
    float scatter[];
};
layout(std430, binding = 5) writeonly buffer LateOut {
    float q_out[];
};
// Runtime active rows from the RELAY broadcast header (word 5).
layout(std430, binding = 6) readonly buffer RowsHeader {
    uint rows_header[];
};

layout(push_constant) uniform QParams {
    uint width;
    uint rank_dim;
    uint streams;
    uint my_rank;
    uint active_rows;
} p;

void main() {
    const uint row  = gl_WorkGroupID.x;
    const uint lane = gl_LocalInvocationID.x;
    if (row >= p.rank_dim || p.streams != 4u || (p.width & 255u) != 0u) {
        return;
    }
    const uint k_dim = p.width * p.streams;
    const uint active_rows = rows_header[5u] != 0u ? rows_header[5u] : p.active_rows;

    [[unroll]] for (uint token = 0u; token < 4u; ++token) {
        if (token >= active_rows) break;
        float acc[4] = { 0.0, 0.0, 0.0, 0.0 };
        const vec4 scatter4 = vec4(
            scatter[token * p.streams + 0u],
            scatter[token * p.streams + 1u],
            scatter[token * p.streams + 2u],
            scatter[token * p.streams + 3u]);
        const uint token_z_offset = token * (p.width / 4u);
        const uint token_res_offset = token * (k_dim / 4u);
        for (uint col = 8u * lane; col < p.width; col += 8u * 32u) {
            const vec4 z0 = local_z4[token_z_offset + col / 4u];
            const vec4 z1 = local_z4[token_z_offset + col / 4u + 1u];
            [[unroll]] for (uint stream = 0u; stream < 4u; ++stream) {
                const uint base       = stream * p.width;
                const float s         = scatter4[stream];
                const uint global_col = base + col;
                const uint ib  = (row * k_dim + global_col) / 32u;
                const uint iqs = global_col % 32u;

                vec4 rz0 = z0 * s;
                vec4 rz1 = z1 * s;
                if (p.my_rank == 0u) {
                    rz0 += residual4[token_res_offset + global_col / 4u];
                    rz1 += residual4[token_res_offset + global_col / 4u + 1u];
                }
                const vec4 b0 = gamma4[global_col / 4u] * rz0;
                const vec4 b1 = gamma4[global_col / 4u + 1u] * rz1;

                const i8vec2 q0 = unpack8(int32_t(w[ib].qs[iqs / 2u])).xy;
                const i8vec2 q1 = unpack8(int32_t(w[ib].qs[iqs / 2u + 1u])).xy;
                const i8vec2 q2 = unpack8(int32_t(w[ib].qs[iqs / 2u + 2u])).xy;
                const i8vec2 q3 = unpack8(int32_t(w[ib].qs[iqs / 2u + 3u])).xy;
                const vec4 v0 = vec4(q0.x, q0.y, q1.x, q1.y);
                const vec4 v1 = vec4(q2.x, q2.y, q3.x, q3.y);

                float rowtmp = dot(b0, v0);
                rowtmp      += dot(b1, v1);
                rowtmp      *= float(w[ib].d);
                acc[stream] += rowtmp;
            }
        }

        [[unroll]] for (uint stream = 0u; stream < 4u; ++stream) {
            acc[stream] = tp5_hc_sum32(acc[stream]);
            if (lane == 0u) {
                const uint out_idx = (token * p.streams + stream) * p.rank_dim + row;
                q_out[out_idx] = acc[stream];
            }
        }
    }
}
#endif
