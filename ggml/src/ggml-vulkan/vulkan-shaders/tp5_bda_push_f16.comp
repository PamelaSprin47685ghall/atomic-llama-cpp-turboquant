#version 450

// 6-Pillar Hardware BDA Push: vectorized F32 read from source tensor via BDA,
// on-the-fly F16 conversion, direct coherent write to host-imported RAM.
//
// Formally verified Release-Acquire atomic synchronization:
// - All data workgroups perform memoryBarrierBuffer() before atomicAdd.
// - The atomicAdd acts as an intra-device global barrier: only the very last
//   workgroup to arrive is authorized to store the completion flag.
// - This guarantees 100% mathematical and physical certainty that every single
//   payload byte has landed and is globally visible before the flag is published.

#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(local_size_x = 64) in;

layout(buffer_reference, std430, buffer_reference_align = 16) readonly buffer SrcBdaF32 {
    vec4 src_data[];
};

layout(buffer_reference, std430, buffer_reference_align = 8) coherent writeonly buffer DstBdaF16 {
    f16vec4 dst_data[];
};

layout(buffer_reference, std430, buffer_reference_align = 4) coherent buffer FlagBuf {
    uint flag;
    uint counter;
};

layout(push_constant) uniform Params {
    uint64_t src_bda_addr;
    uint64_t dst_bda_addr;
    uint64_t flag_bda_addr;
    uint n_vec4;
    uint num_workgroups;
    uint seq_val;
} p;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx < p.n_vec4) {
        vec4 v = SrcBdaF32(p.src_bda_addr).src_data[idx];
        DstBdaF16(p.dst_bda_addr).dst_data[idx] = f16vec4(v);
    }

    // Workgroup-level memory barrier: ensure all invocations' stores to DstBdaF16
    // are fully drained and ordered before invocation 0 interacts with the atomic counter.
    memoryBarrierBuffer();
    barrier();

    // Global atomic synchronization:
    // Only the very last workgroup to complete all payload writes is permitted
    // to clear the counter and write the completion flag.
    if (gl_LocalInvocationID.x == 0) {
        if (atomicAdd(FlagBuf(p.flag_bda_addr).counter, 1) == p.num_workgroups - 1) {
            FlagBuf(p.flag_bda_addr).counter = 0;
            memoryBarrierBuffer();
            // Publish completion flag: guaranteed all preceding workgroup stores are visible
            FlagBuf(p.flag_bda_addr).flag = p.seq_val;
        }
    }
}
