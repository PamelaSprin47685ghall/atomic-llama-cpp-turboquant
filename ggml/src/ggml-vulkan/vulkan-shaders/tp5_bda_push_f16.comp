#version 450

// 6-Pillar Hardware BDA Push: vectorized F32 read from source tensor via BDA,
// on-the-fly F16 conversion, direct write to host-imported RAM.
//
// Completion protocol: two dispatches from the same command buffer.
//   dispatch 1 (mode=0): data copy, n_vec4/64 workgroups
//   vkCmdPipelineBarrier: COMPUTE(SHADER_WRITE) -> COMPUTE(SHADER_WRITE)
//   dispatch 2 (mode=1): one workgroup writes flag[0] = seq_val
// The barrier orders every data write before the flag write, so the host
// cannot observe the flag before the payload is fully visible. Writing the
// flag from a later dispatch is the only portable cross-workgroup ordering
// in GLSL; an in-shader `if (idx == 0)` flag store races the other workgroups.

#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(local_size_x = 64) in;

layout(buffer_reference, std430, buffer_reference_align = 16) readonly buffer SrcBdaF32 {
    vec4 src_data[];
};

layout(buffer_reference, std430, buffer_reference_align = 8) writeonly buffer DstBdaF16 {
    f16vec4 dst_data[];
};

layout(buffer_reference, std430, buffer_reference_align = 4) writeonly buffer FlagBuf {
    uint flag[];
};

layout(push_constant) uniform Params {
    uint64_t src_bda_addr;
    uint64_t dst_bda_addr;
    uint64_t flag_bda_addr;
    uint n_vec4;
    uint rank_idx;
    uint seq_val;
    uint mode; // 0 = data copy, 1 = flag write
} p;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (p.mode == 0) {
        if (idx < p.n_vec4) {
            vec4 v = SrcBdaF32(p.src_bda_addr).src_data[idx];
            DstBdaF16(p.dst_bda_addr).dst_data[idx] = f16vec4(v);
        }
    } else {
        if (idx == 0) {
            FlagBuf(p.flag_bda_addr).flag[0] = p.seq_val;
        }
    }
}
