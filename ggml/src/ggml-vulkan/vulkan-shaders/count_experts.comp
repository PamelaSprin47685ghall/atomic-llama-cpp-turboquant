#version 450

#include "types.glsl"

layout (push_constant) uniform parameter
{
    uint32_t ne00;
    uint32_t ne01;
    uint32_t nb00;
    uint32_t nb01;
    uint32_t a_offset;
    uint32_t mode;
    uint32_t active_capacity;
    uint32_t singleton_offset;
    uint32_t grouped_max;
    uint32_t grouped_list_offset;
    uint32_t singleton_dispatch_offset;
    uint32_t grouped_dispatch_offset;
    uint32_t generic_dispatch_offset;
    uint32_t n_experts;
} p;

#define BLOCK_SIZE 256

layout(local_size_x = BLOCK_SIZE, local_size_y = 1, local_size_z = 1) in;

layout (binding = 0) readonly buffer A {uint data_a[];};
layout (binding = 1) buffer D {uint data_d[];};
layout (binding = 2) buffer Rows {uint data_rows[];};

shared uint row_count;

void main() {
    const uint tid = gl_LocalInvocationID.x;

    if (p.mode == 0) {
        if (gl_WorkGroupID.x == 0 && tid == 0) {
            data_d[0] = 0;
            data_rows[p.singleton_offset] = 0;
            data_d[p.singleton_dispatch_offset + 1] = 0;
            data_d[p.grouped_dispatch_offset + 1] = 0;
            data_d[p.generic_dispatch_offset + 2] = 0;
        }
        return;
    }

    const uint num_elements = p.ne00 * p.ne01;
    const uint count_offset = 1 + p.active_capacity;

    // Decode batches contain only a small number of routed rows. Build the
    // complete expert-to-row map cooperatively in one workgroup instead of
    // launching one 256-thread workgroup per expert, each rescanning every ID.
    if (p.mode == 3) {
        if (tid == 0) {
            data_d[0] = 0;
            data_rows[p.singleton_offset] = 0;
            data_d[p.singleton_dispatch_offset + 1] = 0;
            data_d[p.grouped_dispatch_offset + 1] = 0;
            data_d[p.generic_dispatch_offset + 2] = 0;
        }
        for (uint expert_id = tid; expert_id < p.n_experts; expert_id += BLOCK_SIZE) {
            data_d[count_offset + expert_id] = 0;
        }
        memoryBarrierBuffer();
        barrier();

        for (uint idx = tid; idx < num_elements; idx += BLOCK_SIZE) {
            const uint i01 = idx / p.ne00;
            const uint i00 = idx - i01 * p.ne00;
            const uint expert_id =
                data_a[p.a_offset + i01 * p.nb01 + i00 * p.nb00];
            // Out-of-range IDs match no expert in the per-expert path; skip
            // them here to keep the cooperative histogram OOB-free.
            if (expert_id >= p.n_experts) {
                continue;
            }
            const uint row = atomicAdd(data_d[count_offset + expert_id], 1);
            data_rows[expert_id * num_elements + row] = i00 | (i01 << 16);
        }
        memoryBarrierBuffer();
        barrier();

        for (uint expert_id = tid; expert_id < p.n_experts; expert_id += BLOCK_SIZE) {
            const uint count = data_d[count_offset + expert_id];
            if (count == 1) {
                const uint singleton_idx = atomicAdd(data_rows[p.singleton_offset], 1);
                atomicAdd(data_d[p.singleton_dispatch_offset + 1], 1);
                data_rows[p.singleton_offset + 1 + 2 * singleton_idx] = expert_id;
                data_rows[p.singleton_offset + 2 + 2 * singleton_idx] =
                    data_rows[expert_id * num_elements];
            } else if (count >= 2 && count <= p.grouped_max) {
                const uint n_tiles = (count + 1u) / 2u;
                const uint grouped_idx =
                    atomicAdd(data_d[p.grouped_dispatch_offset + 1], n_tiles);
                for (uint tile = 0; tile < n_tiles; ++tile) {
                    data_d[p.grouped_list_offset + grouped_idx + tile] =
                        expert_id | ((2u * tile) << 16);
                }
            } else if (count != 0) {
                const uint active_idx = atomicAdd(data_d[0], 1);
                atomicAdd(data_d[p.generic_dispatch_offset + 2], 1);
                data_d[1 + active_idx] = expert_id;
            }
        }
        return;
    }

    const uint expert_id = gl_WorkGroupID.x;
    if (tid == 0) {
        row_count = 0;
    }
    barrier();

    for (uint idx = tid; idx < num_elements; idx += BLOCK_SIZE) {
        const uint i01 = idx / p.ne00;
        const uint i00 = idx - i01 * p.ne00;
        const uint a = data_a[p.a_offset + i01 * p.nb01 + i00 * p.nb00];

        if (a == expert_id) {
            const uint row = atomicAdd(row_count, 1);
            data_rows[expert_id*num_elements + row] = i00 | (i01 << 16);
        }
    }

    memoryBarrierBuffer();
    barrier();

    if (tid == 0) {
        data_d[count_offset + expert_id] = row_count;

        if (p.mode == 2 && row_count == 1) {
            const uint singleton_idx = atomicAdd(data_rows[p.singleton_offset], 1);
            atomicAdd(data_d[p.singleton_dispatch_offset + 1], 1);
            data_rows[p.singleton_offset + 1 + 2*singleton_idx] = expert_id;
            data_rows[p.singleton_offset + 2 + 2*singleton_idx] = data_rows[expert_id*num_elements];
        } else if (p.mode == 2 && row_count >= 2 && row_count <= p.grouped_max) {
            // Match mul_mat_vec_id_grouped_tile_cols on the host. A fixed
            // two-reader tile avoids reserving sixteen accumulators in every
            // invocation when most experts serve only two or three readers.
            const uint n_tiles = (row_count + 1u) / 2u;
            const uint grouped_idx =
                atomicAdd(data_d[p.grouped_dispatch_offset + 1], n_tiles);
            for (uint tile = 0; tile < n_tiles; ++tile) {
                data_d[p.grouped_list_offset + grouped_idx + tile] =
                    expert_id | ((2u * tile) << 16);
            }
        } else if (row_count != 0) {
            const uint active_idx = atomicAdd(data_d[0], 1);
            atomicAdd(data_d[p.generic_dispatch_offset + 2], 1);
            data_d[1 + active_idx] = expert_id;
        }
    }
}
