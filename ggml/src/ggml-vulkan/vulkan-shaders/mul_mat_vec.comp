#version 450

#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require

#include "mul_mat_vec_base.glsl"
#include "dequant_funcs.glsl"

#if defined(HC_DOWN_SILU) && defined(HC_DOWN_Q8_DOT)
#extension GL_EXT_integer_dot_product : require
#endif

#ifdef MOE_DOWN_FOLD
layout(local_size_x_id = 3, local_size_y = 1, local_size_z = 1) in;
#else
layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;
#endif

uint a_offset, b_offset, d_offset, y_offset;

#if defined(HC_DOWN_SILU) && !defined(HC_DOWN_NATIVE_REDUCTION)
// Opt-in reassociated long-K HC down variant (GGML_VK_HC_DOWN_WG=32|64|128).
// A workgroup of BLOCK_SIZE lanes cooperatively reduces one output row:
// each lane keeps the native per-lane two-dot FMA chain over its K slice,
// then partials are combined across subgroups through shared memory. The
// cross-lane partial-sum order differs from the native single-subgroup
// subgroupAdd tree, so results are reassociated, NOT bitwise identical.
shared FLOAT_TYPE hc_down_partial[32][NUM_COLS];
#ifdef HC_DOWN_Q8_DOT
// Opt-in approximate path (GGML_VK_HC_DOT=q8): the B activations are read
// from a Q8_0 companion produced by the fused HC norm/sum shader, and each
// 32-element quant block contracts through dotPacked4x8EXT. This is
// approximate: activations pass through an int8 quantization grid.
#define B_QUANT_K 32u
// B_TYPE is block_q8_0_packed16 for this variant, so the shared interface
// buffer B (binding 1) already exposes the companion as data_b[].
#endif

#if defined(HC_DOWN_SILU) && !defined(HC_DOWN_NATIVE_REDUCTION) && !defined(HC_DOWN_Q8_DOT)
// Multi-subgroup reduction for the reassociated long-K variant: subgroupAdd
// within each subgroup (native lane tree preserved), then a deterministic
// ascending-order shared-memory fold across the (at most 4) subgroups.
// Only one workgroup row is produced per dispatch (NUM_ROWS == 1).
void hc_down_reduce_result(inout FLOAT_TYPE temp[NUM_COLS][NUM_ROWS], const uint d_offset,
                           const uint first_row, const uint num_rows, const uint tid) {
    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
        [[unroll]] for (uint n = 0; n < num_rows; ++n) {
            temp[j][n] = subgroupAdd(temp[j][n]);
        }
    }
    const uint n_sub = gl_NumSubgroups;
    if (gl_SubgroupInvocationID == 0) {
        [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
            [[unroll]] for (uint n = 0; n < num_rows; ++n) {
                hc_down_partial[gl_SubgroupID][j] = temp[j][n];
            }
        }
    }
    barrier();
    if (tid == 0) {
        [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
            precise FLOAT_TYPE acc = hc_down_partial[0][j];
            [[unroll]] for (uint s = 1; s < 32; ++s) {
                if (s < n_sub) {
                    acc = acc + hc_down_partial[s][j];
                }
            }
            temp[j][0] = acc;
        }
    }
    if (tid == 0) {
        [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
            precise float scaled = temp[j][0] * 0.25 + 0.0;
            temp[j][0]           = scaled / (1.0 + exp(-scaled));
            data_d[mat_vec_d_col_offset(j, d_offset) + first_row] = D_TYPE(temp[j][0]);
        }
    }
}
#endif
#endif

#if defined(HC_DOWN_SILU) && defined(HC_DOWN_Q8_DOT)
// Approximate integer-dot HC down (GGML_VK_HC_DOT=q8). Reads the Q8_0
// activation companion from binding 1 (data_b, typed block_q8_0_packed16), and
// contracts each 32-element block with dotPacked4x8EXT. Weights remain Q8_0
// (binding 0, data_a_packed16). The result is approximate: activations pass
// through an int8 grid. Per-element absolute quantization error is about
// scale/2 (plus F16 scale rounding); output error must be measured, not
// derived — cancellation near zero makes relative-error claims false.
// NOT bitwise; NOT lossless. The whole-32-block-per-lane schedule also
// changes the F32 accumulation order vs the native 8-columns-per-lane path.
// One subgroup per row as native; subgroupAdd reduction unchanged.
void hc_down_q8dot_compute(const uint32_t first_row) {
    const uint tid = gl_LocalInvocationID.x;
    get_offsets(a_offset, b_offset, d_offset);

    FLOAT_TYPE temp[NUM_COLS];
    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
        temp[j] = FLOAT_TYPE(0);
    }

    // Each lane strides 8 columns per iter like the native K_PER_ITER==8 path;
    // both A and B are Q8_0 so a full 32-element quant block is consumed per
    // lane pair of iterations. Simpler and exact per-block: each lane handles
    // whole 32-element blocks; K is a multiple of 32 for Q8_0.
    const uint blocks_per_row = p.ncols / B_QUANT_K;
    for (uint blk = tid; blk < blocks_per_row; blk += BLOCK_SIZE) {
        const uint ib_a = first_row * blocks_per_row + blk + a_offset;
        const uint ib_b = blk + b_offset / B_QUANT_K;
        // qs[] entries are int16, each packing TWO int8 quants. Sign-extending
        // a single 16-bit entry to 32 bits would corrupt dotPacked4x8EXT with
        // spurious high-byte products; instead repack each PAIR of 16-bit
        // entries into one 32-bit word (low entry in bytes 0-1, high entry in
        // bytes 2-3) so each word holds exactly four int8 quants.
        int32_t w[8];
        [[unroll]] for (uint p = 0; p < 8; ++p) {
            w[p] = int32_t((uint32_t(data_a_packed16[ib_a].qs[2 * p]) & 0xffffu) |
                           (uint32_t(uint16_t(data_a_packed16[ib_a].qs[2 * p + 1])) << 16u));
        }
        const FLOAT_TYPE da = FLOAT_TYPE(data_a_packed16[ib_a].d);
        [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
            const uint ibb = ib_b + j * (p.batch_stride_b / B_QUANT_K);
            int32_t q_sum = 0;
            [[unroll]] for (uint p = 0; p < 8; ++p) {
                const int32_t bq = int32_t((uint32_t(data_b[ibb].qs[2 * p]) & 0xffffu) |
                                          (uint32_t(uint16_t(data_b[ibb].qs[2 * p + 1])) << 16u));
                q_sum += dotPacked4x8EXT(w[p], bq);
            }
            temp[j] = fma(FLOAT_TYPE(q_sum), da * FLOAT_TYPE(data_b[ibb].d), temp[j]);
        }
    }

    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
        temp[j] = subgroupAdd(temp[j]);
    }
    if (tid == 0) {
        [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
            precise float scaled = temp[j] * 0.25 + 0.0;
            temp[j]              = scaled / (1.0 + exp(-scaled));
            data_d[mat_vec_d_col_offset(j, d_offset) + first_row] = D_TYPE(temp[j]);
        }
    }
}
#endif

#if !defined(DATA_A_F32) && !defined(DATA_A_F16) && !defined(DATA_A_BF16)
#define K_PER_ITER 8
#else
#define K_PER_ITER 4
#endif


#if !defined(HC_DOWN_Q8_DOT)
vec4 load_b(const uint j, const uint iybs, const uint iqs, const bool lastiter, out bool OOB_y, out bool OOB_z, out bool OOB_w) {
    // Check if the latter elements are OOB, and don't fetch B or accumulate it.
    OOB_y = lastiter && (iybs + iqs + y_offset >= p.ncols);
    OOB_z = lastiter && (iybs + iqs + y_offset*2 >= p.ncols);
    OOB_w = lastiter && (iybs + iqs + y_offset*3 >= p.ncols);

    if (!OOB_w) {
        return vec4(FLOAT_TYPE(data_b[j*p.batch_stride_b + b_offset + iybs + iqs]),
                 FLOAT_TYPE(data_b[j*p.batch_stride_b + b_offset + iybs + iqs + y_offset]),
                 FLOAT_TYPE(data_b[j*p.batch_stride_b + b_offset + iybs + iqs + y_offset*2]),
                 FLOAT_TYPE(data_b[j*p.batch_stride_b + b_offset + iybs + iqs + y_offset*3]));
    } else if (!OOB_z) {
        return vec4(FLOAT_TYPE(data_b[j*p.batch_stride_b + b_offset + iybs + iqs]),
                 FLOAT_TYPE(data_b[j*p.batch_stride_b + b_offset + iybs + iqs + y_offset]),
                 FLOAT_TYPE(data_b[j*p.batch_stride_b + b_offset + iybs + iqs + y_offset*2]),
                 0);
    } else if (!OOB_y) {
        return vec4(FLOAT_TYPE(data_b[j*p.batch_stride_b + b_offset + iybs + iqs]),
                 FLOAT_TYPE(data_b[j*p.batch_stride_b + b_offset + iybs + iqs + y_offset]),
                 0, 0);
    } else {
        return vec4(FLOAT_TYPE(data_b[j*p.batch_stride_b + b_offset + iybs + iqs]),
                 0, 0, 0);
    }
}
#endif

void iter(inout FLOAT_TYPE temp[NUM_COLS][NUM_ROWS], const uint first_row, const uint num_rows, const uint tid, const uint i, bool lastiter)
{
// The q8dot variant redefines B as a quant block buffer; the shared
// float-vector fast path cannot read it and is never dispatched there.
#if K_PER_ITER == 8 && !defined(MUL_MAT_ID) && !defined(HC_DOWN_Q8_DOT)
    // Recurrent decode stores concurrent Lane vectors as columns sharing one
    // matrix. For the dominant one-row tile, dequantize that matrix block once
    // and reuse it for every Lane instead of repeating the weight load/work.
    if (num_rows == 1u && NUM_COLS > 1u) {
        const uint col = i*BLOCK_SIZE + K_PER_ITER*tid;
        const uint iqs = (col%QUANT_K)/QUANT_R;
        const uint iybs = col - col%QUANT_K;
        const uint ib = (first_row*p.ncols + col)/QUANT_K;

        vec4 v = dequantize4(ib, iqs, a_offset);
        vec4 v2 = dequantize4(ib, iqs+(4/QUANT_R), a_offset);
        const vec2 dm = get_dm(ib, a_offset);
        if (dm.y != 0) {
            v = v * dm.x + dm.y;
            v2 = v2 * dm.x + dm.y;
        }

        [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
#if QUANT_R == 2
            const vec4 bv02 = vec4(data_b_v4[
                (j*p.batch_stride_b + b_offset + iybs + iqs) / 4]);
            const vec4 bv13 = vec4(data_b_v4[
                (j*p.batch_stride_b + b_offset + iybs + iqs + y_offset) / 4]);
            const vec4 bv0 = vec4(bv02.x, bv13.x, bv02.y, bv13.y);
            const vec4 bv1 = vec4(bv02.z, bv13.z, bv02.w, bv13.w);
#else
            const vec4 bv0 = vec4(data_b_v4[
                (j*p.batch_stride_b + b_offset + iybs + iqs) / 4]);
            const vec4 bv1 = vec4(data_b_v4[
                (j*p.batch_stride_b + b_offset + iybs + iqs) / 4 + 1]);
#endif
            FLOAT_TYPE rowtmp = dot(bv0, v) + dot(bv1, v2);
            if (dm.y == 0) {
                rowtmp *= dm.x;
            }
            temp[j][0] += rowtmp;
        }
        return;
    }
#endif

    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
        const uint col = i*BLOCK_SIZE + K_PER_ITER*tid;
        const uint iqs = (col%QUANT_K)/QUANT_R; // quant index
        const uint iybs = col - col%QUANT_K; // y block start index

#if K_PER_ITER == 8 && !defined(HC_DOWN_Q8_DOT)
#if QUANT_R == 2
        // Note that we end up fetching bogus elements here, but its fine as they'll be
        // within an accessible block.
        const vec4 bv02 = vec4(data_b_v4[(j*p.batch_stride_b + b_offset + iybs + iqs) / 4]);
        const vec4 bv13 = vec4(data_b_v4[(j*p.batch_stride_b + b_offset + iybs + iqs + y_offset) / 4]);
        const vec4 bv0 = vec4(bv02.x, bv13.x, bv02.y, bv13.y);
        const vec4 bv1 = vec4(bv02.z, bv13.z, bv02.w, bv13.w);
#else
        const vec4 bv0 = vec4(data_b_v4[(j*p.batch_stride_b + b_offset + iybs + iqs) / 4]);
        const vec4 bv1 = vec4(data_b_v4[(j*p.batch_stride_b + b_offset + iybs + iqs) / 4 + 1]);
#endif
#else
#if !defined(HC_DOWN_Q8_DOT)
        bool OOB_y;
        bool OOB_z;
        bool OOB_w;

        const vec4 b = load_b(j, iybs, iqs, lastiter, OOB_y, OOB_z, OOB_w);
#endif
#endif
        uint ibi = first_row*p.ncols;
        [[unroll]] for (uint n = 0; n < num_rows; ++n) {
#ifdef HC_UP_FOLD
            const uint weight_row = (first_row % p.stride_d) + n * p.stride_d;
            const uint ib = (weight_row * p.ncols + col)/QUANT_K; // block index
            ibi += p.ncols * p.stride_d;
#else
            const uint ib = (ibi + col)/QUANT_K; // block index
            ibi += p.ncols;
#endif

#if K_PER_ITER == 8 && !defined(HC_DOWN_Q8_DOT)
            vec4 v = dequantize4(ib, iqs, a_offset);
            vec4 v2 = dequantize4(ib, iqs+(4/QUANT_R), a_offset);

            const vec2 dm = get_dm(ib, a_offset);
            if (dm.y != 0) { // quant has min component
                v = v * dm.x + dm.y;
                v2 = v2 * dm.x + dm.y;
            }

            // matrix multiplication
            FLOAT_TYPE rowtmp = dot(bv0, v);
            rowtmp += dot(bv1, v2);

            if (dm.y == 0)
                rowtmp *= dm.x;

            temp[j][n] += rowtmp;
#elif defined(HC_DOWN_Q8_DOT)
            // Unreachable: main routes the q8dot variant to
            // hc_down_q8dot_compute and never dispatches iter().
            temp[j][n] += FLOAT_TYPE(0);
#else
            if (!OOB_w) {
                const vec4 v = dequantize4(ib, iqs, a_offset);
                temp[j][n] += dot(v, b);
            } else if (!OOB_z) {
                const vec2 v0 = dequantize(ib, iqs, a_offset);
                const FLOAT_TYPE v1 = dequantize1(ib + 2/QUANT_R, iqs, a_offset);
                const vec3 v = vec3(v0.x, v0.y, v1);
                const vec3 b0 = vec3(b.x, b.y, b.z);
                temp[j][n] += dot(v, b0);
            } else if (!OOB_y) {
                const vec2 v0 = dequantize(ib, iqs, a_offset);
                const vec2 b0 = vec2(b.x, b.y);
                temp[j][n] += dot(v0, b0);
            } else {
                const FLOAT_TYPE v = dequantize1(ib, iqs, a_offset);
                temp[j][n] = fma(v, b.x, temp[j][n]);
            }
#endif
        }
    }
}

#if defined(DATA_A_F32) || defined(DATA_A_F16) || defined(DATA_A_BF16)
void iter_aligned_nonquant(inout FLOAT_TYPE temp[NUM_COLS][NUM_ROWS], const uint first_row, const uint num_rows, const uint tid, const uint i)
{
    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
        const uint col = i*BLOCK_SIZE + K_PER_ITER*tid;
        const uint iqs = 0; // quant index
        const uint iybs = col; // y block start index

        const vec4 b = data_b_v4[(j*p.batch_stride_b + b_offset + iybs + iqs) / 4];

        uint ibi = first_row*p.ncols;
        [[unroll]] for (uint n = 0; n < num_rows; ++n) {
            const uint ib = (ibi + col)/QUANT_K; // block index
            ibi += p.ncols;

            const vec4 v = dequantize4_2aligned(ib, iqs, a_offset);

            // matrix multiplication
            temp[j][n] += dot(v, b);
        }
    }
}
#endif

void compute_outputs(const uint32_t first_row, const uint32_t num_rows) {
#ifdef MOE_DOWN_FOLD
    const uint tid = gl_LocalInvocationID.x % BLOCK_SIZE;
#    ifdef MOE_FUSE_SHARED_DOWN
    if (gl_LocalInvocationID.x < BLOCK_SIZE) {
        uint num_shared_iters = p.shared_k / (8u * BLOCK_SIZE);
        if (num_shared_iters * 8u * BLOCK_SIZE + 8u * tid < p.shared_k) {
            num_shared_iters++;
        }
        const uint quant_k = 32u;
        const uint col     = 8u * tid;
        const uint iqs     = col % quant_k;
        const uint iybs    = col - iqs;

        FLOAT_TYPE shared_temp[NUM_ROWS];
        [[unroll]] for (uint n = 0u; n < num_rows; ++n) { shared_temp[n] = FLOAT_TYPE(0); }

        for (uint si = 0u; si < num_shared_iters; ++si) {
            const uint b_idx = si * 8u * BLOCK_SIZE + iybs + iqs;
            const vec4 bv0   = vec4(shared_swiglu[b_idx], shared_swiglu[b_idx + 1u], shared_swiglu[b_idx + 2u],
                                    shared_swiglu[b_idx + 3u]);
            const vec4 bv1   = vec4(shared_swiglu[b_idx + 4u], shared_swiglu[b_idx + 5u], shared_swiglu[b_idx + 6u],
                                    shared_swiglu[b_idx + 7u]);

            uint       ibi           = (first_row * p.shared_k + si * 8u * BLOCK_SIZE + col) / quant_k;
            const uint stride_blocks = p.shared_k / quant_k;
            [[unroll]] for (uint n = 0u; n < num_rows; ++n) {
                const uint ib = ibi;
                ibi += stride_blocks;

                const i8vec2 v0 = unpack8(int32_t(data_shared_down_packed16[ib].qs[iqs / 2u])).xy;
                const i8vec2 v1 = unpack8(int32_t(data_shared_down_packed16[ib].qs[iqs / 2u + 1u])).xy;
                const vec4   v  = vec4(v0.x, v0.y, v1.x, v1.y);

                const i8vec2 v2_0 = unpack8(int32_t(data_shared_down_packed16[ib].qs[(iqs + 4u) / 2u])).xy;
                const i8vec2 v2_1 = unpack8(int32_t(data_shared_down_packed16[ib].qs[(iqs + 4u) / 2u + 1u])).xy;
                const vec4   v2   = vec4(v2_0.x, v2_0.y, v2_1.x, v2_1.y);

                // Match RADV's contracted native Q8 two-dot sum, even though
                // the precise final fold propagates to this computation.
                FLOAT_TYPE rowtmp = dot(bv1, v2);
                rowtmp            = fma(bv0.w, v.w, rowtmp);
                rowtmp            = fma(bv0.z, v.z, rowtmp);
                rowtmp            = fma(bv0.y, v.y, rowtmp);
                rowtmp            = fma(bv0.x, v.x, rowtmp);
                shared_temp[n]    = fma(rowtmp, FLOAT_TYPE(data_shared_down_packed16[ib].d), shared_temp[n]);
            }
        }

        [[unroll]] for (uint n = 0u; n < num_rows; ++n) { shared_temp[n] = subgroupAdd(shared_temp[n]); }
        if (tid == 0u) {
            [[unroll]] for (uint n = 0u; n < num_rows; ++n) { shared_down_outputs[n] = shared_temp[n]; }
        }
    }
#    endif
#else
#    ifdef HC_DOWN_SILU
    // Reassociated long-K variant: HC_DOWN_WG lanes cooperatively reduce one
    // output row. tid addresses lanes within the row's workgroup; the K loop
    // stride is the workgroup size instead of the native single-subgroup size.
#        define tid gl_LocalInvocationID.x
#    else
    const uint tid = gl_LocalInvocationID.x;
#    endif
#endif

    get_offsets(a_offset, b_offset, d_offset);
    const bool is_aligned_nonquant =
        p.batch_stride_b % 4 == 0 && b_offset % 4 == 0 &&
        p.ncols % 4 == 0 && BLOCK_SIZE % 4 == 0 &&
        K_PER_ITER == 4;

    y_offset = QUANT_R == 1 ? 1 : QUANT_K/2;

    FLOAT_TYPE temp[NUM_COLS][NUM_ROWS];

    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
        [[unroll]] for (uint i = 0; i < NUM_ROWS; ++i) {
            temp[j][i] = FLOAT_TYPE(0);
        }
    }

    uint num_iters = p.ncols / (K_PER_ITER * BLOCK_SIZE);
    if (num_iters * K_PER_ITER * BLOCK_SIZE + K_PER_ITER*tid < p.ncols) {
        num_iters++;
    }
    int unroll_count = 4;
    uint unrolled_iters = num_iters & ~(unroll_count - 1);

    uint i = 0;

#if K_PER_ITER == 4
    // If the K dimension is odd, we need lastiter==true on the last iteration
    // so OOB is computed correctly. Skip some unrolling to make that happen.
    if ((p.ncols & 3) != 0 &&
        unrolled_iters == num_iters &&
        unrolled_iters > 0) {
        unrolled_iters -= unroll_count;
    }
    if (is_aligned_nonquant) {
        while (i < unrolled_iters) {
            // Manually partially unroll the loop
            [[unroll]] for (uint k = 0; k < unroll_count; ++k) {
                iter_aligned_nonquant(temp, first_row, num_rows, tid, i*K_PER_ITER);
                i++;
            }
        }
    } else {
#endif
    while (i < unrolled_iters) {
        // Manually partially unroll the loop
        [[unroll]] for (uint k = 0; k < unroll_count; ++k) {
            iter(temp, first_row, num_rows, tid, i*K_PER_ITER, false);
            i++;
        }
    }
#if K_PER_ITER == 4
    }
#endif

    unroll_count = 2;
    unrolled_iters = num_iters & ~(unroll_count - 1);

#if K_PER_ITER == 4
    if ((p.ncols & 3) != 0 &&
        unrolled_iters == num_iters &&
        unrolled_iters > 0) {
        unrolled_iters -= unroll_count;
    }

    if (is_aligned_nonquant) {
        while (i < unrolled_iters && is_aligned_nonquant) {
            // Manually partially unroll the loop
            [[unroll]] for (uint k = 0; k < unroll_count; ++k) {
                iter_aligned_nonquant(temp, first_row, num_rows, tid, i*K_PER_ITER);
                i++;
            }
        }
    } else {
#endif
    while (i < unrolled_iters) {
        // Manually partially unroll the loop
        [[unroll]] for (uint k = 0; k < unroll_count; ++k) {
            iter(temp, first_row, num_rows, tid, i*K_PER_ITER, false);
            i++;
        }
    }
#if K_PER_ITER == 4
    }
#endif

#if K_PER_ITER == 4
    if (is_aligned_nonquant) {
        while (i < num_iters) {
            iter_aligned_nonquant(temp, first_row, num_rows, tid, i*K_PER_ITER);
            i++;
        }
    } else {
#endif
    while (i < num_iters) {
        iter(temp, first_row, num_rows, tid, i*K_PER_ITER, true);
        i++;
    }
#if K_PER_ITER == 4
    }
#endif

// NativeHC zone: variant-specific reduction. The reassociated wg variant uses
// its own multi-subgroup fold; the q8dot variant never reaches here (main
// routes it to hc_down_q8dot_compute). All other paths use the shared
// reduce_result from mul_mat_vec_base.glsl.
#if defined(HC_DOWN_SILU) && !defined(HC_DOWN_NATIVE_REDUCTION) && !defined(HC_DOWN_Q8_DOT)
    hc_down_reduce_result(temp, d_offset, first_row, num_rows, tid);
#else
    reduce_result(temp, d_offset, first_row, num_rows, tid);
#endif
}

#if defined(HC_UP_FOLD) && defined(HC_UP_R320)
// Specialized R320 up fold (GGML_VK_HC_UP_R320=1): the exact production shape
// K=320 (HC rank slice) with compile-time tail handling. 320 columns = 10
// lanes' worth of 8-column iterations per 32-lane subgroup plus a fixed
// 64-column remainder handled without the native dynamic num_iters tail
// logic. The 4-stream sigmoid/fold semantics and the precise fold order are
// identical to the native HC_UP_FOLD path; only the K-loop schedule differs.
// Numerically the lane accumulation order is preserved (each lane covers the
// same K slice as native), so per-lane partials are bitwise identical to
// native; the final subgroupAdd tree is unchanged.
void hc_up_r320_compute(const uint32_t first_row) {
    get_offsets(a_offset, b_offset, d_offset);
    const uint tid = gl_LocalInvocationID.x;

    FLOAT_TYPE temp[NUM_COLS][NUM_ROWS];
    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
        [[unroll]] for (uint i = 0; i < NUM_ROWS; ++i) {
            temp[j][i] = FLOAT_TYPE(0);
        }
    }

    // K=320, K_PER_ITER=8, BLOCK_SIZE=32: iteration 0 covers columns
    // 0..255 across all 32 lanes; the fixed 64-column tail (256..319) is
    // covered by lanes 0..7 of iteration 1.
    iter(temp, first_row, NUM_ROWS, tid, 0u, false);
    if (tid < 8u) {
        iter(temp, first_row, NUM_ROWS, tid, 8u, false);
    }

    reduce_result(temp, d_offset, first_row, NUM_ROWS, tid);
}
#endif

void main() {
    const uint first_row = mat_vec_first_row();

#ifdef NEEDS_INIT_IQ_SHMEM
    init_iq_shmem(gl_WorkGroupSize);
#endif

#if defined(HC_DOWN_SILU) && defined(HC_DOWN_Q8_DOT)
    // Approximate integer-dot path: one row per workgroup, Q8 companion B.
    if (first_row < p.stride_d) {
        hc_down_q8dot_compute(first_row);
    }
    return;
#endif

#if defined(HC_UP_FOLD) && defined(HC_UP_R320)
    // Specialized fixed-tail R320 up fold: one row per workgroup as native.
    if (gl_WorkGroupID.x + gl_NumWorkGroups.x * gl_WorkGroupID.z < p.stride_d) {
        hc_up_r320_compute(first_row);
    }
    return;
#endif

    // do NUM_ROWS at a time, unless there aren't enough remaining rows
#ifdef MOE_DOWN_FOLD
    if (first_row < p.stride_d) {
        const uint rows = min(NUM_ROWS, p.stride_d - first_row);
        fold_slot       = gl_LocalInvocationID.x / BLOCK_SIZE;
        compute_outputs(first_row, rows);
    }
#elif defined(HC_UP_FOLD)
    if (gl_WorkGroupID.x + gl_NumWorkGroups.x * gl_WorkGroupID.z < p.stride_d) {
        compute_outputs(first_row, NUM_ROWS);
    }
#else
    if (first_row + NUM_ROWS <= p.stride_d) {
        compute_outputs(first_row, NUM_ROWS);
    } else {
        if (first_row >= p.stride_d) {
            return;
        }
        compute_outputs(first_row, min(NUM_ROWS, p.stride_d - first_row));
    }
#endif
}
