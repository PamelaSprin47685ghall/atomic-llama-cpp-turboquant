#version 450

// RELAY real-graph P2: it is resident before the CPU publishes the reduced
// payload. CPU writes local VRAM through BAR; this shader waits only on that
// generation doorbell and then consumes the payload autonomously.

layout(local_size_x = 64) in;
layout(std430, binding = 0) coherent volatile buffer InboxBuffer { uint inbox[]; };
layout(std430, binding = 1) writeonly buffer DstBuffer { float dst[]; };
layout(std430, binding = 2) coherent volatile buffer StatusBuffer { uint status[]; };

layout(push_constant) uniform Params {
    uint n_elems;
    uint spin_max;
    uint dst_offset_words;
    uint profile_spin;
} p;

shared uint ready;
shared uint spin_used;
shared uint active_elements;

void main() {
    uint lane = gl_LocalInvocationID.x;
    if (lane == 0u) {
        ready = 0u;
        spin_used = 0u;
        active_elements = 0u;
        uint expected = status[1];
        if (status[2] == 0u && expected != 0u) {
            for (uint spin = 0u; spin < p.spin_max; ++spin) {
                // A host-side bounded handoff failure requests an immediate
                // fail-closed exit; do not burn the remaining spin budget.
                if ((spin & 1023u) == 0u && status[2] != 0u) {
                    break;
                }
                if (inbox[0] == expected) {
                    // Generation matching is exact; leave the doorbell stable
                    // for the lifetime of this activation. The CPU clears it
                    // before publishing the next generation, avoiding a
                    // needless GPU write into host-mapped VRAM.
                    // Length is part of the same payload publication. A
                    // maximum-capacity definition does not copy padded rows.
                    memoryBarrierBuffer();
                    active_elements = inbox[3];
                    if (active_elements == 0u || active_elements > p.n_elems) {
                        status[2] = expected;
                        status[4] = active_elements;
                        ready = 2u;
                    } else {
                        ready = 1u;
                    }
                    spin_used = spin;
                    break;
                }
            }
            if (ready == 0u) {
                spin_used = p.spin_max;
                if (status[2] == 0u) {
                    status[2] = expected;
                }
                status[4] = inbox[0];
            }
            if (p.profile_spin != 0u) {
                status[5] = spin_used;
            }
        } else if (expected == 0u) {
            status[2] = 0xffffffffu;
        }
    }
    barrier();
    if (ready != 1u) {
        // A timed-out P2 must not leave a plausible previous activation for
        // later graph work. Status records the failure; NaNs make the GPU
        // data path fail closed without a host synchronization round-trip.
        for (uint e = lane; e < p.n_elems; e += 64u) {
            dst[p.dst_offset_words + e] = uintBitsToFloat(0x7fc00000u);
        }
        memoryBarrierBuffer();
        return;
    }
    memoryBarrierBuffer();
    for (uint e = lane; e < active_elements; e += 64u) {
        dst[p.dst_offset_words + e] = uintBitsToFloat(inbox[16u + e]);
    }
    memoryBarrierBuffer();
    barrier();
    if (lane == 0u) {
        status[3] = status[1];
    }
}
