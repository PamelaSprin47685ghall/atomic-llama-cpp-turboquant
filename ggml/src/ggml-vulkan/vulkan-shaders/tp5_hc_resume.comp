#version 450
#extension GL_EXT_control_flow_attributes : enable
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#ifdef TP5_RESUME_LO_Q8
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#endif

// Two independent data dependencies. The CPU publishes y_epoch (word 0)
// immediately after y fanout, and q_epoch (word 2) after sidecar fanout.
// No successful completion is published by the norm pass. Only LO, the last
// reader of both inbox regions, may retire this mailbox generation.
#ifdef TP5_RESUME_NORM
#ifndef TP5_RESUME_NORM_THREADS
#define TP5_RESUME_NORM_THREADS 256
#endif
layout(local_size_x = TP5_RESUME_NORM_THREADS, local_size_x_id = 0) in;
// Scheduling only. No Y/inbox data is consumed before await_input(); the
// independently available local residual can be fetched while Y is in flight.
layout(constant_id = 1) const uint NORM_PREFETCH_RESIDUAL = 0u;
layout(std430, binding = 0) coherent volatile readonly buffer Inbox { uint inbox[]; };
#ifdef TP5_RESUME_NORM_STAGE_Y
// Descriptor alias of the very same inbox range, not another allocation.
// Header polling remains scalar/volatile. Payload reads occur only after its
// generation; explicit uvec4 loads reduce uncached memory instruction count.
layout(std430, binding = 0) coherent volatile readonly buffer InboxVectors { uvec4 inbox_vectors[]; };
shared uint staged_y[4096];
#endif
layout(std430, binding = 1) readonly buffer Residual { float residual[]; };
layout(std430, binding = 2) readonly buffer Gamma { float gamma[]; };
layout(std430, binding = 3) writeonly buffer Combined { float combined[]; };
layout(std430, binding = 4) writeonly buffer Normalized { float normalized[]; };
layout(std430, binding = 5) readonly buffer Scatter { float scatter[]; };
layout(std430, binding = 6) writeonly buffer Rho { float inverse_rho[]; };
layout(std430, binding = 7) coherent volatile buffer Status { uint status[]; };
layout(std430, binding = 8) writeonly buffer SumOutput { float sum_output[]; };
layout(push_constant) uniform Params {
    uint width;
    uint streams;
    float epsilon;
    uint spin_max;
    uint status_word_offset;
    uint profile_spin;
    uint active_rows;
} p;
const uint GENERATION_WORD = 0u;
const uint SPIN_WORD = 5u;
// RELAY header word 5 carries the CPU-published runtime active-row count.
// It is written before this P2 command buffer is submitted, so it is already
// visible when the generation doorbell arrives. The push constant keeps the
// capacity only as a fail-safe fallback (M3 invariant 2: capacity is never the
// effective row count of a maximum-capacity definition).
const uint ACTIVE_ROWS_WORD = 5u;
shared float partials[gl_WorkGroupSize.x / 32u];
#endif

#if defined(TP5_RESUME_LO) || defined(TP5_RESUME_LO_Q8)
#ifdef TP5_RESUME_LO_Q8
layout(local_size_x = 320) in;
#else
layout(local_size_x = 256) in;
#endif
layout(std430, binding = 0) coherent volatile readonly buffer Inbox { uint inbox[]; };
layout(std430, binding = 1) readonly buffer Rho { float inverse_rho[]; };
layout(std430, binding = 2) writeonly buffer Lo { float lo[]; };
layout(std430, binding = 3) coherent volatile buffer Status { uint status[]; };
#ifdef TP5_RESUME_LO_Q8
// P1-B activation layout: packed uint32 words, matching the weight side. No
// flag block here — this is per-token transient output, not immutable data.
struct late_lo_q8_packed {
    float   d;
    uint    qs_words[8];
};
layout(std430, binding = 4) writeonly buffer LoQ8 { late_lo_q8_packed lo_q8[]; };
#endif
layout(push_constant) uniform Params {
    uint rank_dim;
    uint streams;
    uint late_word_offset;
    uint spin_max;
    uint status_word_offset;
    uint profile_spin;
    uint sidecar_f16;
    uint active_rows;
} p;
const uint GENERATION_WORD = 2u;
const uint SPIN_WORD = 7u;
const uint ACTIVE_ROWS_WORD = 5u;
#endif


#ifdef TP5_RESUME_LO_U
// LB2: LO waits the single Y generation (word 0), then folds
// u = 0.25 * sum_b rho_b * Q_b itself from the bank-published rho and the
// 5-rank-reduced Q sidecar — no CPU u, no second doorbell, no rho buffer.
layout(local_size_x = 256) in;
layout(std430, binding = 0) coherent volatile readonly buffer Inbox { uint inbox[]; };
layout(std430, binding = 1) writeonly buffer Lo { float lo[]; };
layout(std430, binding = 2) coherent volatile buffer Status { uint status[]; };
layout(push_constant) uniform Params {
    uint rank_dim;
    uint late_word_offset;   // Q payload word offset in the bank
    uint spin_max;
    uint status_word_offset;
    uint profile_spin;
    uint active_rows;
    uint rho_word_offset;    // stats region word offset (12 words/token)
    // NOTE: the norm path's inversesqrt(fold / width + epsilon) regularisation was
    // tried here and REVERTED. Measured: the norm path's fold/width is about 1
    // (its values are already normalised), while this identity's ss/width is about
    // 3e-6 -- five orders of magnitude apart. So epsilon does not bound anything on
    // this scale; dividing by width merely moves rho from ~11 to ~500 and the
    // output became uniformly degenerate (10/10 requests reached 171 tokens but
    // none was coherent, versus 5/10 with 1 coherent before). The scale mismatch
    // is the real open question, not the regulariser.
    float width;
    float epsilon;
} p;
const uint GENERATION_WORD = 0u;
const uint SPIN_WORD = 7u;
const uint ACTIVE_ROWS_WORD = 5u;
#endif

#if defined(TP5_RESUME_LO) || defined(TP5_RESUME_LO_Q8) || defined(TP5_RESUME_LO_U) || defined(TP5_RESUME_NORM)
shared uint ready;
shared uint expected;

bool await_input() {
    if (gl_LocalInvocationID.x == 0u) {
        ready = 0u;
        expected = status[p.status_word_offset + 1u];
        uint used = 0u;
        if (expected != 0u && status[p.status_word_offset + 2u] == 0u) {
            for (uint spin = 0u; spin < p.spin_max; ++spin) {
                used = spin;
                if ((spin & 1023u) == 0u && status[p.status_word_offset + 2u] != 0u)
                    break;
                if (inbox[GENERATION_WORD] == expected) {
                    ready = 1u;
                    break;
                }
            }
        }
        if (ready == 0u) {
            atomicCompSwap(status[p.status_word_offset + 2u], 0u,
                          expected != 0u ? expected : 0xffffffffu);
            if (gl_WorkGroupID.x == 0u)
                status[p.status_word_offset + 4u] = inbox[GENERATION_WORD];
            used = p.spin_max;
        }
        if (p.profile_spin != 0u && gl_WorkGroupID.x == 0u)
            status[p.status_word_offset + SPIN_WORD] = used;
    }
    barrier();
    memoryBarrierBuffer();
    return ready != 0u;
}
#endif

#ifdef TP5_RESUME_NORM
void poison_stream(const uint active_rows) {
    const uint lane = gl_LocalInvocationID.x;
    const uint stream = gl_WorkGroupID.x;
    const float nanv = uintBitsToFloat(0x7fc00000u);
    for (uint token = 0u; token < TP5_LATE_CAPACITY_ROWS; ++token) {
        if (token >= active_rows) break;
        const uint base = token * (p.streams * p.width) + stream * p.width;
        for (uint col = lane; col < p.width; col += gl_WorkGroupSize.x) {
            combined[base + col] = nanv;
            normalized[base + col] = nanv;
            if (stream == 0u) sum_output[token * p.width + col] = nanv;
        }
        if (lane == 0u) inverse_rho[token * p.streams + stream] = nanv;
    }
}
void finalize_stream(const uint iterations, const uint active_rows) {
    const uint lane = gl_LocalInvocationID.x;
    const uint stream = gl_WorkGroupID.x;
    if ((NORM_PREFETCH_RESIDUAL == 0u || active_rows == 0u) && !await_input()) {
        poison_stream(active_rows);
        return;
    }
    [[unroll]] for (uint token = 0u; token < TP5_LATE_CAPACITY_ROWS; ++token) {
        if (token >= active_rows) break;
        const uint base = token * (p.streams * p.width) + stream * p.width;
        const float s = scatter[token * p.streams + stream];
        float values[16];
        [[unroll]] for (uint i = 0u; i < 16u; ++i) {
            const uint col = lane + i * gl_WorkGroupSize.x;
            values[i] = i < iterations && col < p.width ? residual[base + col] : 0.0;
        }
        if (NORM_PREFETCH_RESIDUAL != 0u && token == 0u && !await_input()) {
            poison_stream(active_rows);
            return;
        }
#ifdef TP5_RESUME_NORM_STAGE_Y
        if ((p.width & 3u) == 0u) {
            const uint vectors = p.width / 4u;
            for (uint v = lane; v < vectors; v += gl_WorkGroupSize.x) {
                const uvec4 y4 = inbox_vectors[4u + token * vectors + v];
                staged_y[4u*v+0u] = y4.x;
                staged_y[4u*v+1u] = y4.y;
                staged_y[4u*v+2u] = y4.z;
                staged_y[4u*v+3u] = y4.w;
            }
        } else {
            // Preserve the original bounded shape contract for odd widths.
            for (uint col = lane; col < p.width; col += gl_WorkGroupSize.x)
                staged_y[col] = inbox[16u + token*p.width + col];
        }
        barrier();
#endif
        float ss = 0.0;
        [[unroll]] for (uint i = 0u; i < 16u; ++i) {
            const uint col = lane + i * gl_WorkGroupSize.x;
            if (i < iterations && col < p.width) {
#ifdef TP5_RESUME_NORM_STAGE_Y
                const float y = uintBitsToFloat(staged_y[col]);
#else
                const float y = uintBitsToFloat(inbox[16u + token * p.width + col]);
#endif
                precise float product = y * s;
                precise float value = values[i] + product;
                values[i] = value;
                combined[base + col] = value;
                if (stream == 0u) sum_output[token * p.width + col] = y;
            }
            ss += values[i] * values[i];
        }
        // §4.1 geometry: the cross-subgroup fold was a serial subgroup-0
        // pass over partials[32] (write -> barrier -> subgroup 0 folds ->
        // lane 0 writes back -> barrier). With the fixed 8-subgroup shape
        // every thread reads the eight published partials directly and sums
        // them in registers: one barrier fewer, no single-wave
        // serialization, and partials shrinks to exactly eight words.
        ss = subgroupAdd(ss);
        if (gl_SubgroupInvocationID == 0u) {
            partials[gl_SubgroupID] = ss;
        }
        barrier();
        float fold = 0.0;
        for (uint sgi = 0u; sgi < gl_NumSubgroups; ++sgi) {
            fold += partials[sgi];
        }
        const float scale = inversesqrt(fold / float(p.width) + p.epsilon);
        if (lane == 0u) inverse_rho[token * p.streams + stream] = scale;
        // L2 in-chain check (profile_spin bit 1): publish the reference inverse RMS
        // this kernel just formed into the free host-status words 8..15 (2 tokens x
        // 4 streams). The status line is host-imported RAM, so the relay can compare
        // it with its own sufficient-statistic rho without any device readback.
        if (lane == 0u && (p.profile_spin & 2u) != 0u && token < 2u)
            status[p.status_word_offset + 8u + token * 4u + stream] = floatBitsToUint(scale);
        [[unroll]] for (uint i = 0u; i < 16u; ++i) {
            const uint col = lane + i * gl_WorkGroupSize.x;
            if (i < iterations && col < p.width) {
                float norm = scale * values[i];
                normalized[base + col] = norm * gamma[stream * p.width + col];
            }
        }
        barrier();
    }
}
void main() {
    // The register fold above bounds over gl_NumSubgroups partials, supporting
    // both wave32 (8 subgroups) and wave64 (4 subgroups) for 256 threads.
    // Any other topology fails closed to prevent out-of-bounds partial reads.
    if (p.streams != 4u || gl_WorkGroupID.x >= p.streams || p.width == 0u || p.width > 4096u) {
        if (gl_LocalInvocationID.x == 0u)
            atomicCompSwap(status[p.status_word_offset + 2u], 0u, 0xffffffffu);
        return; // also rejected by the host recipe before recording
    }
    if (gl_NumSubgroups > 32u || gl_NumSubgroups < 4u ||
        (gl_WorkGroupSize.x != 256u && gl_WorkGroupSize.x != 512u && gl_WorkGroupSize.x != 1024u)) {
        if (gl_LocalInvocationID.x == 0u)
            atomicCompSwap(status[p.status_word_offset + 2u], 0u, 0xffffffffu);
        return; // also rejected by the host recipe before recording
    }
    const uint active_rows = inbox[ACTIVE_ROWS_WORD] != 0u ? inbox[ACTIVE_ROWS_WORD] : p.active_rows;
    const uint blocks = min(16u, (p.width + gl_WorkGroupSize.x - 1u) / gl_WorkGroupSize.x);
    finalize_stream(blocks, active_rows);
}
#endif

#if defined(TP5_RESUME_LO) || defined(TP5_RESUME_LO_Q8)
float load_q(const uint index) {
    if (p.sidecar_f16 == 0u) {
        return uintBitsToFloat(inbox[p.late_word_offset + index]);
    }
    const uint packed = inbox[p.late_word_offset + (index >> 1u)];
    const vec2 pair = unpackHalf2x16(packed);
    return (index & 1u) == 0u ? pair.x : pair.y;
}

void main() {
    const uint lane = gl_LocalInvocationID.x;
    if (p.streams != 4u || p.rank_dim == 0u || p.rank_dim > 512u
#ifdef TP5_RESUME_LO_Q8
        || p.rank_dim != 320u || gl_NumSubgroups != 10u
#endif
    ) {
        if (lane == 0u) atomicCompSwap(status[p.status_word_offset + 2u], 0u, 0xffffffffu);
        return;
    }
    const uint active_rows = inbox[ACTIVE_ROWS_WORD] != 0u ? inbox[ACTIVE_ROWS_WORD] : p.active_rows;
    if (!await_input()) {
        for (uint token = 0u; token < TP5_LATE_CAPACITY_ROWS; ++token) {
            if (token >= active_rows) break;
            for (uint row = lane; row < p.rank_dim; row += 256u)
                lo[token * p.rank_dim + row] = uintBitsToFloat(0x7fc00000u);
#ifdef TP5_RESUME_LO_Q8
            if (lane < 10u) {
                lo_q8[token * 10u + lane].d = uintBitsToFloat(0x7fc00000u);
                [[unroll]] for (uint k = 0u; k < 8u; ++k)
                    lo_q8[token * 10u + lane].qs_words[k] = 0u;
            }
#endif
        }
        return;
    }
#ifdef TP5_RESUME_LO_Q8
    const uint row = lane;
    [[unroll]] for (uint token = 0u; token < TP5_LATE_CAPACITY_ROWS; ++token) {
        if (token >= active_rows) break;
        const vec4 scale = vec4(
            inverse_rho[token * 4u + 0u],
            inverse_rho[token * 4u + 1u],
            inverse_rho[token * 4u + 2u],
            inverse_rho[token * 4u + 3u]);
        const uint q_token_offset = token * (4u * p.rank_dim);
        const vec4 q = vec4(
            load_q(q_token_offset + row),
            load_q(q_token_offset + p.rank_dim + row),
            load_q(q_token_offset + 2u * p.rank_dim + row),
            load_q(q_token_offset + 3u * p.rank_dim + row));
        const float scaled = dot(q, scale) * 0.25;
        const float value = scaled / (1.0 + exp(-scaled));
        lo[token * p.rank_dim + row] = value;

        const float amax = subgroupMax(abs(value));
        const float d = amax * (1.0 / 127.0);
        const float inv_d = d != 0.0 ? 1.0 / d : 0.0;
        const int qv = clamp(int(round(value * inv_d)), -127, 127);
        // §4.1 geometry: pack the subgroup's 32 int8 values via wave-local
        // shuffles instead of the lo_q_tmp LDS round-trip (write -> barrier
        // -> strided 8-lane read -> barrier). Every lane rebuilds the aligned
        // 4-value group it belongs to with three shuffles; lanes 0,4,8,...28
        // commit the words. Both per-token barriers disappear and lo_q_tmp
        // (1280B) drops out of the shared budget entirely.
        const uint sub = gl_SubgroupID;
        const uint sublane = gl_SubgroupInvocationID;
        const uint g0 = sublane & ~3u;
        const int qv0 = subgroupShuffle(qv, g0);
        const int qv1 = subgroupShuffle(qv, g0 + 1u);
        const int qv2 = subgroupShuffle(qv, g0 + 2u);
        const int qv3 = subgroupShuffle(qv, g0 + 3u);
        const uint word = (uint(qv0) & 0xffu) | (uint(qv1) & 0xffu) << 8u |
                          (uint(qv2) & 0xffu) << 16u | (uint(qv3) & 0xffu) << 24u;
        if (sublane == 0u) lo_q8[token * 10u + sub].d = d;
        if ((sublane & 3u) == 0u) lo_q8[token * 10u + sub].qs_words[sublane >> 2u] = word;
    }
#else
    [[unroll]] for (uint token = 0u; token < TP5_LATE_CAPACITY_ROWS; ++token) {
        if (token >= active_rows) break;
        const vec4 scale = vec4(
            inverse_rho[token * 4u + 0u],
            inverse_rho[token * 4u + 1u],
            inverse_rho[token * 4u + 2u],
            inverse_rho[token * 4u + 3u]);
        const uint q_token_offset = token * (4u * p.rank_dim);
        for (uint row = lane; row < p.rank_dim; row += 256u) {
            const vec4 q = vec4(
                load_q(q_token_offset + row),
                load_q(q_token_offset + p.rank_dim + row),
                load_q(q_token_offset + 2u * p.rank_dim + row),
                load_q(q_token_offset + 3u * p.rank_dim + row));
            const float scaled = dot(q, scale) * 0.25;
            lo[token * p.rank_dim + row] = scaled / (1.0 + exp(-scaled));
        }
    }
#endif
    memoryBarrierBuffer();
    barrier();
    if (lane == 0u && status[p.status_word_offset + 2u] == 0u) {
        status[p.status_word_offset + 3u] = expected;
        memoryBarrierBuffer();
    }
}
#endif

#ifdef TP5_RESUME_LO_U
void main() {
    const uint lane = gl_LocalInvocationID.x;
    if (p.rank_dim == 0u || p.rank_dim > 512u) {
        if (lane == 0u) atomicCompSwap(status[p.status_word_offset + 2u], 0u, 0xffffffffu);
        return;
    }
    const uint active_rows = inbox[ACTIVE_ROWS_WORD] != 0u ? inbox[ACTIVE_ROWS_WORD] : p.active_rows;
    if (!await_input()) {
        for (uint token = 0u; token < TP5_LATE_CAPACITY_ROWS; ++token) {
            if (token >= active_rows) break;
            for (uint row = lane; row < p.rank_dim; row += 256u)
                lo[token * p.rank_dim + row] = uintBitsToFloat(0x7fc00000u);
        }
        return;
    }
    [[unroll]] for (uint token = 0u; token < TP5_LATE_CAPACITY_ROWS; ++token) {
        if (token >= active_rows) break;
        // L2: rho is derived HERE from the sufficient statistics rather than being
        // computed by the CPU and read back. late_publish_stats already writes, into
        // this same bank region, per token: A_b = |R_b|^2 at 2b+0, D_b = sum_p <R_b,z_p>
        // at 2b+1, and s_b at 8+b. The relay therefore has nothing left to publish
        // except cc, which only its reduction can form -- and which sits right after
        // the 12-word-per-token block, one word per token (see
        // ggml-vulkan-collective.cpp, cc_offset = stats_offset + 12*16*sizeof(float)).
        //
        // The identity is the same one the CPU used:
        //     ss = A_b + 2*s_b*D_b + s_b^2*cc ;  rho_b = ss > 0 ? 1/sqrt(ss) : 0
        // 1/sqrt is kept over inversesqrt so this migration is bit-identical to the
        // CPU path it replaces; otherwise a later tip-to-tip would measure the ULP.
        const uint so = p.rho_word_offset + token * 12u;
        // The cc tail starts one full statistics block past the base: 12 words per
        // token at TP5_LATE_CAPACITY_ROWS capacity. This MUST use the define the
        // generator passes (VK_TP5_DIRECT_COLUMN_TILE), not a hardcoded 16: the
        // capacity is 4, so a literal 16 read 512 bytes past the region the CPU's
        // bounds check covers, straight out of whatever else lives in the bank.
        const float cc = uintBitsToFloat(inbox[p.rho_word_offset + 12u * TP5_LATE_CAPACITY_ROWS + token]);
        const float a0 = uintBitsToFloat(inbox[so + 0u]), d0 = uintBitsToFloat(inbox[so + 1u]), q0s = uintBitsToFloat(inbox[so + 8u]);
        const float a1 = uintBitsToFloat(inbox[so + 2u]), d1 = uintBitsToFloat(inbox[so + 3u]), q1s = uintBitsToFloat(inbox[so + 9u]);
        const float a2 = uintBitsToFloat(inbox[so + 4u]), d2 = uintBitsToFloat(inbox[so + 5u]), q2s = uintBitsToFloat(inbox[so + 10u]);
        const float a3 = uintBitsToFloat(inbox[so + 6u]), d3 = uintBitsToFloat(inbox[so + 7u]), q3s = uintBitsToFloat(inbox[so + 11u]);
        const float ss0 = a0 + 2.0 * q0s * d0 + q0s * q0s * cc;
        const float ss1 = a1 + 2.0 * q1s * d1 + q1s * q1s * cc;
        const float ss2 = a2 + 2.0 * q2s * d2 + q2s * q2s * cc;
        const float ss3 = a3 + 2.0 * q3s * d3 + q3s * q3s * cc;
        const float rho0 = ss0 > 0.0 ? 1.0 / sqrt(ss0) : 0.0;
        const float rho1 = ss1 > 0.0 ? 1.0 / sqrt(ss1) : 0.0;
        const float rho2 = ss2 > 0.0 ? 1.0 / sqrt(ss2) : 0.0;
        const float rho3 = ss3 > 0.0 ? 1.0 / sqrt(ss3) : 0.0;
        for (uint row = lane; row < p.rank_dim; row += 256u) {
            const float q0 = uintBitsToFloat(inbox[p.late_word_offset + (token * 4u + 0u) * p.rank_dim + row]);
            const float q1 = uintBitsToFloat(inbox[p.late_word_offset + (token * 4u + 1u) * p.rank_dim + row]);
            const float q2 = uintBitsToFloat(inbox[p.late_word_offset + (token * 4u + 2u) * p.rank_dim + row]);
            const float q3 = uintBitsToFloat(inbox[p.late_word_offset + (token * 4u + 3u) * p.rank_dim + row]);
            const float u = 0.25 * (rho0 * q0 + rho1 * q1 + rho2 * q2 + rho3 * q3);
            lo[token * p.rank_dim + row] = u / (1.0 + exp(-u));
        }
    }
    memoryBarrierBuffer();
    barrier();
    if (lane == 0u && status[p.status_word_offset + 2u] == 0u) {
        status[p.status_word_offset + 3u] = expected;
        memoryBarrierBuffer();
    }
}
#endif
