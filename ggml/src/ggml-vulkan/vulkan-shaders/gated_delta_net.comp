#version 450

#extension GL_EXT_control_flow_attributes : require
#extension GL_KHR_shader_subgroup_basic : enable
#if USE_SUBGROUP_CLUSTERED
#extension GL_KHR_shader_subgroup_clustered : enable
#endif
#if USE_SUBGROUP_ADD
#extension GL_KHR_shader_subgroup_arithmetic : enable
#endif

// Caller guarantees valid spec constants: S_V % COLS_PER_WG == 0 and S_V % LANES_PER_COLUMN == 0,
// so no bounds checking is needed.
layout(constant_id = 0) const uint S_V = 128;
layout(constant_id = 1) const uint KDA = 0;
layout(constant_id = 2) const uint SUBGROUP_SIZE = 32;
layout(constant_id = 3) const uint LANES_PER_COLUMN = 32;
layout(constant_id = 4) const uint WORKGROUP_SIZE = 32;
layout(constant_id = 5) const uint RBB = 0;

const uint COLS_PER_SUBGROUP = SUBGROUP_SIZE / LANES_PER_COLUMN;
const uint SUBGROUPS_PER_WG = WORKGROUP_SIZE / SUBGROUP_SIZE;
const uint COLS_PER_WG = COLS_PER_SUBGROUP * SUBGROUPS_PER_WG;
const uint ROWS_PER_LANE = S_V / LANES_PER_COLUMN;

layout(local_size_x_id = 4, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Parameters {
    uint H;
    uint n_tokens;
    uint n_seqs;
    uint s_off;
    uint sq1, sq2, sq3;
    uint sv1, sv2, sv3;
    uint sb1, sb2, sb3;
    uint neq1, rq3;
    float scale;
    uint K;
};

layout(binding = 0) readonly  buffer QBuf           { FLOAT_TYPE data_q[];            };
layout(binding = 1) readonly  buffer KBuf           { FLOAT_TYPE data_k[];            };
layout(binding = 2) readonly  buffer VBuf           { FLOAT_TYPE data_v[];            };
layout(binding = 3) readonly  buffer GBuf           { FLOAT_TYPE data_g[];            };
layout(binding = 4) readonly  buffer BetaBuf        { FLOAT_TYPE data_beta[];         };
layout(binding = 5) readonly  buffer BrainStateBuf  { FLOAT_TYPE data_state[];        };
layout(binding = 6) readonly  buffer NativeStateBuf { FLOAT_TYPE data_native_state[]; };
layout(binding = 7)           buffer DstBuf         { FLOAT_TYPE data_dst[];          };

#if !USE_SUBGROUP_ADD && !USE_SUBGROUP_CLUSTERED
shared FLOAT_TYPE temp[WORKGROUP_SIZE];

// This does a reduction across groups of LANES_PER_COLUMN
FLOAT_TYPE reduce_add_shmem(FLOAT_TYPE partial) {
    const uint lane = gl_SubgroupInvocationID;
    const uint base = gl_SubgroupID * SUBGROUP_SIZE;
    temp[base + lane] = partial;
    barrier();
    [[unroll]] for (uint s = LANES_PER_COLUMN / 2u; s > 0; s >>= 1u) {
        FLOAT_TYPE other = temp[base + (lane ^ s)];
        barrier();
        temp[base + lane] += other;
        barrier();
    }
    const FLOAT_TYPE result = temp[base + lane];
    barrier();
    return result;
}
#endif

// clusterSize for subgroupClusteredAdd must be a compile-time constant; branch on spec constant
FLOAT_TYPE reduce_partial(FLOAT_TYPE partial) {
    switch (LANES_PER_COLUMN) {
        case 1u:
            return partial;
#if USE_SUBGROUP_CLUSTERED
        // Workaround for GLSL requiring a literal constant for the cluster size.
        // The branches should all fold away.
        case 2u:
            return subgroupClusteredAdd(partial, 2u);
        case 4u:
            return subgroupClusteredAdd(partial, 4u);
        case 8u:
            return subgroupClusteredAdd(partial, 8u);
        case 16u:
            return subgroupClusteredAdd(partial, 16u);
        case 32u:
            return subgroupClusteredAdd(partial, 32u);
        case 64u:
            return subgroupClusteredAdd(partial, 64u);
#endif
        default:
#if USE_SUBGROUP_ADD
            return subgroupAdd(partial);
#else
            return reduce_add_shmem(partial);
#endif
    }
}

void rbb_main() {
    const uint head_id = gl_WorkGroupID.x;
    const uint lane = gl_SubgroupInvocationID % LANES_PER_COLUMN;
    const uint local_col = gl_SubgroupID * COLS_PER_SUBGROUP +
        gl_SubgroupInvocationID / LANES_PER_COLUMN;
    const uint col = gl_WorkGroupID.z * COLS_PER_WG + local_col;
    const uint state_base = head_id * S_V * S_V + col * S_V;
    const uint qk_head = head_id % neq1;

    // Eight runtime-sized vectors per (head, state column). The block solve
    // uses one common decay, one residual per writer, and the exact
    // (K K^T + D + eps I) operator from Parallel DeltaNet.
    const uint candidate_off = s_off + H * S_V * S_V;
    const uint scratch_stride = 8u * n_seqs;
    const uint scratch_base =
        candidate_off + n_seqs * H * S_V * S_V +
        (head_id * S_V + col) * scratch_stride;
    const uint beta_off          = scratch_base;
    const uint rhs_off           = beta_off + n_seqs;
    const uint solution_off      = rhs_off + n_seqs;
    const uint residual_off      = solution_off + n_seqs;
    const uint direction_off     = residual_off + n_seqs;
    const uint product_off       = direction_off + n_seqs;
    const uint preconditioned_off = product_off + n_seqs;
    const uint diagonal_off      = preconditioned_off + n_seqs;

    float base_shard[ROWS_PER_LANE];
    [[unroll]] for (uint r = 0u; r < ROWS_PER_LANE; ++r) {
        base_shard[r] = float(data_state[
            state_base + r * LANES_PER_COLUMN + lane]);
    }

    float mean_log_decay = 0.0;
    for (uint writer = 0u; writer < n_seqs; ++writer) {
        mean_log_decay +=
            float(data_g[writer * sb3 + head_id * sb1]);
    }
    const float base_alpha = exp(mean_log_decay / float(n_seqs));

    float residual_product = 0.0;
    for (uint writer = 0u; writer < n_seqs; ++writer) {
        const uint qk_off = (writer / rq3) * sq3 + qk_head * sq1;
        const float beta = clamp(
            float(data_beta[writer * sb3 + head_id * sb1]),
            1.0e-6,
            1.0);
        float projected = 0.0;
        float key_norm = 0.0;
        [[unroll]] for (uint r = 0u; r < ROWS_PER_LANE; ++r) {
            const uint d = r * LANES_PER_COLUMN + lane;
            const float key = float(data_k[qk_off + d]);
            projected += base_alpha * base_shard[r] * key;
            key_norm += key * key;
        }
        projected = float(reduce_partial(FLOAT_TYPE(projected)));
        key_norm = float(reduce_partial(FLOAT_TYPE(key_norm)));
        const float rhs =
            float(data_v[writer * sv3 + head_id * sv1 + col]) - projected;
        const float regularizer =
            n_seqs == 1u ? 0.0 : (1.0 - beta) / beta + 1.0e-4;
        const float diagonal = key_norm + regularizer;
        const float solution =
            n_seqs == 1u ? beta * rhs : 0.0;
        const float residual =
            n_seqs == 1u ? 0.0 : rhs;
        const float preconditioned =
            diagonal > 1.0e-20 ? residual / diagonal : 0.0;

        if (lane == 0u) {
            data_dst[beta_off + writer] = FLOAT_TYPE(beta);
            data_dst[rhs_off + writer] = FLOAT_TYPE(rhs);
            data_dst[solution_off + writer] = FLOAT_TYPE(solution);
            data_dst[residual_off + writer] = FLOAT_TYPE(residual);
            data_dst[direction_off + writer] = FLOAT_TYPE(preconditioned);
            data_dst[product_off + writer] = FLOAT_TYPE(0.0);
            data_dst[preconditioned_off + writer] =
                FLOAT_TYPE(preconditioned);
            data_dst[diagonal_off + writer] = FLOAT_TYPE(diagonal);
            residual_product += residual * preconditioned;
        }
        memoryBarrierBuffer();
        barrier();
    }

    // Matrix-free preconditioned CG. The operator is shared by every state
    // column, while rhs and solution are column-specific. N steps are exact
    // in exact arithmetic; wider frontiers get finite-precision refinement.
    const uint iteration_count =
        n_seqs == 1u ? 0u : (n_seqs <= 32u ? n_seqs : 4u * n_seqs);
    for (uint iteration = 0u; iteration < iteration_count; ++iteration) {
        float projected_keys[ROWS_PER_LANE];
        [[unroll]] for (uint r = 0u; r < ROWS_PER_LANE; ++r) {
            const uint d = r * LANES_PER_COLUMN + lane;
            float value = 0.0;
            for (uint writer = 0u; writer < n_seqs; ++writer) {
                const uint qk_off =
                    (writer / rq3) * sq3 + qk_head * sq1;
                value += float(data_dst[direction_off + writer]) *
                    float(data_k[qk_off + d]);
            }
            projected_keys[r] = value;
        }

        for (uint writer = 0u; writer < n_seqs; ++writer) {
            const uint qk_off =
                (writer / rq3) * sq3 + qk_head * sq1;
            float dot = 0.0;
            [[unroll]] for (uint r = 0u; r < ROWS_PER_LANE; ++r) {
                const uint d = r * LANES_PER_COLUMN + lane;
                dot += float(data_k[qk_off + d]) * projected_keys[r];
            }
            dot = float(reduce_partial(FLOAT_TYPE(dot)));
            if (lane == 0u) {
                const float beta =
                    float(data_dst[beta_off + writer]);
                const float regularizer =
                    (1.0 - beta) / beta + 1.0e-4;
                data_dst[product_off + writer] = FLOAT_TYPE(
                    dot + regularizer *
                        float(data_dst[direction_off + writer]));
            }
        }
        memoryBarrierBuffer();
        barrier();

        if (lane == 0u) {
            float direction_product = 0.0;
            for (uint writer = 0u; writer < n_seqs; ++writer) {
                direction_product +=
                    float(data_dst[direction_off + writer]) *
                    float(data_dst[product_off + writer]);
            }
            const float step =
                direction_product > 1.0e-20
                    ? residual_product / direction_product
                    : 0.0;
            float next_residual_product = 0.0;
            for (uint writer = 0u; writer < n_seqs; ++writer) {
                const float residual =
                    float(data_dst[residual_off + writer]) -
                    step * float(data_dst[product_off + writer]);
                const float diagonal =
                    float(data_dst[diagonal_off + writer]);
                const float preconditioned =
                    diagonal > 1.0e-20 ? residual / diagonal : 0.0;
                data_dst[solution_off + writer] = FLOAT_TYPE(
                    float(data_dst[solution_off + writer]) +
                    step * float(data_dst[direction_off + writer]));
                data_dst[residual_off + writer] = FLOAT_TYPE(residual);
                data_dst[preconditioned_off + writer] =
                    FLOAT_TYPE(preconditioned);
                next_residual_product += residual * preconditioned;
            }
            const float conjugate =
                residual_product > 1.0e-20
                    ? next_residual_product / residual_product
                    : 0.0;
            for (uint writer = 0u; writer < n_seqs; ++writer) {
                data_dst[direction_off + writer] = FLOAT_TYPE(
                    float(data_dst[preconditioned_off + writer]) +
                    conjugate * float(data_dst[direction_off + writer]));
            }
            residual_product = next_residual_product;
        }
        memoryBarrierBuffer();
        barrier();
    }

    if (lane == 0u) {
        for (uint writer = 0u; writer < n_seqs; ++writer) {
            const float solution =
                float(data_dst[solution_off + writer]);
            if (isnan(solution) || isinf(solution)) {
                data_dst[solution_off + writer] = FLOAT_TYPE(0.0);
            }
        }
    }
    memoryBarrierBuffer();
    barrier();

    float merged_shard[ROWS_PER_LANE];
    [[unroll]] for (uint r = 0u; r < ROWS_PER_LANE; ++r) {
        const uint d = r * LANES_PER_COLUMN + lane;
        float merged = base_alpha * base_shard[r];
        for (uint writer = 0u; writer < n_seqs; ++writer) {
            const uint qk_off =
                (writer / rq3) * sq3 + qk_head * sq1;
            merged += float(data_k[qk_off + d]) *
                float(data_dst[solution_off + writer]);
        }
        merged_shard[r] = merged;
        data_dst[s_off + state_base + d] = FLOAT_TYPE(merged);
    }

    // Advance each Lane's native brain+hand state once. The public brain stays
    // order-free; the stored residual exactly reconstructs this native state
    // for the Lane's next token without a second GDN dispatch.
    for (uint writer = 0u; writer < n_seqs; ++writer) {
        const uint qk_off = (writer / rq3) * sq3 + qk_head * sq1;
        const uint native_base =
            ((writer * H + head_id) * S_V + col) * S_V;
        const float alpha =
            exp(float(data_g[writer * sb3 + head_id * sb1]));
        const float beta = clamp(
            float(data_beta[writer * sb3 + head_id * sb1]),
            1.0e-6,
            1.0);
        float projected = 0.0;
        [[unroll]] for (uint r = 0u; r < ROWS_PER_LANE; ++r) {
            const uint d = r * LANES_PER_COLUMN + lane;
            projected +=
                alpha * float(data_native_state[native_base + d]) *
                float(data_k[qk_off + d]);
        }
        projected = float(reduce_partial(FLOAT_TYPE(projected)));
        const float delta = beta *
            (float(data_v[writer * sv3 + head_id * sv1 + col]) -
             projected);

        float attn = 0.0;
        [[unroll]] for (uint r = 0u; r < ROWS_PER_LANE; ++r) {
            const uint d = r * LANES_PER_COLUMN + lane;
            const float candidate =
                alpha * float(data_native_state[native_base + d]) +
                float(data_k[qk_off + d]) * delta;
            data_dst[
                candidate_off +
                ((writer * H + head_id) * S_V + col) * S_V + d] =
                FLOAT_TYPE(candidate - merged_shard[r]);
            attn += candidate * float(data_q[qk_off + d]);
        }
        attn = float(reduce_partial(FLOAT_TYPE(attn)));
        if (lane == 0u) {
            data_dst[(writer * H + head_id) * S_V + col] =
                FLOAT_TYPE(attn * scale);
        }
    }
}

void main() {
    if (RBB != 0u) {
        rbb_main();
        return;
    }

    const uint head_id = gl_WorkGroupID.x;
    const uint seq_id = gl_WorkGroupID.y;
    const uint lane = gl_SubgroupInvocationID % LANES_PER_COLUMN;
    const uint col = gl_WorkGroupID.z * COLS_PER_WG +
        gl_SubgroupID * COLS_PER_SUBGROUP +
        (gl_SubgroupInvocationID / LANES_PER_COLUMN);

    const uint iq1 = head_id % neq1;
    const uint iq3 = seq_id / rq3;

    const uint state_size = S_V * S_V;
    const uint state_in_base       = (seq_id * H + head_id) * state_size;
    const uint state_out_base      = (seq_id * H + head_id) * state_size;
    const uint state_size_per_snap = state_size * H * n_seqs;

    FLOAT_TYPE s_shard[ROWS_PER_LANE];
    [[unroll]] for (uint r = 0; r < ROWS_PER_LANE; r++) {
        const uint state_idx =
            state_in_base + col * S_V + r * LANES_PER_COLUMN + lane;
        s_shard[r] = FLOAT_TYPE(data_state[state_idx]);
    }

    // snapshot slot mapping: slot 0 = most recent state, slot s = s tokens back.
    // When n_tokens < K, only slots 0..n_tokens-1 are written; older slots are caller-owned.

    uint attn_off = (seq_id * n_tokens * H + head_id) * S_V;

    for (uint t = 0; t < n_tokens; t++) {
        const uint q_off = iq3 * sq3 + t * sq2 + iq1 * sq1;
        const uint k_off = q_off;
        const uint v_off = seq_id * sv3 + t * sv2 + head_id * sv1;
        const uint gb_off = seq_id * sb3 + t * sb2 + head_id * sb1;
        const FLOAT_TYPE beta_val = FLOAT_TYPE(data_beta[gb_off]);

        FLOAT_TYPE k_reg[ROWS_PER_LANE];
        FLOAT_TYPE q_reg[ROWS_PER_LANE];
        [[unroll]] for (uint r = 0; r < ROWS_PER_LANE; r++) {
            const uint i = r * LANES_PER_COLUMN + lane;
            k_reg[r] = FLOAT_TYPE(data_k[k_off + i]);
            q_reg[r] = FLOAT_TYPE(data_q[q_off + i]);
        }

        FLOAT_TYPE g_exp[ROWS_PER_LANE];
        if (KDA == 0) {
            const FLOAT_TYPE g_val = exp(FLOAT_TYPE(data_g[gb_off]));
            [[unroll]] for (uint r = 0; r < ROWS_PER_LANE; r++) {
                g_exp[r] = g_val;
            }
        } else {
            const uint g_base = gb_off * S_V;
            [[unroll]] for (uint r = 0; r < ROWS_PER_LANE; r++) {
                const uint i = r * LANES_PER_COLUMN + lane;
                g_exp[r] = exp(FLOAT_TYPE(data_g[g_base + i]));
            }
        }

        const FLOAT_TYPE v_val = FLOAT_TYPE(data_v[v_off + col]);

        FLOAT_TYPE kv_shard = 0.0;
        [[unroll]] for (uint r = 0; r < ROWS_PER_LANE; r++) {
            kv_shard += g_exp[r] * s_shard[r] * k_reg[r];
        }
        FLOAT_TYPE kv_col = reduce_partial(kv_shard);

        FLOAT_TYPE delta_col = (v_val - kv_col) * beta_val;

        FLOAT_TYPE attn_partial = 0.0;
        [[unroll]] for (uint r = 0; r < ROWS_PER_LANE; r++) {
            s_shard[r] = g_exp[r] * s_shard[r] + k_reg[r] * delta_col;
            attn_partial += s_shard[r] * q_reg[r];
        }
        FLOAT_TYPE attn_col = reduce_partial(attn_partial);

        if (lane == 0) {
            data_dst[attn_off + col] = attn_col * scale;
        }

        attn_off += S_V * H;

        if (K > 1u) {
            const int target_slot = int(n_tokens) - 1 - int(t);
            if (target_slot >= 0 && target_slot < int(K)) {
                const uint slot_base = s_off + uint(target_slot) * state_size_per_snap + state_out_base;
                [[unroll]] for (uint r = 0; r < ROWS_PER_LANE; r++) {
                    data_dst[slot_base + col * S_V + r * LANES_PER_COLUMN + lane] = s_shard[r];
                }
            }
        }
    }

    if (K == 1u) {
        [[unroll]] for (uint r = 0; r < ROWS_PER_LANE; r++) {
            const uint state_elem =
                col * S_V + r * LANES_PER_COLUMN + lane;
            data_dst[s_off + state_out_base + state_elem] = s_shard[r];
        }
    }
}
