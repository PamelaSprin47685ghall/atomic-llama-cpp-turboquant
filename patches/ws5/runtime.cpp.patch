+// Pillar 5 channel ownership: one fixed table per window, eight plan slots of
+// 256 channel states. A slot is rebound only after its last reader ended.
+using plan_channel_slots = ggml_relay_plan::channel_slots<channel_state>;
+
+static bool plan_slot_idle(const plan_channel_slots::slot & slot) {
+    for (const auto & owner : slot.states) {
+        if (owner && owner->held.has_value()) {
+            return false;
+        }
+    }
+    return true;
+}
+
+// GGML_TP5_RELAY_SLOT_CHANNELS overrides; otherwise slots follow the relay's
+// plan-cache switch. Both unset is the legacy map behavior.
+static bool relay_slot_channels_enabled() {
+    static const bool enabled = [] {
+        const char * slots = std::getenv("GGML_TP5_RELAY_SLOT_CHANNELS");
+        if (slots != nullptr && slots[0] != '\0') {
+            return std::strcmp(slots, "0") != 0;
+        }
+        const char * plan = std::getenv("GGML_TP5_PLAN_UNION");
+        return plan != nullptr && std::strcmp(plan, "1") == 0;
+    }();
+    return enabled;
+}
