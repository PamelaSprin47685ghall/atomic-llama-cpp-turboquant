+    const size_t row_bytes = row_elems*ggml_element_size(dst);
+    char * base = (char *) dst->data;
+    for (uint32_t i = n_tokens; i < n_env; ++i) {
+        memcpy(base + (size_t) i*dst->nb[1], base + (size_t) (n_tokens - 1)*dst->nb[1], row_bytes);
