diff --git a/src/llama-prefab-env.h b/src/llama-prefab-env.h
new file mode 100644
index 0000000..38835a4
--- /dev/null
+++ b/src/llama-prefab-env.h
@@ -0,0 +1,38 @@
+#pragma once
+
+// Default-off env gates for the prefab n_kv pad (this layer, not the upstream
+// LLAMA_PREFAB_ENABLE gate). Each value is read once (function-local static) and counts
+// as enabled only for the exact string "1": unset, "0", "true", "01", "1 " all leave
+// stock behaviour. When both are unset the only cost is one boolean check per call site.
+#include <cstdlib>
+
+static inline bool llama_prefab_nkv_pad_enabled() {
+    static const bool on = []() {
+        const char * s = getenv("LLAMA_PREFAB_NKV_PAD");
+        return s != nullptr && s[0] == '1' && s[1] == '\0';
+    }();
+    return on;
+}
+
+static inline bool llama_prefab_nkv_obs_enabled() {
+    static const bool on = []() {
+        const char * s = getenv("LLAMA_PREFAB_NKV_OBS");
+        return s != nullptr && s[0] == '1' && s[1] == '\0';
+    }();
+    return on;
+}
+
+// production A+B compose lane (r7). Same exact-"1" contract as the gates above:
+// unset, "0", "true", "01", "1 " all leave stock behaviour. When exactly "1" it selects the
+// whole-graph MTP lane with the A x B compose as the production path on its own (no
+// LLAMA_PREFAB_MTP / LLAMA_PREFAB_ENABLE / LLAMA_PREFAB_EXPERIMENTAL needed): eligible
+// Qwen4Exp MTP contexts cache one whole graph per envelope width and reuse it across
+// requests while the graph inputs allow (exact can_reuse, no pad / headroom / bucket),
+// and each rebuild splices the cached A prologue under the fresh B block.
+static inline bool llama_prefab_ab_enabled() {
+    static const bool on = []() {
+        const char * s = getenv("GGML_TP5_PREFAB_AB");
+        return s != nullptr && s[0] == '1' && s[1] == '\0';
+    }();
+    return on;
+}
diff --git a/src/llama-prefab-hotpath.h b/src/llama-prefab-hotpath.h
new file mode 100644
index 0000000..07e0049
--- /dev/null
+++ b/src/llama-prefab-hotpath.h
@@ -0,0 +1,94 @@
+#pragma once
+//
+// llama-prefab-hotpath.h — ggml-free hot-path seam of the A x B whole-graph
+// MTP slot lane (src/llama-prefab-mtp.cpp).
+//
+// This header carries the production contracts that must stay testable and
+// observable without ggml:
+//
+//   - the padded KV window the whole-graph slot is composed for (the reuse
+//     contract of the lane) and the fit judgement the slot reuse gate uses;
+//   - the organic counter events POD (llama_prefab_stats), moved here so a
+//     CPU mock drives the identical production decision code and counters.
+//
+// Every counter write in the lane is armed only by the exact-"1" gate
+// (GGML_TP5_PREFAB_STATS, llama_prefab_stats_enabled, defined in
+// llama-prefab-mtp.cpp); with the gate off no hot-path write happens and the
+// stock branches are behaviourally identical to the unpatched builder.
+//
+#include <cstdint>
+
+#include <algorithm>
+
+// exact-"1" arm gate of every build/reuse counter write in the lane
+bool llama_prefab_stats_enabled();
+
+// the padded KV width a whole-graph slot is composed for, derived from the
+// live n_kv at compose time: a 1024-aligned window (>= 1024) that absorbs
+// n_kv growth across steps so the composed graph is reused instead of
+// rebuilt while the live width stays inside the window. kv_size (the
+// physical cache size; 0 skips the clamp) bounds the window.
+inline uint32_t llama_prefab_nkv_window(uint32_t n_kv, uint32_t kv_size) {
+    const uint32_t w = n_kv <= 1024u ? 1024u : ((n_kv + 1023u) / 1024u) * 1024u;
+    return kv_size ? std::min(w, kv_size) : w;
+}
+
+// the slot reuse judgement: the composed graph stays valid while the live
+// width fits the window it was composed for (pad columns are -INF-masked by
+// the prefab mask writer, so attention never reads beyond the live width)
+inline bool llama_prefab_nkv_fits(uint32_t n_kv_pad, uint32_t n_kv) {
+    return n_kv_pad >= n_kv;
+}
+
+// armed counter writes: the ONLY sanctioned mutation of llama_prefab_stats in
+// the lane. Both no-op unless the exact-"1" gate (GGML_TP5_PREFAB_STATS) is
+// on, so stats-off never writes -- stock hot-path parity is structural, not
+// observational.
+inline void llama_prefab_stat_tick(uint64_t & counter) {
+    if (llama_prefab_stats_enabled()) {
+        ++counter;
+    }
+}
+
+inline void llama_prefab_stat_add(uint64_t & counter, uint64_t v) {
+    if (llama_prefab_stats_enabled()) {
+        counter += v;
+    }
+}
+
+// per-context counters (all organic: incremented only where the event happens;
+// armed by llama_prefab_stats_enabled, the exact-"1" gate above)
+struct llama_prefab_stats {
+    uint64_t n_ubatch_prefab;       // ubatches executed on an envelope graph
+    uint64_t n_ubatch_stock;        // ubatches executed by the stock builder path
+    uint64_t n_stock_builds;        // stock model.build_graph() invocations
+    uint64_t n_stock_reuses;        // stock graph reuses (can_reuse == true)
+    uint64_t n_envelope_builds;     // envelope graph compositions
+    uint64_t n_envelope_reuses;     // envelope graph reused without rebuild
+    uint64_t n_envelope_allocs;     // ggml_backend_sched_alloc_graph on an envelope sched
+    uint64_t n_sub_envelope;        // ubatches with n_tokens < n_env (runtime padded)
+    uint64_t n_pad_rows;            // total pad rows executed
+    uint64_t n_factor_compiles;     // factor modules compiled
+    uint64_t n_factor_cache_hits;   // factor modules taken from the cache while composing
+    uint64_t n_factor_splices;      // factor modules spliced into an envelope
+    uint64_t n_factor_clones;       // tensors cloned by splicing
+    uint64_t n_cache_resets;        // topology-key invalidations of the factor cache
+    uint64_t n_fallback_no_scratch; // runtime fallback to stock: no free scratch KV cell
+    uint64_t n_fallback_runtime;    // runtime fallback to stock: adapters / samplers / attention views / ...
+    uint64_t last_n_env;            // envelope width of the last prefab ubatch
+    uint64_t last_n_tokens;         // real n_tokens of the last prefab ubatch
+    uint64_t last_graph_nodes;      // node count of the last executed envelope graph
+    uint64_t last_inp_tokens_ne0;   // ne[0] of the token input of the executed envelope graph (== last_n_env)
+    uint64_t n_decouple_declines;    // decouple iface: ubatches declined by the compose layer (gate on)
+    uint64_t n_decouple_handled;     // decouple iface: ubatches executed by the compose layer (gate on)
+    // MTP factor compose (GGML_TP5_PREFAB_IN_GRAPH=1), all organic:
+    uint64_t n_mtp_compose_hits;     // DECODER_MTP ubatches executed on a composed A x B envelope graph
+    uint64_t n_mtp_a_compiles;       // A (head prologue) modules built
+    uint64_t n_mtp_a_reuses;         // A modules taken from the cache while composing
+    uint64_t n_mtp_b_builds;         // B (block + epilogue) parts emitted into an envelope
+    uint64_t n_mtp_a_clones;         // tensors cloned from A while splicing it into an envelope
+    uint64_t n_mtp_declines;         // DECODER_MTP ubatches the compose layer declined (stock fallback)
+    uint64_t build_ns;              // wall time in instrumented request graph builds, excluding allocation/compute
+    uint64_t n_nodes_built;         // nodes in successfully emitted request graphs, plus compiled MTP A graphs
+    uint64_t template_hits;         // MTP A template cache hits, not whole-graph hits
+};
diff --git a/src/llama-prefab-iface.h b/src/llama-prefab-iface.h
new file mode 100644
index 0000000..5186793
--- /dev/null
+++ b/src/llama-prefab-iface.h
@@ -0,0 +1,97 @@
+#pragma once
+
+// llama-prefab-iface.h — explicit composition interface between the prefab
+// eligibility layer (A, lives in llama-context.cpp) and the prefab compose
+// layer (B, lives in llama-prefab.cpp).
+//
+// Gate: GGML_TP5_PREFAB_DECOUPLE (exact "1"). When the gate is unset or not
+// exactly "1", both layers keep their legacy direct coupling and behavior is
+// byte-identical to the baseline (A+B compose + MTP elig cumulative patch).
+// When the gate is exactly "1":
+//   - A no longer reads B's internals (llama_prefab_state::mtp_mode, slot
+//     tables, scratch_cell, active sched pointer) to decide eligibility or to
+//     drive the ubatch; it fills an explicit request struct and calls B
+//     through the functions below.
+//   - B no longer reaches back into llama_context for eligibility facts; all
+//     facts it needs arrive as values in the request struct.
+//
+// This header is the ONLY shared surface between the two layers under the
+// gate. It deliberately contains no llama_context / llama_prefab_state
+// definitions so neither layer can silently grow a new dependency through it.
+
+#include "ggml-backend.h"
+
+#include "llama-graph.h"
+
+#include <cstdint>
+#include <vector>
+
+// exact-"1" env gate for the decouple lane (unset / "0" / "true" / "01" /
+// "1 " / "2" all stay off)
+bool llama_prefab_decouple_enabled();
+
+// ---- A -> B: explicit eligibility facts (values, not object reach-ins) ----
+//
+// Filled by the eligibility layer (A) after its fail-closed checks; consumed
+// by the compose layer (B). Every field is a plain value or plain pointer
+// that B is allowed to use; nothing here grants B access to A's internals.
+struct llama_prefab_eligibility {
+    // whole-graph MTP mode: slots hold stock-built DECODER_MTP graphs
+    // (e.g. qwen4exp graph_mtp) instead of composed factor envelopes
+    bool     mtp_mode = false;
+
+    // envelope widths (ascending, last == max); one slot per width
+    std::vector<uint32_t> envelopes;
+};
+
+// ---- A -> B: per-ubatch request (values, not object reach-ins) ----
+//
+// Filled by A for one ubatch; B answers through llama_prefab_reply. A never
+// inspects B's slot tables, factor cache, scratch bookkeeping or active-sched
+// pointer to build this — the fields below are the complete contract.
+struct llama_prefab_request {
+    // graph type the caller wants (DEFAULT / DECODER / DECODER_MTP)
+    llm_graph_type gtype = LLM_GRAPH_TYPE_DEFAULT;
+
+    // real ubatch token count (<= the chosen envelope width)
+    uint32_t n_tokens = 0;
+
+    // envelope width selected for this ubatch (must be one of envelopes)
+    uint32_t n_env = 0;
+
+    // whole-graph MTP mode request (exact-fit slot semantics)
+    bool mtp_mode = false;
+
+    // graph_reuse_disable (env LLAMA_GRAPH_REUSE_DISABLE) — disables slot
+    // reuse for both factor and MTP slots equally
+    bool graph_reuse_disable = false;
+
+    // pipeline parallel: slot sched must be synchronized before set_inputs
+    // on the reuse path
+    bool pipeline_parallel = false;
+
+    // eval callback for the slot sched (may be null)
+    ggml_backend_sched_eval_callback cb_eval = nullptr;
+    void * cb_eval_user_data = nullptr;
+
+    // per-ubatch observation gate (LLAMA_PREFAB_NKV_OBS, exact "1")
+    bool nkv_obs = false;
+};
+
+// ---- B -> A: explicit reply (A does not read B's state to learn these) ----
+struct llama_prefab_reply {
+    // false: B declined the ubatch; A must fall back to the stock builder
+    // (A increments its own fallback counters — B does not touch A's stats)
+    bool handled = false;
+
+    // hard failure inside B after accepting the ubatch (alloc/compute);
+    // when set, handled == true and status carries the ggml_status
+    ggml_status status = GGML_STATUS_SUCCESS;
+
+    // the slot graph was reused without rebuild (A maps this to its own
+    // graphs-reused perf counter; B cannot reach it)
+    bool reused = false;
+
+    // the graph result B executed (slot-owned); null iff handled == false
+    llm_graph_result * result = nullptr;
+};
diff --git a/src/llama-prefab-mtp.cpp b/src/llama-prefab-mtp.cpp
new file mode 100644
index 0000000..2330aaa
--- /dev/null
+++ b/src/llama-prefab-mtp.cpp
@@ -0,0 +1,406 @@
+#include "llama-prefab.h"
+#include "llama-prefab-splice.h"
+
+#include "llama-impl.h"
+#include "llama-model.h"
+#include "llama-kv-cache.h"
+
+#include "models/models.h"
+
+#include <cstdlib>
+#include <set>
+#include <stdexcept>
+#include <string>
+
+//
+// MTP factor compose (GGML_TP5_PREFAB_IN_GRAPH=1)
+//
+// The DECODER_MTP head of qwen4exp is cut in two where the block input has been produced
+// (graph_mtp::build_mtp_prologue records it in llm_graph_result::t_prefab_cut):
+//
+//   A (head prologue)   token embedding, hnorm/enorm, eh_proj, hc_attn mix
+//   B (block+epilogue)  QKV, IMRoPE, dense attention, gate, wo, hc combine, MoE FFN,
+//                       hc combine, h_nextn export, out_ids gather, head mixer, LM head
+//
+// A is emitted once per (model, n_env) into its own ggml context and cached in
+// llama_prefab_state::mtp_a. Default (clone splice): every envelope graph re-instantiates A
+// node-by-node into its own context (llama-prefab-splice.h); weights stay shared -- they live
+// outside A's context -- and the envelope's own input tensors are substituted for A's formal
+// inputs. Shared-node compose (GGML_TP5_PREFAB_NOCLONE=1): the envelope graph references A's
+// tensors in place -- the envelope's input writer feeds A's formal input tensors and B is
+// emitted directly on A's resident cut tensors -- so nothing is re-instantiated per compose.
+// In both cases B is emitted into the envelope context, because it binds the KV cache context
+// of the running llama_context and the envelope's own attention/mask inputs. The prologue is
+// therefore built once per envelope width and never recomputed per graph.
+//
+// Both halves come from graph_mtp, i.e. exactly the code of the stock graph, so the composed
+// graph has the same nodes, op_params and tensor shapes as the stock one. The stock ctor runs
+// the same two halves in order, so gate off is byte-identical to the pre-split builder.
+//
+// Scope of the claim: the compose removes the prologue recompute only. It does not change the
+// KV layout -- the inherited nkv padding of the decouple lane (LLAMA_PREFAB_NKV_PAD, slot
+// n_kv_pad) is not used here, and B binds the stock KV input exactly as the stock head does.
+//
+
+bool llama_prefab_in_graph_enabled() {
+    // enabled only by the exact string "1": unset, "0", "true", "01", "1 ", "2" all stay off
+    static const bool on = []() {
+        const char * s = getenv("GGML_TP5_PREFAB_IN_GRAPH");
+        return s != nullptr && s[0] == '1' && s[1] == '\0';
+    }();
+    return on;
+}
+
+// r8 shared-node A x B compose (see llama-prefab.h): enabled only by the exact string "1";
+// unset, "0", "true", "01", "1 ", "2" all keep the clone splice (byte-identical to baseline).
+bool llama_prefab_noclone_enabled() {
+    static const bool on = []() {
+        const char * s = getenv("GGML_TP5_PREFAB_NOCLONE");
+        return s != nullptr && s[0] == '1' && s[1] == '\0';
+    }();
+    return on;
+}
+
+bool llama_prefab_mtp_lifetime_enabled() {
+    static const bool on = []() {
+        const char * s = getenv("GGML_TP5_PREFAB_MTP_LIFETIME");
+        return s != nullptr && s[0] == '1' && s[1] == '\0';
+    }();
+    return on;
+}
+
+bool llama_prefab_stats_enabled() {
+    static const bool on = []() {
+        const char * s = getenv("GGML_TP5_PREFAB_STATS");
+        return s != nullptr && s[0] == '1' && s[1] == '\0';
+    }();
+    return on;
+}
+
+llama_prefab_mtp_a_module * llama_prefab_mtp_a_cache::get(const llama_model & model, uint32_t n_env) {
+    auto it = modules.find({ &model, n_env });
+    return it == modules.end() ? nullptr : it->second.get();
+}
+
+void llama_prefab_mtp_a_cache::clear() {
+    modules.clear();
+}
+
+//
+// A: the cached head prologue
+//
+// A is captured by running graph_mtp::build_mtp_prologue into its own graph: it returns the block
+// input and records it (with the HC residual stream and the scatter weights) in t_prefab_cut /
+// t_prefab_cut_res / t_prefab_cut_inject, and A's graph is built by expanding exactly those three.
+// Its formal inputs are the head's own input tensors (tokens / h); the KV/pos/out_ids inputs
+// belong to B.
+//
+
+static std::unique_ptr<llama_prefab_mtp_a_module> prefab_mtp_compile_a(
+        const llama_model & model, const llm_graph_params & params, uint32_t n_env) {
+    auto mod = std::make_unique<llama_prefab_mtp_a_module>();
+    mod->res = std::make_unique<llm_graph_result>(PREFAB_MTP_A_MAX_NODES);
+
+    llm_graph_params p = params;
+    p.ubatch.n_tokens     = n_env;
+    p.ubatch.n_seq_tokens = n_env;
+    p.ubatch.n_seqs       = 1;
+    p.ubatch.n_seqs_unq   = 1;
+    p.ubatch.b_equal_seqs = 0;
+    p.n_outputs = n_env;
+    p.res       = mod->res.get();
+
+    // only the prologue runs here: the no-build ctor binds the members without running either
+    // head half, and the prologue binds no KV/pos/out_ids input
+    llama_model_qwen4exp::graph_mtp g(model, p, llama_model_qwen4exp::graph_mtp::no_build_t{});
+    g.build_mtp_prologue();
+
+    ggml_tensor * block_in = mod->res->t_prefab_cut;
+    ggml_tensor * res_hc   = mod->res->t_prefab_cut_res;
+    ggml_tensor * inject   = mod->res->t_prefab_cut_inject;
+    if (block_in == nullptr || res_hc == nullptr || inject == nullptr) {
+        throw std::runtime_error("mtp factor compose: head prologue did not reach the A/B cut");
+    }
+
+    // A's formal inputs: the head's own input tensors (op == NONE, never allocated on this
+    // graph). They are only reachable through the graph inputs the prologue registered. The
+    // prologue reads tokens (token embedding) and h (hidden stream); embd is registered by the
+    // stock head input but the prologue does not consume it, so it is not an A input.
+    mod->inputs["tokens"] = nullptr;
+    mod->inputs["h"]      = nullptr;
+
+    for (const auto & inp : mod->res->inputs) {
+        if (auto * e = dynamic_cast<llm_graph_input_embd_h *>(inp.get())) {
+            mod->inputs["tokens"] = e->tokens;
+            mod->inputs["h"]      = e->h;
+        }
+    }
+    for (const auto & [name, t] : mod->inputs) {
+        if (t == nullptr) {
+            throw std::runtime_error("mtp factor compose: missing head input '" + name + "'");
+        }
+    }
+    mod->outputs["block_in"] = block_in;
+    mod->outputs["res_hc"]   = res_hc;
+    mod->outputs["inject"]   = inject;
+
+    // A's graph is exactly the prologue: expand the three cut tensors in emission order. Their
+    // ancestors are the whole prologue (the prologue emits nothing else) and the weights are
+    // shared, not expanded.
+    ggml_cgraph * gf = mod->res->get_gf();
+    ggml_build_forward_expand(gf, block_in);
+    ggml_build_forward_expand(gf, res_hc);
+    ggml_build_forward_expand(gf, inject);
+
+    const int n_keep = ggml_graph_n_nodes(gf);
+    if (n_keep == 0) {
+        throw std::runtime_error("mtp factor compose: empty head prologue");
+    }
+    mod->n_a = n_keep;
+
+    return mod;
+}
+
+//
+// splice: clone A's DAG into the envelope context, substituting the formal inputs
+//
+
+static std::map<std::string, ggml_tensor *> prefab_mtp_splice_a(
+        llm_graph_context & dst,
+        const llama_prefab_mtp_a_module & mod,
+        const std::map<std::string, ggml_tensor *> & subs,
+        llama_prefab_stats & stats) {
+    // the shared ggml-only splice kernel (llama-prefab-splice.h): A is a DAG in its own
+    // context, its formal inputs are substituted by this graph's inputs, weights are shared.
+    // Every failure is a throw, i.e. a decline that falls back to the stock builder.
+    llama_prefab_dag dag;
+    dag.ctx     = mod.res->get_ctx();
+    dag.gf      = mod.res->get_gf();
+    dag.n_nodes = mod.n_a;
+    dag.inputs  = mod.inputs;
+    dag.outputs = mod.outputs;
+
+    return llama_prefab_dag_splice(dst.ctx0, dst.gf, dag, subs, &stats.n_mtp_a_clones);
+}
+
+//
+// envelope input of the composed MTP graph
+//
+
+// tokens / h: the head's dual input (token ids + the trunk's wide hidden state).
+// Exact fit only: the compose path never runs with n_tokens < n_env, so this writes the whole
+// ubatch and pads nothing.
+class llm_graph_input_prefab_mtp_inp : public llm_graph_input_i {
+public:
+    llm_graph_input_prefab_mtp_inp(int64_t n_embd, uint32_t n_env) : n_embd(n_embd), n_env(n_env) {}
+    ~llm_graph_input_prefab_mtp_inp() override = default;
+
+    void set_input(const llama_ubatch * ubatch) override {
+        // the same contract the stock llm_graph_input_embd_h relies on; a graph that does not
+        // match it is never built (can_reuse) nor run (compose eligibility check)
+        GGML_ASSERT(ubatch->token != nullptr);
+        GGML_ASSERT(ubatch->embd  != nullptr);
+        GGML_ASSERT(ubatch->n_tokens == n_env);
+
+        // stock llm_graph_input_embd_h semantics: h takes the provided embeddings
+        ggml_backend_tensor_set(tokens, ubatch->token, 0, n_env*sizeof(int32_t));
+        ggml_backend_tensor_set(h,      ubatch->embd,  0, (size_t) n_env*n_embd*sizeof(float));
+    }
+
+    bool can_reuse(const llm_graph_params & params) override {
+        return tokens->ne[0] == (int64_t) params.ubatch.n_tokens && params.ubatch.n_tokens == n_env;
+    }
+
+    ggml_tensor * tokens = nullptr; // I32 [n_env]
+    ggml_tensor * h      = nullptr; // F32 [n_embd, n_env]
+
+    const int64_t  n_embd;
+    const uint32_t n_env;
+};
+
+//
+// compose
+//
+ggml_cgraph * llama_prefab_mtp_compose(
+        const llama_model & model,
+        const llm_graph_params & params,
+        uint32_t n_env,
+        llama_prefab_state & st,
+        llama_prefab_stats & stats) {
+    // eligibility is checked, never asserted: a declined ubatch must not abort the process.
+    // Exact fit only (no envelope padding, no KV headroom); n_outputs may be smaller than the
+    // envelope (the stock head sizes out_ids by it), never larger.
+    if (model.arch != LLM_ARCH_QWEN4EXP) {
+        throw std::runtime_error("mtp factor compose: arch is not QWEN4EXP");
+    }
+    if (params.gtype != LLM_GRAPH_TYPE_DECODER_MTP) {
+        throw std::runtime_error("mtp factor compose: graph type is not DECODER_MTP");
+    }
+    if (params.ubatch.n_tokens != n_env) {
+        throw std::runtime_error("mtp factor compose: ubatch does not fill the envelope");
+    }
+    if (params.res == nullptr) {
+        throw std::runtime_error("mtp factor compose: no result object");
+    }
+    if (params.ubatch.token == nullptr || params.ubatch.embd == nullptr) {
+        throw std::runtime_error("mtp factor compose: ubatch lacks token or embedding input");
+    }
+    if (params.n_outputs <= 0 || params.n_outputs > (int64_t) n_env) {
+        // the stock head sizes out_ids by n_outputs and the driver reads exactly that many rows
+        // back; more outputs than the envelope has rows cannot be produced
+        throw std::runtime_error("mtp factor compose: n_outputs does not fit the envelope");
+    }
+
+    // n_kv is the live count: B binds the stock KV input, whose can_reuse compares the mask width
+    // against the exact n_kv, so the graph is rebuilt whenever n_kv changes. The MTP compose never
+    // widens the KV window.
+
+    // params is used as-is: the stock head sizes out_ids by params.n_outputs, exactly as on the
+    // stock path, so the composed graph returns the same rows
+    llm_graph_params p = params;
+    llm_graph_context g(p);
+
+    const int64_t hc_dim = (int64_t) g.hparams.n_embd_out();
+
+    // --- A: cached head prologue, compiled once per (model, n_env). Fetched before the input
+    // tensors because the shared-node path binds this graph's inputs to A's own tensors.
+    llama_prefab_mtp_a_module * a = st.mtp_a.get(model, n_env);
+    if (a != nullptr) {
+        llama_prefab_stat_tick(stats.n_mtp_a_reuses);
+        llama_prefab_stat_tick(stats.template_hits);
+    } else {
+        auto mod = prefab_mtp_compile_a(model, params, n_env);
+        llama_prefab_stat_tick(stats.n_mtp_a_compiles);
+        llama_prefab_stat_add(stats.n_nodes_built, mod->n_a);
+        a = mod.get();
+        st.mtp_a.modules[{ &model, n_env }] = std::move(mod);
+    }
+
+    // --- inputs, same shapes/types as the stock head's own inputs
+    auto inp_u = std::make_unique<llm_graph_input_prefab_mtp_inp>(hc_dim, n_env);
+    ggml_tensor * tokens = nullptr;
+    ggml_tensor * h      = nullptr;
+    std::map<std::string, ggml_tensor *> a_outs;
+    if (llama_prefab_noclone_enabled()) {
+        // shared-node A x B compose: A's tensors are referenced in place, never
+        // re-instantiated. The envelope's input writer feeds A's formal input tensors and
+        // B is emitted directly on A's resident cut tensors; when B's outputs are expanded,
+        // A's nodes enter this graph through the normal src walk (the weights were already
+        // shared that way). Before the graph is built, the data/buffer pointers of every
+        // tensor A owns are cleared so THIS graph's scheduler allocation plans them afresh:
+        // a pointer left over from a previous allocation is indistinguishable from an
+        // external tensor and would be left out of a re-planned layout, letting fresh
+        // allocations overlap A's memory. A fresh template has null pointers, so this is a
+        // no-op on the first compose.
+        ggml_cgraph * ga = a->res->get_gf();
+        // ownership range as integers: relational comparison of pointers into unrelated
+        // objects is unspecified in C++, so compare uintptr_t values instead.
+        const uintptr_t buf_beg = reinterpret_cast<uintptr_t>(ggml_get_mem_buffer(a->res->get_ctx()));
+        const uintptr_t buf_end = buf_beg + ggml_get_mem_size(a->res->get_ctx());
+        auto release_owned = [&](ggml_tensor * t) {
+            if (t == nullptr) {
+                return;
+            }
+            if (reinterpret_cast<uintptr_t>(t) < buf_beg || reinterpret_cast<uintptr_t>(t) >= buf_end) {
+                return; // weights and other external tensors: not owned by A, never touched
+            }
+            t->data = nullptr;
+            t->buffer = nullptr;
+        };
+        // walk the template graph's nodes and transitively their sources and view sources:
+        // this reaches every tensor of the template graph, including leaves (the formal
+        // input placeholders and any leaf a future prologue might add), so no A-owned
+        // tensor can retain a stale allocation pointer into a re-planned pool. Tensors
+        // outside A's context (weights) fail the ownership test and are never touched.
+        std::set<const ggml_tensor *> visited;
+        std::function<void(ggml_tensor *)> visit = [&](ggml_tensor * t) {
+            if (t == nullptr || visited.count(t) != 0) {
+                return;
+            }
+            visited.insert(t);
+            release_owned(t);
+            for (int i = 0; i < GGML_MAX_SRC; ++i) {
+                visit(t->src[i]);
+            }
+            if (t->view_src != nullptr) {
+                visit(t->view_src);
+            }
+        };
+        for (int i = 0; i < ggml_graph_n_nodes(ga); ++i) {
+            visit(ggml_graph_node(ga, i));
+        }
+        for (const auto & kv : a->inputs) {
+            visit(kv.second); // formal inputs, incl. any the prologue registered but the
+                              // graph does not reach (defensive; data stays null there)
+        }
+        tokens = a->inputs.at("tokens");
+        h      = a->inputs.at("h");
+        GGML_ASSERT(tokens->type == GGML_TYPE_I32 && tokens->ne[0] == (int64_t) n_env);
+        GGML_ASSERT(h->type == GGML_TYPE_F32 && h->ne[0] == hc_dim && h->ne[1] == (int64_t) n_env);
+        // A's formal inputs already carry the input flag and their build-time names (the
+        // prologue's own embedding input registered them), so they are bound as-is.
+        inp_u->tokens = tokens;
+        inp_u->h      = h;
+        a_outs        = a->outputs; // the shared cut tensors: B reads A in place
+    } else {
+        // clone path (unchanged): fresh envelope input tensors, A re-instantiated per compose
+        inp_u->tokens = ggml_new_tensor_1d(g.ctx0, GGML_TYPE_I32, n_env);
+        ggml_set_name(inp_u->tokens, "inp_tokens");
+        ggml_set_input(inp_u->tokens);
+        inp_u->h = ggml_new_tensor_2d(g.ctx0, GGML_TYPE_F32, hc_dim, n_env);
+        ggml_set_input(inp_u->h);
+        ggml_set_name(inp_u->h, "mtp_h_input");
+        tokens = inp_u->tokens;
+        h      = inp_u->h;
+        a_outs = prefab_mtp_splice_a(g, *a, { { "tokens", tokens }, { "h", h } }, stats);
+    }
+    g.res->t_inp_tokens = tokens;
+    g.res->add_input(std::move(inp_u));
+
+    // --- B: the trunk-style block + epilogue, emitted by the stock head code on top of the
+    // A cut tensors (shared in place with GGML_TP5_PREFAB_NOCLONE=1, re-instantiated by the
+    // splice otherwise). It binds this graph's pos / out_ids / KV inputs; out_ids is sized by
+    // params.n_outputs, exactly as on the stock path.
+    llama_model_qwen4exp::graph_mtp gm(model, p, llama_model_qwen4exp::graph_mtp::no_build_t{});
+    // --- B's KV input: the padded KV window of the whole-graph slot (n_kv is a runtime
+    // parameter; the prefab mask writer -INF-masks the pad columns, so attention never
+    // reads beyond the live width and the composed graph is reused while n_kv fits the
+    // window the slot was composed for -- the reuse judgement in llama-prefab-hotpath.h)
+    const auto * kvc = static_cast<const llama_kv_cache_context *>(params.mctx);
+    const uint32_t n_kv_pad = kvc->get_n_kv_pad();
+    GGML_ASSERT(llama_prefab_nkv_fits(n_kv_pad, kvc->get_n_kv()));
+    auto inp_attn_u = std::make_unique<llm_graph_input_prefab_attn_kv>(
+            g.hparams, g.cparams, kvc, n_env, n_kv_pad, &st);
+    // the input object owns the per-ubatch tensors the stock attention build consumes:
+    // cache cell indices (fed to cpy_k/cpy_v), the padded KV mask, and the rotation tables.
+    // Same constructors as the stock head (build_attn_inp_kv_impl) and the factor envelope
+    // (llama-prefab.cpp), so shapes/types match and set_input can write them each ubatch.
+    inp_attn_u->self_k_idxs  = kvc->build_input_k_idxs(g.ctx0, g.ubatch);
+    inp_attn_u->self_v_idxs  = kvc->build_input_v_idxs(g.ctx0, g.ubatch);
+    inp_attn_u->self_kq_mask = ggml_new_tensor_4d(g.ctx0,
+            g.cparams.flash_attn ? GGML_TYPE_F16 : GGML_TYPE_F32, n_kv_pad, n_env, 1, 1);
+    ggml_set_input(inp_attn_u->self_kq_mask);
+    ggml_set_name(inp_attn_u->self_kq_mask, "attn_inp_kq_mask");
+    inp_attn_u->self_kq_mask_cnv = inp_attn_u->self_kq_mask;
+    inp_attn_u->self_k_rot = kvc->build_input_k_rot(g.ctx0);
+    inp_attn_u->self_v_rot = kvc->build_input_v_rot(g.ctx0);
+    // register BEFORE the block build: the slot result owns the input object
+    // (res->inputs), so set_input/can_reuse run per ubatch and the raw pointer
+    // stays valid past this scope; an unregistered input would die with this
+    // function and its mask/idxs tensors would never be written per request.
+    auto * inp_attn = (llm_graph_input_attn_kv *) g.res->add_input(std::move(inp_attn_u));
+    gm.build_mtp_block(a_outs.at("block_in"), a_outs.at("res_hc"), a_outs.at("inject"), inp_attn);
+    if (gm.res->t_h_nextn == nullptr || gm.res->t_logits == nullptr) {
+        throw std::runtime_error("mtp factor compose: head block did not emit its outputs");
+    }
+    llama_prefab_stat_tick(stats.n_mtp_b_builds);
+
+    g.res->t_h_nextn = gm.res->t_h_nextn;
+    g.res->t_logits  = gm.res->t_logits;
+
+    // the stock builder does this in llama_model::build_graph; without it the scheduler may
+    // reuse t_h_nextn / t_logits as scratch and clobber them before they are read back
+    g.res->set_outputs(p);
+
+    return g.res->get_gf();
+}
diff --git a/src/llama-prefab-splice.h b/src/llama-prefab-splice.h
new file mode 100644
index 0000000..a23da9d
--- /dev/null
+++ b/src/llama-prefab-splice.h
@@ -0,0 +1,130 @@
+#pragma once
+
+// ggml-only DAG splice kernel of the factor-prefab compose layers.
+//
+// A module ("A") is a graph emitted into its own ggml context: a list of `n_nodes` nodes in
+// emission order (a topological order, because it was built with ggml_build_forward_expand),
+// named cut tensors ("outputs") and formal placeholder inputs.
+//
+// Splice clones that DAG into a destination context/graph:
+//   - a formal input is substituted by the destination tensor of the same name; the layout
+//     (type, ne[0..3], nb[0..3]) must match exactly, otherwise it throws;
+//   - a tensor that is not allocated in the module's own mem buffer is a shared weight (or any
+//     other model-owned tensor): it is never cloned, the pointer is reused as-is;
+//   - an unbound placeholder (op NONE, no view_src) throws: the DAG cannot be spliced without
+//     one of its inputs;
+//   - every other node is cloned into the destination context, its sources are cloned
+//     recursively, and the clone is expanded into the destination graph in the module's node
+//     order.
+//
+// This header depends only on ggml so that the kernel can be exercised outside llama.cpp
+// (a standalone CPU harness covers the splice contract; it lives next to the workdir root).
+
+#include "ggml.h"
+
+#include <cstdint>
+#include <cstring>
+#include <functional>
+#include <map>
+#include <stdexcept>
+#include <string>
+#include <unordered_map>
+
+struct llama_prefab_dag {
+    ggml_context * ctx = nullptr; // context the module's tensors live in (ownership test)
+    ggml_cgraph  * gf  = nullptr; // the module's graph (node order)
+
+    int n_nodes = 0; // nodes to splice, in emission order
+
+    std::map<std::string, ggml_tensor *> inputs;  // formal placeholders
+    std::map<std::string, ggml_tensor *> outputs; // named cut tensors
+};
+
+// Clone `src` into dst_ctx/dst_gf, substituting `subs`. Returns the cloned outputs by name.
+// `n_clones` (may be null) receives the number of cloned tensors; it is bumped as tensors are
+// cloned, so a throw leaves it holding the clones created up to that point.
+inline std::map<std::string, ggml_tensor *> llama_prefab_dag_splice(
+        ggml_context * dst_ctx,
+        ggml_cgraph  * dst_gf,
+        const llama_prefab_dag & src,
+        const std::map<std::string, ggml_tensor *> & subs,
+        uint64_t * n_clones) {
+    // ownership: tensor addresses inside the module's mem buffer belong to the module
+    const char * buf_beg = (const char *) ggml_get_mem_buffer(src.ctx);
+    const char * buf_end = buf_beg + ggml_get_mem_size(src.ctx);
+
+    std::unordered_map<const ggml_tensor *, ggml_tensor *> map;
+
+    for (const auto & [name, ph] : src.inputs) {
+        auto it = subs.find(name);
+        if (it == subs.end() || it->second == nullptr) {
+            throw std::runtime_error("factor-prefab splice: unbound input '" + name + "'");
+        }
+        ggml_tensor * t = it->second;
+        bool same = t->type == ph->type;
+        for (int i = 0; i < GGML_MAX_DIMS; ++i) {
+            same = same && t->ne[i] == ph->ne[i] && t->nb[i] == ph->nb[i];
+        }
+        if (!same) {
+            throw std::runtime_error("factor-prefab splice: layout mismatch for input '" + name + "'");
+        }
+        map[ph] = t;
+    }
+
+    std::function<ggml_tensor * (ggml_tensor *)> clone = [&](ggml_tensor * t_src) -> ggml_tensor * {
+        if (t_src == nullptr) {
+            return nullptr;
+        }
+        auto it = map.find(t_src);
+        if (it != map.end()) {
+            return it->second;
+        }
+        const char * p = (const char *) t_src;
+        if (p < buf_beg || p >= buf_end) {
+            // weights: shared, never cloned
+            map[t_src] = t_src;
+            return t_src;
+        }
+        if (t_src->op == GGML_OP_NONE && t_src->view_src == nullptr) {
+            // an unbound placeholder: the DAG registered an input the caller did not bind
+            throw std::runtime_error(std::string("factor-prefab splice: leaf '") + t_src->name +
+                    "' is not a formal input");
+        }
+
+        ggml_tensor * t = ggml_new_tensor(dst_ctx, t_src->type, GGML_MAX_DIMS, t_src->ne);
+        for (int i = 0; i < GGML_MAX_DIMS; ++i) {
+            t->nb[i] = t_src->nb[i];
+        }
+        t->op    = t_src->op;
+        t->flags = t_src->flags;
+        memcpy(t->op_params, t_src->op_params, sizeof(t->op_params));
+        ggml_set_name(t, t_src->name);
+
+        for (int i = 0; i < GGML_MAX_SRC; ++i) {
+            t->src[i] = clone(t_src->src[i]);
+        }
+        if (t_src->view_src != nullptr) {
+            t->view_src  = clone(t_src->view_src);
+            t->view_offs = t_src->view_offs;
+            if (t->view_src->data != nullptr) {
+                t->data = (char *) t->view_src->data + t->view_offs;
+            }
+        }
+
+        map[t_src] = t;
+        if (n_clones != nullptr) {
+            (*n_clones)++;
+        }
+        return t;
+    };
+
+    for (int i = 0; i < src.n_nodes; ++i) {
+        ggml_build_forward_expand(dst_gf, clone(ggml_graph_node(src.gf, i)));
+    }
+
+    std::map<std::string, ggml_tensor *> outs;
+    for (const auto & [name, t] : src.outputs) {
+        outs[name] = clone(t);
+    }
+    return outs;
+}
diff --git a/src/llama-prefab.cpp b/src/llama-prefab.cpp
new file mode 100644
index 0000000..7bce811
--- /dev/null
+++ b/src/llama-prefab.cpp
@@ -0,0 +1,1184 @@
+#include "llama-prefab.h"
+
+#include "llama-prefab-env.h"
+#include "llama-impl.h"
+#include "llama-model.h"
+#include "llama-kv-cache.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+#include <functional>
+#include <stdexcept>
+#include <cstdlib>
+#include <cstdio>
+
+//
+// topology key / cache / state
+//
+
+bool llama_prefab_topology_key::operator==(const llama_prefab_topology_key & o) const {
+    return model == o.model && memory == o.memory && arch == o.arch &&
+           n_embd == o.n_embd && n_layer == o.n_layer && n_head == o.n_head && n_head_kv == o.n_head_kv &&
+           kv_size == o.kv_size && type_k == o.type_k && type_v == o.type_v &&
+           flash_attn == o.flash_attn && v_trans == o.v_trans && causal == o.causal && warmup == o.warmup &&
+           rope_freq_base == o.rope_freq_base && rope_freq_scale == o.rope_freq_scale;
+}
+
+bool llama_prefab_factor_module::owns(const ggml_tensor * t) const {
+    ggml_context * ctx = res->get_ctx();
+    const char * b = (const char *) ggml_get_mem_buffer(ctx);
+    const char * e = b + ggml_get_mem_size(ctx);
+    const char * p = (const char *) t;
+    return p >= b && p < e;
+}
+
+bool llama_prefab_factor_cache::validate_or_reset(const llama_prefab_topology_key & k) {
+    if (has_key && key == k) {
+        return false;
+    }
+    const bool had = has_key && !modules.empty();
+    clear();
+    key     = k;
+    has_key = true;
+    return had;
+}
+
+void llama_prefab_factor_cache::clear() {
+    modules.clear();
+    has_key = false;
+    key = {};
+}
+
+int llama_prefab_state::slot_for(uint32_t n_tokens) const {
+    for (size_t i = 0; i < slots.size(); ++i) {
+        if (n_tokens <= slots[i].n_env) {
+            return (int) i;
+        }
+    }
+    return -1;
+}
+
+void llama_prefab_state::sync_pending() {
+    // every slot whose graph was executed since the last synchronize may still be running: the
+    // output copies read from its buffers, and resetting the slot would free them under the
+    // backend. Drain all of them, not just the last one that became active.
+    for (ggml_backend_sched_t s : pending) {
+        if (s != nullptr) {
+            ggml_backend_sched_synchronize(s);
+        }
+    }
+    pending.clear();
+}
+
+void llama_prefab_state::mark_pending(ggml_backend_sched_t s) {
+    // the envelope graph was just dispatched on s: its outputs are read asynchronously and its
+    // buffers must not be reset/freed before a synchronize drains it
+    if (s == nullptr) {
+        return;
+    }
+    for (ggml_backend_sched_t p : pending) {
+        if (p == s) {
+            return;
+        }
+    }
+    pending.push_back(s);
+}
+
+void llama_prefab_state::reset_slots() {
+    // nothing may be reset while a slot's graph is still in flight
+    sync_pending();
+    for (auto & s : slots) {
+        if (s.res) {
+            s.res->reset();
+        }
+        if (s.sched) {
+            ggml_backend_sched_reset(s.sched.get());
+        }
+        s.built = false;
+    }
+    if (llama_prefab_mtp_lifetime_enabled()) {
+        mtp_a.clear();
+    }
+    active = nullptr;
+}
+
+//
+// envelope inputs
+//
+
+bool llm_graph_input_is_prefab(const llm_graph_input_i * inp) {
+    return dynamic_cast<const llm_graph_input_prefab_tokens  *>(inp) != nullptr ||
+           dynamic_cast<const llm_graph_input_prefab_pos     *>(inp) != nullptr ||
+           dynamic_cast<const llm_graph_input_prefab_out_ids *>(inp) != nullptr ||
+           dynamic_cast<const llm_graph_input_prefab_attn_kv *>(inp) != nullptr;
+}
+
+void llm_graph_input_prefab_tokens::set_input(const llama_ubatch * ubatch) {
+    GGML_ASSERT(ubatch->token != nullptr);
+    const uint32_t n = ubatch->n_tokens;
+    GGML_ASSERT(n >= 1 && n <= n_env);
+    std::vector<int32_t> data(n_env);
+    for (uint32_t i = 0; i < n_env; ++i) {
+        data[i] = ubatch->token[i < n ? i : n - 1];
+    }
+    ggml_backend_tensor_set(tokens, data.data(), 0, n_env*sizeof(int32_t));
+}
+
+bool llm_graph_input_prefab_tokens::can_reuse(const llm_graph_params & params) {
+    return tokens->ne[0] == (int64_t) params.ubatch.n_tokens && params.ubatch.n_tokens == n_env;
+}
+
+void llm_graph_input_prefab_pos::set_input(const llama_ubatch * ubatch) {
+    GGML_ASSERT(ubatch->pos != nullptr);
+    const uint32_t n = ubatch->n_tokens;
+    GGML_ASSERT(n >= 1 && n <= n_env);
+    std::vector<int32_t> data(n_env);
+    for (uint32_t i = 0; i < n_env; ++i) {
+        data[i] = ubatch->pos[i < n ? i : n - 1];
+    }
+    ggml_backend_tensor_set(pos, data.data(), 0, n_env*sizeof(int32_t));
+}
+
+bool llm_graph_input_prefab_pos::can_reuse(const llm_graph_params & params) {
+    return pos->ne[0] == (int64_t) params.ubatch.n_tokens && params.ubatch.n_tokens == n_env;
+}
+
+void llm_graph_input_prefab_out_ids::set_input(const llama_ubatch * ubatch) {
+    const uint32_t n = ubatch->n_tokens;
+    GGML_ASSERT(n >= 1 && n <= n_env);
+    std::vector<int32_t> data;
+    data.reserve(n_env);
+    for (uint32_t i = 0; i < n; ++i) {
+        if (ubatch->output == nullptr || ubatch->output[i]) {
+            data.push_back((int32_t) i);
+        }
+    }
+    // pad rows: duplicate the last real output (or the last real row if there is no output)
+    const int32_t pad = data.empty() ? (int32_t) (n - 1) : data.back();
+    while (data.size() < n_env) {
+        data.push_back(pad);
+    }
+    ggml_backend_tensor_set(out_ids, data.data(), 0, n_env*sizeof(int32_t));
+}
+
+bool llm_graph_input_prefab_out_ids::can_reuse(const llm_graph_params & params) {
+    return out_ids->ne[0] == (int64_t) params.n_outputs && params.n_outputs == n_env;
+}
+
+void llm_graph_input_prefab_attn_kv::set_input(const llama_ubatch * ubatch) {
+    GGML_ASSERT(readers.empty());
+    GGML_ASSERT(st != nullptr);
+    const uint32_t n = ubatch->n_tokens;
+    GGML_ASSERT(n >= 1 && n <= n_env);
+    GGML_ASSERT(n == n_env || st->scratch_cell >= 0);
+
+    mctx->prefab_set_input_idxs(self_k_idxs, self_v_idxs, ubatch, n_env, st->scratch_cell);
+
+    if (self_kq_mask && self_kq_mask->buffer) {
+        // the mask is [n_kv_pad, n_env, 1, 1]; the writer masks pad columns
+        // [live n_kv, n_kv_pad) with -inf so the extra K/V view columns never contribute
+        mctx->prefab_set_input_kq_mask(self_kq_mask, ubatch, cparams.causal_attn, n_env);
+    }
+    if (self_k_rot && self_k_rot->buffer) {
+        mctx->set_input_k_rot(self_k_rot);
+    }
+    if (self_v_rot && self_v_rot->buffer) {
+        mctx->set_input_v_rot(self_v_rot);
+    }
+}
+
+bool llm_graph_input_prefab_attn_kv::can_reuse(const llm_graph_params & params) {
+    const auto * mctx = static_cast<const llama_kv_cache_context *>(params.mctx);
+
+    if (!readers.empty() || mctx->has_attention_views()) {
+        return false;
+    }
+
+    // re-bind the (possibly new) context, like the stock can_reuse
+    this->mctx = mctx;
+
+    bool res = true;
+
+    res &= self_k_idxs->ne[0] == params.ubatch.n_tokens;
+
+    // n_kv is a runtime parameter: the mask/K/V-view width is the padded width, and the
+    // graph is reused as long as the live n_kv fits it (the mask writer masks the pad
+    // columns). ne[1]/ne[2]/ne[3] checks as in the stock can_reuse_kq_mask, with n_env rows.
+    res &= self_kq_mask->ne[0] == (int64_t) n_kv_pad;
+    res &= self_kq_mask->ne[1] == (int64_t) n_env;
+    res &= self_kq_mask->ne[2] == 1;
+    res &= self_kq_mask->ne[3] == 1;
+    res &= mctx->n_kv_pad_fits(n_kv_pad);
+
+    return res;
+}
+
+//
+// factor modules
+//
+
+static const llm_graph_cb & prefab_cb() {
+    // names only: the stock callback pins "norm"/"l_last" on the *main* sched, which never runs envelopes
+    // (the llama builder never emits those names, so this is placement-neutral for the supported archs)
+    static const llm_graph_cb cb = [](const llama_ubatch &, ggml_tensor * cur, const char * name, int il) {
+        if (il >= 0) {
+            ggml_format_name(cur, "%s-%d", name, il);
+        } else {
+            ggml_set_name(cur, name);
+        }
+    };
+    return cb;
+}
+
+static constexpr int64_t PREFAB_FACTOR_MAX_NODES = 2048;
+
+struct prefab_module_builder {
+    std::unique_ptr<llama_prefab_factor_module> m;
+    llm_graph_params                            p;
+    std::unique_ptr<llm_graph_context>          g;
+
+    prefab_module_builder(const llm_graph_params & params, const llama_prefab_factor_key & key) {
+        m = std::make_unique<llama_prefab_factor_module>();
+        m->key = key;
+        m->res = std::make_unique<llm_graph_result>(PREFAB_FACTOR_MAX_NODES);
+        p = params;
+        p.res = m->res.get();
+        p.cb  = prefab_cb();
+        g = std::make_unique<llm_graph_context>(p);
+    }
+
+    ggml_tensor * input(const char * name, ggml_type type, int64_t ne0, int64_t ne1 = 1, int64_t ne2 = 1, int64_t ne3 = 1) {
+        ggml_tensor * t = ggml_new_tensor_4d(g->ctx0, type, ne0, ne1, ne2, ne3);
+        ggml_format_name(t, "pf_in_%s", name);
+        m->inputs[name] = t;
+        return t;
+    }
+
+    // placeholder with the exact layout (ne + nb) of a producer tensor of another factor
+    ggml_tensor * input_like(const char * name, const ggml_tensor * ref) {
+        ggml_tensor * t = ggml_new_tensor(g->ctx0, ref->type, GGML_MAX_DIMS, ref->ne);
+        for (int i = 0; i < GGML_MAX_DIMS; ++i) {
+            t->nb[i] = ref->nb[i];
+        }
+        ggml_format_name(t, "pf_in_%s", name);
+        m->inputs[name] = t;
+        return t;
+    }
+
+    void bind(const char * name, ggml_tensor * t) {
+        if (t == nullptr) {
+            return;
+        }
+        m->inputs[name] = t;
+    }
+
+    void output(const char * name, ggml_tensor * t) {
+        GGML_ASSERT(t != nullptr);
+        ggml_build_forward_expand(g->gf, t);
+        m->outputs[name] = t;
+    }
+
+    std::unique_ptr<llama_prefab_factor_module> finish() {
+        g.reset();
+        return std::move(m);
+    }
+};
+
+static std::unique_ptr<llama_prefab_factor_module> prefab_compile_embd(
+        const llama_model & model, const llm_graph_params & params, uint32_t n_env) {
+    prefab_module_builder b(params, { LLAMA_PREFAB_FACTOR_EMBD, -1, n_env, 0 });
+    auto & g = *b.g;
+
+    ggml_tensor * tokens = b.input("tokens", GGML_TYPE_I32, n_env);
+    ggml_tensor * cur = ggml_get_rows(g.ctx0, model.tok_embd, tokens);
+    if (g.hparams.f_embedding_scale != 0.0f) {
+        cur = ggml_scale(g.ctx0, cur, g.hparams.f_embedding_scale);
+    }
+    b.output("inpL", cur);
+    return b.finish();
+}
+
+static std::unique_ptr<llama_prefab_factor_module> prefab_compile_qkv(
+        const llama_model & model, const llm_graph_params & params, int il, uint32_t n_env) {
+    prefab_module_builder b(params, { LLAMA_PREFAB_FACTOR_QKV, il, n_env, 0 });
+    auto & g = *b.g;
+
+    const int64_t n_embd_head = g.hparams.n_embd_head_v();
+    GGML_ASSERT(n_embd_head == g.hparams.n_embd_head_k());
+    GGML_ASSERT(n_embd_head == g.n_rot);
+
+    ggml_tensor * inpL    = b.input("inpL",    GGML_TYPE_F32, g.n_embd, n_env);
+    ggml_tensor * inp_pos = b.input("inp_pos", GGML_TYPE_I32, n_env);
+
+    // == llama_model_llama::graph<false> (src/models/llama.cpp), per-layer attention prologue
+    ggml_tensor * cur = g.build_norm(inpL, model.layers[il].attn_norm, NULL, LLM_NORM_RMS, il);
+    g.cb(cur, "attn_norm", il);
+
+    ggml_tensor * rope_factors = model.get_rope_factors(g.cparams, il);
+
+    auto [Qcur, Kcur, Vcur] = g.build_qkv(model.layers[il], cur, n_embd_head, g.n_head, g.n_head_kv, il);
+
+    Qcur = ggml_rope_ext(g.ctx0, Qcur, inp_pos, rope_factors,
+            g.n_rot, g.rope_type, g.n_ctx_orig, g.freq_base, g.freq_scale,
+            g.ext_factor, g.attn_factor, g.beta_fast, g.beta_slow);
+    Kcur = ggml_rope_ext(g.ctx0, Kcur, inp_pos, rope_factors,
+            g.n_rot, g.rope_type, g.n_ctx_orig, g.freq_base, g.freq_scale,
+            g.ext_factor, g.attn_factor, g.beta_fast, g.beta_slow);
+
+    g.cb(Qcur, "Qcur", il);
+    g.cb(Kcur, "Kcur", il);
+    g.cb(Vcur, "Vcur", il);
+
+    if (g.hparams.use_kq_norm) {
+        Qcur = ggml_rms_norm(g.ctx0, Qcur, g.hparams.f_norm_rms_eps);
+        Kcur = ggml_rms_norm(g.ctx0, Kcur, g.hparams.f_norm_rms_eps);
+        g.cb(Qcur, "Qcur_normed", il);
+        g.cb(Kcur, "Kcur_normed", il);
+    }
+
+    // same expansion order as build_attn (q, v, k)
+    b.output("q", Qcur);
+    b.output("v", Vcur);
+    b.output("k", Kcur);
+    return b.finish();
+}
+
+static std::unique_ptr<llama_prefab_factor_module> prefab_compile_attn(
+        const llama_model & model, const llm_graph_params & params, int il, uint32_t n_env, uint32_t n_kv_pad,
+        const llama_prefab_factor_module & qkv) {
+    prefab_module_builder b(params, { LLAMA_PREFAB_FACTOR_ATTN, il, n_env, n_kv_pad });
+    auto & g = *b.g;
+
+    const auto * kvc = static_cast<const llama_kv_cache_context *>(g.mctx);
+    // n_kv is a runtime parameter: the factor is compiled for the padded width, which must
+    // cover the current n_kv (the envelope asserts the same before composing)
+    GGML_ASSERT(kvc->n_kv_pad_fits(n_kv_pad));
+
+    const int64_t n_embd_head = g.hparams.n_embd_head_v();
+    const float kq_scale = g.hparams.f_attention_scale == 0.0f ? 1.0f/sqrtf(float(n_embd_head)) : g.hparams.f_attention_scale;
+
+    ggml_tensor * q = b.input_like("q", qkv.outputs.at("q"));
+    ggml_tensor * k = b.input_like("k", qkv.outputs.at("k"));
+    ggml_tensor * v = b.input_like("v", qkv.outputs.at("v"));
+
+    // formal KV inputs: same constructors as the envelope inputs -> same shapes/types
+    llm_graph_input_attn_kv inp(g.hparams, g.cparams, kvc);
+    inp.n_kv_pad = n_kv_pad; // build_attn sizes the K/V views by the padded width
+    inp.self_k_idxs = kvc->build_input_k_idxs(g.ctx0, g.ubatch);
+    inp.self_v_idxs = kvc->build_input_v_idxs(g.ctx0, g.ubatch);
+    inp.self_kq_mask = ggml_new_tensor_4d(g.ctx0, g.cparams.flash_attn ? GGML_TYPE_F16 : GGML_TYPE_F32, n_kv_pad, n_env, 1, 1);
+    inp.self_kq_mask_cnv = inp.self_kq_mask;
+    inp.self_k_rot = kvc->build_input_k_rot(g.ctx0);
+    inp.self_v_rot = kvc->build_input_v_rot(g.ctx0);
+
+    b.bind("k_idxs",  inp.self_k_idxs);
+    b.bind("v_idxs",  inp.self_v_idxs);
+    b.bind("kq_mask", inp.self_kq_mask);
+    b.bind("k_rot",   inp.self_k_rot);
+    b.bind("v_rot",   inp.self_v_rot);
+
+    ggml_tensor * cur = g.build_attn(&inp,
+            model.layers[il].wo, model.layers[il].wo_b, model.layers[il].wo_s,
+            q, k, v, nullptr, nullptr, nullptr, kq_scale, il);
+    g.cb(cur, "attn_out", il);
+
+    b.output("out", cur);
+    return b.finish();
+}
+
+static std::unique_ptr<llama_prefab_factor_module> prefab_compile_ffn(
+        const llama_model & model, const llm_graph_params & params, int il, uint32_t n_env) {
+    prefab_module_builder b(params, { LLAMA_PREFAB_FACTOR_FFN, il, n_env, 0 });
+    auto & g = *b.g;
+
+    ggml_tensor * cur   = b.input("cur",   GGML_TYPE_F32, g.n_embd, n_env);
+    ggml_tensor * inpSA = b.input("inpSA", GGML_TYPE_F32, g.n_embd, n_env);
+
+    ggml_tensor * ffn_inp = ggml_add(g.ctx0, cur, inpSA);
+    g.cb(ffn_inp, "ffn_inp", il);
+
+    if (model.layers[il].ffn_gate_inp == nullptr) {
+        cur = g.build_norm(ffn_inp, model.layers[il].ffn_norm, NULL, LLM_NORM_RMS, il);
+        g.cb(cur, "ffn_norm", il);
+
+        cur = g.build_ffn(cur,
+                model.layers[il].ffn_up,   model.layers[il].ffn_up_b,   model.layers[il].ffn_up_s,
+                model.layers[il].ffn_gate, model.layers[il].ffn_gate_b, model.layers[il].ffn_gate_s,
+                model.layers[il].ffn_down, model.layers[il].ffn_down_b, model.layers[il].ffn_down_s,
+                NULL,
+                LLM_FFN_SILU, LLM_FFN_PAR, il);
+        g.cb(cur, "ffn_out", il);
+    } else {
+        cur = g.build_norm(ffn_inp, model.layers[il].ffn_norm, NULL, LLM_NORM_RMS, il);
+        g.cb(cur, "ffn_norm", il);
+
+        cur = g.build_moe_ffn(cur,
+                model.layers[il].ffn_gate_inp,
+                model.layers[il].ffn_up_exps,
+                model.layers[il].ffn_gate_exps,
+                model.layers[il].ffn_down_exps,
+                nullptr,
+                g.n_expert, g.n_expert_used,
+                LLM_FFN_SILU, true,
+                g.hparams.expert_weights_scale,
+                LLAMA_EXPERT_GATING_FUNC_TYPE_SOFTMAX,
+                il,
+                nullptr, nullptr,
+                model.layers[il].ffn_up_exps_s,
+                model.layers[il].ffn_gate_exps_s,
+                model.layers[il].ffn_down_exps_s);
+        g.cb(cur, "ffn_moe_out", il);
+    }
+    cur = ggml_add(g.ctx0, cur, ffn_inp);
+    g.cb(cur, "ffn_out", il);
+
+    cur = g.build_cvec(cur, il);
+    g.cb(cur, "l_out", il);
+
+    b.output("out", cur);
+    return b.finish();
+}
+
+static std::unique_ptr<llama_prefab_factor_module> prefab_compile_out(
+        const llama_model & model, const llm_graph_params & params, uint32_t n_env) {
+    prefab_module_builder b(params, { LLAMA_PREFAB_FACTOR_OUT, -1, n_env, 0 });
+    auto & g = *b.g;
+
+    ggml_tensor * cur = b.input("inpL", GGML_TYPE_F32, g.n_embd, n_env);
+
+    cur = g.build_norm(cur, model.output_norm, NULL, LLM_NORM_RMS, -1);
+    g.cb(cur, "result_norm", -1);
+    b.output("embd", cur);
+
+    cur = g.build_lora_mm(model.output, cur, model.output_s);
+    g.cb(cur, "result_output", -1);
+    b.output("logits", cur);
+    return b.finish();
+}
