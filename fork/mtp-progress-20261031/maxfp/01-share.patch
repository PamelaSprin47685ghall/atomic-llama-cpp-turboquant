 }
 
+// TP5 max-footprint share: reserve the measure graph while guaranteeing each
+// backend buffer's total capacity is at least min_sizes[backend_index]. The
+// graph is placed normally; only a shortfall against the caller's measured
+// max-footprint envelope is added to the last chunk. Later graphs from the
+// measured shape set then fit without any reallocation.
+void ggml_backend_sched_reserve_min(ggml_backend_sched_t sched, struct ggml_cgraph * measure_graph, const size_t * min_sizes) {
+    GGML_ASSERT(sched);
+    GGML_ASSERT((int)sched->hash_set.size >= measure_graph->n_nodes + measure_graph->n_leafs);
+    GGML_ASSERT(min_sizes);
+
+    ggml_backend_sched_synchronize(sched);
+
+    ggml_backend_sched_split_graph(sched, measure_graph);
+
+    ggml_gallocr_reserve_n_min(sched->galloc, &sched->graph, sched->node_backend_ids, sched->leaf_backend_ids, min_sizes);
+
+    ggml_backend_sched_reset(sched);
+}
