+        // measure pass 1: pp shape (split_only, no buffer is allocated or freed)
+        {
+            auto * gf = graph_reserve(n_tokens, n_seqs, n_outputs_pp, mctx.get(), true, sizes_pp.data());
+            if (!gf) {
+                throw std::runtime_error("failed to measure compute pp buffers");
+            }
+            n_splits_pp = ggml_backend_sched_get_n_splits(sched.get());
+            n_nodes_pp  = ggml_graph_n_nodes(gf);
+        }
+
+        // measure pass 2: tg shape (split_only, no buffer is allocated or freed)
+        {
+            auto * gf = graph_reserve(n_seqs, n_seqs, n_seqs, mctx.get(), true, sizes_tg.data());
+            if (!gf) {
+                throw std::runtime_error("failed to measure compute tg buffers");
+            }
+            n_splits_tg = ggml_backend_sched_get_n_splits(sched.get());
+            n_nodes_tg  = ggml_graph_n_nodes(gf);
+        }
+
+        // per-backend max footprint of the shape set
+        std::vector<size_t> sizes_max(backend_ptrs.size(), 0);
+        for (size_t i = 0; i < backend_ptrs.size(); ++i) {
+            sizes_max[i] = std::max(sizes_pp[i], sizes_tg[i]);
