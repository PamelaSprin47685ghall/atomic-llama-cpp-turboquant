diff --git a/ggml/src/ggml-alloc.c b/ggml/src/ggml-alloc.c
index cbe4577..be1d505 100644
--- a/ggml/src/ggml-alloc.c
+++ b/ggml/src/ggml-alloc.c
@@ -962,6 +962,68 @@ void ggml_gallocr_reserve_n_size(
     }
 }
 
+// TP5 max-footprint share: reserve with a caller-provided per-buffer minimum
+// size floor. The floor is applied to the buffer TOTAL (sum of chunk max_size)
+// after the graph's own placement pass, by growing the LAST chunk's max_size.
+// Growing the last chunk is safe for any later placement on this gallocr:
+//   - a later reserve resets the tallocr free lists and re-places from scratch,
+//     so only the chunk capacities (vbuffer sizes) persist across reserves;
+//   - chunk capacities are grow-only (reserve_n_impl never shrinks a chunk);
+//   - the last chunk is the one whose free block the allocator grows into when
+//     a placement overflows the earlier chunks (ggml_dyn_tallocr_alloc's
+//     last-block path), so extra capacity placed there is reachable by every
+//     later placement, unlike capacity in an interior chunk.
+// The floor is NOT a pad-to-max of the graph's own requirement: the graph is
+// still placed by the normal first-fit/best-fit pass; only the shortfall
+// between that placement's total and the measured max footprint of the shape
+// SET is added, once, at reserve time.
+void ggml_gallocr_reserve_n_min(
+        ggml_gallocr_t galloc, struct ggml_cgraph * graph, const int * node_buffer_ids, const int * leaf_buffer_ids, const size_t * min_sizes) {
+    GGML_ASSERT(min_sizes != NULL);
+    if (!ggml_gallocr_reserve_n_impl(galloc, graph, node_buffer_ids, leaf_buffer_ids, /*no_alloc =*/ false)) {
+        return;
+    }
+    for (int i = 0; i < galloc->n_buffers; i++) {
+        // if the buffer type is used multiple times, the same tallocr (and
+        // buffer) is shared; apply the floor once, at the first index
+        bool shared = false;
+        for (int j = 0; j < i; j++) {
+            if (galloc->buf_tallocs[j] == galloc->buf_tallocs[i]) {
+                shared = true;
+                break;
+            }
+        }
+        if (shared) {
+            continue;
+        }
+        size_t total = 0;
+        for (int c = 0; c < galloc->buf_tallocs[i]->n_chunks; c++) {
+            total += galloc->buf_tallocs[i]->chunks[c]->max_size;
+        }
+        if (min_sizes[i] > total) {
+            int last = galloc->buf_tallocs[i]->n_chunks - 1;
+            if (last < 0) {
+                // no chunk was created by this graph's placement (nothing was
+                // placed in this buffer); create one to hold the floor
+                if (ggml_dyn_tallocr_new_chunk(galloc->buf_tallocs[i], min_sizes[i] - total) == -1) {
+                    continue;
+                }
+                last = galloc->buf_tallocs[i]->n_chunks - 1;
+            }
+            galloc->buf_tallocs[i]->chunks[last]->max_size += min_sizes[i] - total;
+            // the buffer must be reallocated to the new capacity; the reserve
+            // pass above may have kept a smaller existing buffer (grow-only)
+            ggml_vbuffer_free(galloc->buffers[i]);
+            galloc->buffers[i] = ggml_vbuffer_alloc(galloc->bufts[i], galloc->buf_tallocs[i], GGML_BACKEND_BUFFER_USAGE_COMPUTE);
+            if (galloc->buffers[i] == NULL) {
+                GGML_LOG_ERROR("%s: failed to allocate %s buffer of size %zu\n", __func__,
+                               ggml_backend_buft_name(galloc->bufts[i]), min_sizes[i]);
+                GGML_ABORT("graph allocation: failed to reserve memory");
+            }
+        }
+    }
+}
+
 bool ggml_gallocr_reserve_n(ggml_gallocr_t galloc, struct ggml_cgraph * graph, const int * node_buffer_ids, const int * leaf_buffer_ids) {
     return ggml_gallocr_reserve_n_impl(galloc, graph, node_buffer_ids, leaf_buffer_ids, /*no_alloc =*/ false);
 }
