+    bool add(std::int64_t begin_ns, std::int64_t end_ns, std::uint32_t window) {
+        if (end_ns <= begin_ns) { ++bad_interval_; return false; }
+        if (window >= 64) { ++bad_window_; return false; }
+        if (capacity_ - used_ < 2) { ++dropped_; return false; }
+        storage_[used_++] = {begin_ns, 1, window};
+        storage_[used_++] = {end_ns, -1, window};
+        windows_ |= std::uint64_t(1) << window;
+        return true;
+    }
+
+    std::size_t size() const { return used_ / 2; }
+
+    // Sorting happens only at drain, after all intervals in this epoch arrive.
+    // For long-lived services, drain and reset bounded epochs; epochs must not
+    // split intervals whose cross-boundary intersections are needed.
+    void summarize(dw_dev_overlap_summary * out) {
+        dw_dev_overlap_summary result{};
+        result.events = used_;
+        result.intervals = size();
+        result.skipped_bad_interval = bad_interval_;
+        result.skipped_bad_window = bad_window_;
+        result.dropped_capacity = dropped_;
+        result.overflow = dropped_ != 0;
+        for (std::uint64_t bits = windows_; bits; bits &= bits - 1) ++result.windows;
+        if (used_) {
+            std::sort(storage_, storage_ + used_, [](const dw_dev_overlap_event & a, const dw_dev_overlap_event & b) {
+                return a.t_ns != b.t_ns ? a.t_ns < b.t_ns : a.delta < b.delta;
+            });
+            std::size_t active[64] = {};
+            unsigned distinct = 0;
+            std::int64_t previous = storage_[0].t_ns;
+            for (std::size_t i = 0; i < used_; ++i) {
+                const auto & e = storage_[i];
+                // Unsigned subtraction is defined even across the signed range.
+                const std::uint64_t elapsed = std::uint64_t(e.t_ns) - std::uint64_t(previous);
+                if (distinct) add_duration(result.union_ns, elapsed, result.overflow);
+                if (distinct >= 2) add_duration(result.overlap_ns, elapsed, result.overflow);
+                if (e.delta < 0) { if (--active[e.window] == 0) --distinct; }
+                else { if (active[e.window]++ == 0) ++distinct; }
+                previous = e.t_ns;
+            }
+        }
+        result.covered_once_ns = result.union_ns - result.overlap_ns;
+        *out = result;
+    }
+
+    void reset() { used_ = 0; windows_ = 0; bad_interval_ = bad_window_ = dropped_ = 0; }
+
+private:
+    static void add_duration(std::int64_t & total, std::uint64_t n, bool & overflow) {
+        const auto available = std::uint64_t(std::numeric_limits<std::int64_t>::max() - total);
+        if (n > available) { total = std::numeric_limits<std::int64_t>::max(); overflow = true; }
+        else total += static_cast<std::int64_t>(n);
+    }
+    dw_dev_overlap_event * storage_;
+    std::size_t capacity_, used_ = 0;
+    std::uint64_t windows_ = 0, bad_interval_ = 0, bad_window_ = 0, dropped_ = 0;
+};
diff --git a/overlay/mtp-async-protocol-candidate-20261027/dw-thru.h b/overlay/mtp-async-protocol-candidate-20261027/dw-thru.h
new file mode 100644
index 0000000..0a9be41
--- /dev/null
+++ b/overlay/mtp-async-protocol-candidate-20261027/dw-thru.h
@@ -0,0 +1,172 @@
+#pragma once
+
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <mutex>
+
+// DUALWIN-THRU (GGML_TP5_DW_THRU=1) host-interval counter.
+//
+// Every number here is a HOST in-flight interval, never a device execution
+// timestamp. overlap_ns proves that both windows had host work in flight at the
+// same time; it never proves that two GPU streams executed concurrently.
+//
+// Clock discipline: transition() takes the mutex FIRST and samples the clock
+// while holding it, so the order in which two windows' transitions are
+// recorded is exactly the order in which they acquired the counter. Sampling
+// outside the lock would let two workers' timestamps invert inside the
+// critical section and rewind last_ (charging one interval twice and leaving
+// another uncharged). A non-monotonic sample (steady_clock is monotonic, so
+// this only fires on a clock anomaly) is dropped and counted, never rewound.
+//
+// The mutex serializes transitions and timestamps together. The algorithm is
+// the interval accumulation of overlap-counter.h: on every transition at
+// `now`, the elapsed interval since the previous transition is charged to
+// whichever windows were active during it, and to the overlap when both were.
+//
+// What this counter can and cannot prove:
+//   - overlap_ns is HOST in-flight intersection: both windows had host work
+//     between two consecutive transitions. It is neither a device timestamp
+//     nor a proof of GPU concurrency.
+//   - overlap_ns == 0 does NOT prove the absence of cross-window
+//     serialization. It is also what a lockstep schedule produces (the windows
+//     alternate, so their host intervals never intersect), and what a
+//     submission path that is serialized before the counter's begin() point
+//     produces. It only means no host interval of one window straddled a host
+//     interval of the other.
+//   - overlap_ns > 0 proves only that host concurrency was not eliminated. It
+//     is a necessary, not sufficient, condition for device concurrency.
+//   - Cross-window serialization must be argued from the lock inventory
+//     (per-window submit mutex, per-window courier, distinct relay priority)
+//     and from submit_wait*_ns staying ~0, not from overlap_ns alone.
+//   - order_violations == 0 proves the recorded event order is a single
+//     monotonic sequence, so the intervals above are not artifacts of lock
+//     unfairness. A nonzero value invalidates the overlap numbers.
+class dw_thru_counter {
+public:
+    // Window enters host-in-flight (its decode submission was observed).
+    void begin(unsigned window) { transition(window, true); }
+
+    // Window leaves host-in-flight (its completion wait returned).
+    void end(unsigned window) { transition(window, false); }
+
+    // Host time blocked acquiring this window's OWN submit mutex. With one
+    // submission thread per window this stays ~0; a nonzero value means
+    // something else still sits on this window's submission path.
+    void submit_wait(unsigned window, std::uint64_t ns) {
+        std::lock_guard<std::mutex> lock(mutex_);
+        submit_wait_[slot(window)] += ns;
+    }
+
+    // Host time blocked acquiring the device-global cold-capture mutex
+    // (HIP graph capture/instantiate is a device-wide operation, so it cannot
+    // be made private to a window; it is only taken on a shape change).
+    void cold_wait(unsigned window, std::uint64_t ns) {
+        std::lock_guard<std::mutex> lock(mutex_);
+        cold_wait_[slot(window)] += ns;
+    }
+
+    // Host time holding that mutex across one shape-change decode.
+    void cold_hold(std::uint64_t ns) {
+        std::lock_guard<std::mutex> lock(mutex_);
+        cold_hold_ += ns;
+        ++cold_holds_;
+    }
+
+    // Busy host-in-flight time of one window; used only to compute idle
+    // fractions against wall time after the workers have been joined.
+    std::uint64_t busy_ns(unsigned window) const {
+        std::lock_guard<std::mutex> lock(mutex_);
+        return busy_[slot(window)];
+    }
+
+    // One line, name=value, analyzers parse by name. Called after every worker
+    // has been joined, but still takes the lock so a late submit_wait/cold_*
+    // can never tear the line.
+    void dump() const {
+        std::lock_guard<std::mutex> lock(mutex_);
+        incomplete_ = unsigned(active_[0] || active_[1]);
+        const std::uint64_t wall = last_ > first_ ? last_ - first_ : 0;
+        std::fprintf(stderr,
+            "TP5_DW_THRU_CTR wall_ns=%llu intervals0=%llu intervals1=%llu busy0_ns=%llu busy1_ns=%llu overlap_ns=%llu both_entries=%llu max_concurrent=%u overlap_wall=%.9f overlap_busy0=%.9f overlap_busy1=%.9f submit_wait0_ns=%llu submit_wait1_ns=%llu cold_wait0_ns=%llu cold_wait1_ns=%llu cold_hold_ns=%llu cold_holds=%llu order_violations=%llu discarded_reversed=%llu incomplete=%u\n",
+            (unsigned long long)wall,
+            (unsigned long long)intervals_[0], (unsigned long long)intervals_[1],
+            (unsigned long long)busy_[0], (unsigned long long)busy_[1],
+            (unsigned long long)overlap_, (unsigned long long)both_entries_, max_concurrent_,
+            wall ? double(overlap_) / double(wall) : 0.0,
+            busy_[0] ? double(overlap_) / double(busy_[0]) : 0.0,
+            busy_[1] ? double(overlap_) / double(busy_[1]) : 0.0,
+            (unsigned long long)submit_wait_[0], (unsigned long long)submit_wait_[1],
+            (unsigned long long)cold_wait_[0], (unsigned long long)cold_wait_[1],
+            (unsigned long long)cold_hold_, (unsigned long long)cold_holds_,
+            (unsigned long long)order_violations_, (unsigned long long)discarded_reversed_,
+            incomplete_);
+        // Event-order receipt: the per-window sequence ranges and the global
+        // monotonic-order violations. A run whose overlap numbers matter must
+        // show order_violations=0.
+        std::fprintf(stderr,
+            "TP5_DW_THRU_ORDER seq0_first=%llu seq0_last=%llu seq1_first=%llu seq1_last=%llu events=%llu order_violations=%llu\n",
+            (unsigned long long)seq_first_[0], (unsigned long long)seq_last_[0],
+            (unsigned long long)seq_first_[1], (unsigned long long)seq_last_[1],
+            (unsigned long long)events_, (unsigned long long)order_violations_);
+    }
+
+private:
+    static unsigned slot(unsigned window) { return window & 1u; }
+
+    void transition(unsigned window, bool begin) {
+        std::lock_guard<std::mutex> lock(mutex_);
+        // Sampled under the lock, AFTER acquiring it: the recorded order is
+        // the order in which the windows actually acquired the counter, not
+        // the order in which they sampled a clock outside it. Sampling before
+        // the lock would let two workers' timestamps invert inside the
+        // critical section and rewind last_.
+        const std::uint64_t now = std::uint64_t(
+            std::chrono::duration_cast<std::chrono::nanoseconds>(
+                std::chrono::steady_clock::now().time_since_epoch()).count());
+        const unsigned w = slot(window);
+        if (last_ && now < last_) {
+            // Never rewind: a rewound last_ would charge one interval twice and
+            // leave another uncharged. Drop the event and make it visible.
+            ++discarded_reversed_;
+            return;
+        }
+        if (first_ == 0 || now < first_) first_ = now;
+        const std::uint64_t elapsed = last_ ? now - last_ : 0;
+        if (last_) {
+            if (active_[0]) busy_[0] += elapsed;
+            if (active_[1]) busy_[1] += elapsed;
+            if (active_[0] && active_[1]) overlap_ += elapsed;
+        }
+        last_ = now;
+        active_[w] = begin;
+        ++events_;
+        ++seq_;
+        if (seq_first_[w] == 0) seq_first_[w] = seq_;
+        seq_last_[w] = seq_;
+        if (begin) {
+            ++intervals_[w];
+            const unsigned concurrent = unsigned(active_[0]) + unsigned(active_[1]);
+            if (concurrent > max_concurrent_) max_concurrent_ = concurrent;
+            if (concurrent == 2) ++both_entries_;
+        }
+        // Per-window sequences must interleave monotonically: window w's
+        // events are a subsequence of the global sequence, so its last recorded
+        // sequence number is always the newest event of that window.
+        if (seq_last_[w] > seq_) ++order_violations_;
+    }
+
+    mutable std::mutex mutex_;
+    bool active_[2] = {};
+    std::uint64_t busy_[2] = {};
+    std::uint64_t intervals_[2] = {};
+    std::uint64_t submit_wait_[2] = {};
+    std::uint64_t cold_wait_[2] = {};
+    std::uint64_t seq_first_[2] = {};
+    std::uint64_t seq_last_[2] = {};
+    std::uint64_t first_ = 0, last_ = 0, overlap_ = 0;
+    std::uint64_t both_entries_ = 0, cold_hold_ = 0, cold_holds_ = 0;
+    std::uint64_t events_ = 0, seq_ = 0, order_violations_ = 0, discarded_reversed_ = 0;
+    unsigned max_concurrent_ = 0;
+    mutable unsigned incomplete_ = 0;
+};
diff --git a/overlay/mtp-async-protocol-candidate-20261027/dw_device_wait.h b/overlay/mtp-async-protocol-candidate-20261027/dw_device_wait.h
new file mode 100644
index 0000000..319b609
--- /dev/null
+++ b/overlay/mtp-async-protocol-candidate-20261027/dw_device_wait.h
@@ -0,0 +1,99 @@
+// DUALWIN-DEVICE-WAIT (GGML_TP5_DW_DEVICE_WAIT=1): gate parsing, peer
+// selection and the wait/decision state machine for the overlay
+// mtp-async runtime's production consumption points (target decode /
+// verified-prefix replay). This is the overlay product's own copy: the fork
+// tp5-compose runtime no longer ships or includes this header (its symmetric
+// per-epoch peer wait was a same-phase rendezvous with no cross-window data
+// dependency and was removed), so there is no longer a fork mirror to keep
+// byte-identical. `dw_event_trace.h` is still mirrored by both runtimes. The
+// header holds everything testable without a GPU: the exact-"1" gate, the
+// one-window-has-no-peer rule, the release/acquire pairing contract and the
+// watermark that makes every record consumed at most once and never waits on
+// an unrecorded event.
+//
+// HONEST SCOPE: whether the wait's stream/device actually covers relay work
+// is unverified (inherited from the r7/r8 wording); the wait can only delay
+// a consumption behind work the peer already submitted — it never weakens an
+// exit predicate. Deadlock freedom does NOT rest on assertion: per the
+// CUDA/HIP event contract (cudaEventRecord: "cudaStreamWaitEvent() use[s]
+// the most recently captured state at the time of the API call, and [is]
+// not affected by later calls to cudaEventRecord()"), a wait enqueued at
+// host time T binds to a record issued at T_R <= T (the release/acquire
+// pairing below guarantees the record's host call returned before T); any
+// wait contained in that captured work was enqueued before T_R and binds
+// strictly earlier, so binding times strictly decrease along any
+// wait->captured-work->wait chain — finite, hence acyclic. Re-records cannot
+// retarget an enqueued wait.
+#pragma once
+
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+
+namespace dw_device_wait {
+
+// Exact "1", read once at first call (static initialization at the runtime's
+// gate aliases; unset/"0"/"2"/"1x" keep every site a counted no-op).
+inline bool gate() {
+    static const bool on = [] {
+        const char * v = std::getenv("GGML_TP5_DW_DEVICE_WAIT");
+        return v != nullptr && std::strcmp(v, "1") == 0;
+    }();
+    return on;
+}
+
+// Peer selection: the cyclic neighbour (the dualwin pair for two windows).
+inline std::uint32_t peer_of(std::uint32_t wi, std::uint32_t windows) noexcept {
+    return windows > 1u ? (wi + 1u) % windows : wi;
+}
+
+inline bool has_peer(std::uint32_t wi, std::uint32_t windows) noexcept {
+    return windows > 1u && peer_of(wi, windows) != wi;
+}
+
+// What the runtime knows about the peer at a consumption point. All fields
+// are cheap reads; peer_event comes from the event pointers and same_device
+// from the first-child devices resolved once at event creation
+// (single-threaded setup, before any decode worker runs).
+// NOTE: the tree Meta source no longer exports
+// ggml_backend_meta_first_child_device (the fork runtime that used it removed
+// its peer-wait layer), and this overlay's own Meta build never defined it.
+// This overlay runtime therefore needs that resolution supplied by its own
+// Meta patch/build (a public, read-only first-simple-child query) before it
+// can link against either Meta source; the planner below is unchanged.
+struct context {
+    bool event_gate  = false;  // GGML_TP5_DW_BACKEND_EVENT=1 (events exist)
+    bool have_peer   = false;  // windows > 1
+    bool peer_event  = false;  // the peer's event pointer is non-null
+    bool self_event  = false;  // this window's event pointer is non-null
+    bool same_device = false;  // both windows resolved the SAME first-child
+                               // device (unknown device never waits)
+};
+
+inline bool peer_usable(const context & c) noexcept {
+    return c.event_gate && c.have_peer && c.peer_event && c.self_event && c.same_device;
+}
+
+enum class action { none, wait, skip_unavailable, skip_unrecorded };
+
+// The production decision. peer_available is the peer's released publication
+// count (acquire load in the caller); peer_consumed is this window's
+// watermark — written ONLY by this window's own thread. A wait is planned
+// iff the peer is usable AND published something not yet consumed; the
+// watermark then advances to the observed value, so each published record is
+// decided exactly once and a stale/empty count never issues a wait. The
+// caller issues the non-blocking ggml_backend_event_wait enqueue only on
+// action::wait.
+inline action plan(const context & c, std::uint64_t peer_available,
+                   std::uint64_t & peer_consumed) noexcept {
+    if (!peer_usable(c)) {
+        return action::skip_unavailable;
+    }
+    if (peer_available > peer_consumed) {
+        peer_consumed = peer_available;
+        return action::wait;
+    }
+    return action::skip_unrecorded;
+}
+
+}  // namespace dw_device_wait
diff --git a/overlay/mtp-async-protocol-candidate-20261027/dw_event_trace.h b/overlay/mtp-async-protocol-candidate-20261027/dw_event_trace.h
new file mode 100644
index 0000000..0fa93f0
--- /dev/null
+++ b/overlay/mtp-async-protocol-candidate-20261027/dw_event_trace.h
@@ -0,0 +1,211 @@
+// DUALWIN r8 event-overlap trace (GGML_TP5_DW_EVENT_TRACE=1) — self-contained
+// host-correlation trace buffers shared verbatim by the fork tp5-compose and
+// overlay mtp-async runtimes (single source of truth: the two copies are kept
+// byte-identical by the same sync discipline as the dual-wait method blocks).
+//
+// HONEST SCOPE: every timestamp here is a HOST steady-clock sample of a
+// host-visible observation (the relay snapshot's finished flag, the courier
+// retirement equality, the proven dual-conjunction pass). Host correlation
+// metadata NEVER proves device-side kernel overlap or device event timing;
+// device evidence remains the rocprof route from the r7 GPU-event RUNBOOK.
+//
+// GATING: the gate is read once at static initialization; unset, "0", "2",
+// "1x" or any other value keeps every trace call site a no-op (no timestamps,
+// no output, no records). Records are pushed ONLY for epochs consumed through
+// the proven dual wait (a fallback/timeout/latched epoch emits nothing).
+#pragma once
+
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <memory>
+
+namespace dw_event_trace {
+
+static constexpr std::size_t kRingCapacity = 4096;
+static constexpr std::size_t kDetailLines  = 8;
+
+// Exact "1" gate, read once (same convention as every gate in this tree).
+inline bool gate() {
+    static const bool on = [] {
+        const char * v = std::getenv("GGML_TP5_DW_EVENT_TRACE");
+        return v != nullptr && std::strcmp(v, "1") == 0;
+    }();
+    return on;
+}
+
+// One line, once per process, at the first trace summary emission.
+inline void banner() {
+    static const bool printed = [] {
+        std::fprintf(stderr,
+                     "TP5_DW_EVENT_TRACE enabled=1 flag=GGML_TP5_DW_EVENT_TRACE scope=host_correlation clock=steady_monotonic ring=%zu note=host_timestamps_never_prove_device_overlap\n",
+                     kRingCapacity);
+        return true;
+    }();
+    (void) printed;
+}
+
+// Event-point trace fields shared with the overlay runtime: host timestamps
+// around real ggml_backend_event record/synchronize/wait call sites, per
+// window. Still HOST correlation metadata — never device interval evidence.
+// wait_calls/wait_first_ns/wait_last_ns are populated by the overlay product
+// only (its GGML_TP5_DW_DEVICE_WAIT peer waits); the fork compose runtime
+// removed its peer-wait layer, so those three stay 0 there and are not a
+// zero-valued measurement. Its record_*/sync_* stamps are host call-site
+// correlation for the peer events that no longer exist in the fork either.
+struct evpt {
+    std::uint64_t record_first_ns = 0;  // first record() call-site stamp
+    std::uint64_t record_last_ns  = 0;  // latest record() call-site stamp
+    std::uint64_t sync_first_ns   = 0;  // first drain synchronize() entry stamp
+    std::uint64_t sync_last_ns    = 0;  // latest synchronize() entry stamp
+    std::uint64_t sync_ns         = 0;  // accumulated host time inside synchronize()
+    std::uint64_t sync_max_ns     = 0;  // longest single synchronize() host wait
+    std::uint64_t wait_calls      = 0;  // device-side waits issued (GGML_TP5_DW_DEVICE_WAIT=1)
+    std::uint64_t wait_first_ns   = 0;  // first device-side wait() call-site stamp
+    std::uint64_t wait_last_ns    = 0;  // latest device-side wait() call-site stamp
+};
+
+
+struct rec {
+    std::uint64_t seq         = 0;  // per-window traced-epoch sequence, 0-based
+    std::uint64_t relay_epoch = 0;
+    std::uint64_t entry_ns    = 0;  // dual wait entry (post-latch check)
+    std::uint64_t dev_ns      = 0;  // first host observation of status.finished
+    std::uint64_t cour_ns     = 0;  // first host observation of retirement equality
+    std::uint64_t consumed_ns = 0;  // the proven dual-conjunction pass
+    int           order       = 0;  // 1 device-first, 2 courier-first, 0 same-pass
+};
+
+// Single-writer ring: only the window's own dual-wait worker pushes; the exit
+// dump reads after the service stopped and every lane joined. No atomics.
+// The fixed ring is allocated lazily on the first push, so a gate-OFF window
+// never allocates or initializes it (OFF adds one unallocated empty buf per
+// window, nothing more). dev_ns/cour_ns of a pushed record are always
+// initialized: the push only happens on a proven conjunction pass, where
+// both sightings were stamped (with a defensive fallback to consumed_ns at
+// the push, so a record can never carry an unset 0 stamp).
+class buf {
+  public:
+    void push(const rec & r) {
+        if (ring_ == nullptr) {
+            // Lazy allocation: first traced epoch in this window pays one
+            // allocation; gate-OFF windows never reach this line.
+            ring_.reset(new rec[kRingCapacity]);
+        }
+        rec & slot      = ring_[head_];
+        slot            = r;
+        slot.seq        = pushed_;
+        head_           = (head_ + 1) % kRingCapacity;
+        if (count_ < kRingCapacity) {
+            ++count_;
+        } else {
+            ++dropped_;
+        }
+        ++pushed_;
+        if (r.order == 1) {
+            ++device_first_;
+        } else if (r.order == 2) {
+            ++courier_first_;
+        } else {
+            ++same_pass_;
+        }
+    }
+
+    std::uint64_t pushed() const noexcept { return pushed_; }
+    std::uint64_t dropped() const noexcept { return dropped_; }
+    std::uint64_t device_first() const noexcept { return device_first_; }
+    std::uint64_t courier_first() const noexcept { return courier_first_; }
+    std::uint64_t same_pass() const noexcept { return same_pass_; }
+
+    // Held record with per-window sequence s, or nullptr when evicted/never
+    // pushed. The ring holds the last min(pushed_, kRingCapacity) records.
+    // Layout: while the ring is not full the seq-s record sits at ring_[s];
+    // once full, head_ points at the OLDEST record. Both cases are covered
+    // by (head_ + kRingCapacity - (pushed_ - s)) % kRingCapacity: the
+    // unsigned subtraction never underflows because pushed_ - s <= count_ <=
+    // kRingCapacity.
+    const rec * by_seq(std::uint64_t s) const noexcept {
+        if (ring_ == nullptr || s >= pushed_) return nullptr;
+        const std::uint64_t first_seq = pushed_ - count_;
+        if (s < first_seq) return nullptr;
+        return &ring_[(head_ + kRingCapacity - (pushed_ - s)) % kRingCapacity];
+    }
+
+    // Per-window summary line plus the first kDetailLines chronological
+    // detail lines (held records only; evicted epochs are counted, not
+    // printed).
+    void dump_win(std::size_t window) const {
+        std::fprintf(stderr,
+                     "TP5_DW_EVENT_TRACE_WIN window=%zu epochs=%llu recorded=%llu dropped=%llu "
+                     "device_first=%llu courier_first=%llu same_tick=%llu\n",
+                     window, (unsigned long long) pushed_, (unsigned long long) (pushed_ - dropped_),
+                     (unsigned long long) dropped_, (unsigned long long) device_first_,
+                     (unsigned long long) courier_first_, (unsigned long long) same_pass_);
+        std::uint64_t printed = 0;
+        for (std::uint64_t s = (pushed_ > count_ ? pushed_ - count_ : 0); s < pushed_ && printed < kDetailLines;
+             ++s) {
+            const rec * r = by_seq(s);
+            if (r == nullptr) continue;
