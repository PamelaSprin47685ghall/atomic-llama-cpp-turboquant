+        payload = bench.request_payload('如何减肥', '请用中文简洁回答，约200个token。', 320)
+        self.assertEqual(payload['messages'], [
+            {'role': 'system', 'content': '请用中文简洁回答，约200个token。'},
+            {'role': 'user', 'content': '如何减肥'}])
+        self.assertEqual(payload['max_tokens'], 320)
