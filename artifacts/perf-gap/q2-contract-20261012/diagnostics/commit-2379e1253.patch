+        TEST_ASSERT(g_prepare_graph(comm, j, gf_cons, false, 1));
+        TEST_ASSERT(ggml_backend_graph_compute(backends[j], gf_cons) == GGML_STATUS_SUCCESS);
+        TEST_ASSERT(g_get_cached_cmd_bufs(backends[j], gf_cons, cbs[1][j]));
