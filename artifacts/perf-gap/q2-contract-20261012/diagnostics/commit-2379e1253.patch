diff --git a/ggml/src/ggml-vulkan/ggml-vulkan-tp5-sparse-timing.h b/ggml/src/ggml-vulkan/ggml-vulkan-tp5-sparse-timing.h
new file mode 100644
index 000000000..27b5bef1e
--- /dev/null
+++ b/ggml/src/ggml-vulkan/ggml-vulkan-tp5-sparse-timing.h
@@ -0,0 +1,41 @@
+#pragma once
+#include <cstdint>
+#include <cstdlib>
+#include <string>
+
+// Selection of existing timestamp IDs, not a modification of graph commands.
+// Unselected queries must never be waited on or read as completed samples.
+struct vk_tp5_sparse_timing {
+    bool sparse = false;
+    bool valid = true;
+    uint32_t stride = 0;
+    uint32_t residue = 0;
+
+    static vk_tp5_sparse_timing parse(const char * text) {
+        vk_tp5_sparse_timing s;
+        if (!text) return s;
+        s.sparse = true;
+        if (std::string(text) == "span") return s;
+        const std::string value(text);
+        const auto colon = value.find(':');
+        if (colon == std::string::npos || colon == 0 || colon + 1 == value.size()) { s.valid = false; return s; }
+        const auto integer = [](const std::string & x, uint32_t & out) {
+            if (x.empty() || x.size() > 3 || x.find_first_not_of("0123456789") != std::string::npos) return false;
+            out = (uint32_t) std::strtoul(x.c_str(), nullptr, 10);
+            return true;
+        };
+        s.valid = integer(value.substr(0, colon), s.stride) && integer(value.substr(colon+1), s.residue) &&
+                  s.stride >= 1 && s.stride <= 97 && s.residue < s.stride;
+        return s;
+    }
+    bool stage(uint32_t s) const { return !sparse || (stride && s % stride == residue); }
+    bool query(uint32_t q, uint32_t stages) const {
+        if (!valid || q >= 5 * stages + 3) return false;
+        return !sparse || q == 0 || q == 5 * stages + 2 || stage(q / 5);
+    }
+};
+
+inline const vk_tp5_sparse_timing & vk_tp5_timing_selection() {
+    static const auto s = vk_tp5_sparse_timing::parse(std::getenv("GGML_TP5_GPU_TIMING_SPARSE"));
+    return s;
+}
diff --git a/ggml/src/ggml-vulkan/ggml-vulkan-tp5-submit-pool.h b/ggml/src/ggml-vulkan/ggml-vulkan-tp5-submit-pool.h
new file mode 100644
index 000000000..efc123f4e
--- /dev/null
+++ b/ggml/src/ggml-vulkan/ggml-vulkan-tp5-submit-pool.h
@@ -0,0 +1,70 @@
+#pragma once
+#include <array>
+#include <chrono>
+#include <condition_variable>
+#include <cstddef>
+#include <cstdint>
+#include <functional>
+#include <mutex>
+#include <thread>
+
+// One worker per DISTINCT VkQueue. The caller owns external synchronization.
+// No worker mutates the communicator or timeline bookkeeping: the caller must
+// retire EVERY successful submission, even when another rank fails.
+class vk_tp5_submit_pool {
+public:
+    static constexpr size_t ranks=5;
+    using results=std::array<int,ranks>;
+    vk_tp5_submit_pool() {
+        try {
+            for(size_t i=0;i<ranks;++i) workers[i]=std::thread([this,i]{work(i);});
+        } catch (...) {stop_and_join();throw;}
+    }
+    ~vk_tp5_submit_pool(){stop_and_join();}
+    vk_tp5_submit_pool(const vk_tp5_submit_pool&)=delete;
+    vk_tp5_submit_pool&operator=(const vk_tp5_submit_pool&)=delete;
+
+    bool run(std::function<int(size_t)> call,results & out,
+             std::chrono::milliseconds deadline=std::chrono::milliseconds(2000)) {
+        out.fill(-13); // refusal means no native submission, never VK_SUCCESS
+        std::unique_lock<std::mutex> lock(mutex);
+        if(stop||completed!=ranks)return false;
+        task=std::move(call);codes.fill(-13);completed=0;++epoch;ready.notify_all();
+        const bool done=finished.wait_for(lock,deadline,[this]{return completed==ranks;});
+        if(!done) {
+            // Never return while accepted native submissions may still be
+            // written into a caller-owned result array. Poison the pool, join
+            // workers, then hand ALL real return codes back for native drain.
+            stop=true;lock.unlock();ready.notify_all();join();lock.lock();
+        }
+        out=codes;task={};return done;
+    }
+private:
+    std::array<std::thread,ranks> workers;
+    std::mutex mutex;
+    std::condition_variable ready,finished;
+    std::function<int(size_t)> task;
+    results codes{};
+    size_t completed=ranks;
+    uint64_t epoch=0;
+    bool stop=false;
+    void work(size_t rank) {
+        uint64_t observed=0;
+        std::unique_lock<std::mutex> lock(mutex);
+        for(;;) {
+            ready.wait(lock,[&]{return stop||epoch!=observed;});
+            if(stop&&epoch==observed)return;
+            observed=epoch;lock.unlock();
+            int result=-13;
+            try {result=task(rank);}catch(...){result=-13;}
+            lock.lock();codes[rank]=result;++completed;
+            if(completed==ranks)finished.notify_one();
+            if(stop)return;
+        }
+    }
+    void join(){for(auto & t:workers)if(t.joinable())t.join();}
+    void stop_and_join(){
+        {std::lock_guard<std::mutex> lock(mutex);stop=true;}
+        ready.notify_all();join();
+    }
+};
