diff --git a/tests/tp5-peer-timeline.comp b/tests/tp5-peer-timeline.comp
new file mode 100644
index 000000000..f620b79ec
--- /dev/null
+++ b/tests/tp5-peer-timeline.comp
@@ -0,0 +1,37 @@
+#version 450
+// Each dispatch is a stage in a five-device external timeline-semaphore chain.
+// Cache visibility comes from release/acquire semaphore dependencies, not from
+// guessing that ordinary HOST_COHERENT imports are device-coherent.
+layout(local_size_x=256) in;
+layout(std430,binding=0) buffer Shared { uint words[]; };
+layout(std430,binding=0) buffer Shared128 { uvec4 vectors[]; };
+layout(push_constant) uniform Parameters {
+    uint rank; uint elements; uint stage; uint stages; uint first_epoch; uint run;
+    uint stride_words; uint output_words; uint reserved0; uint reserved1;
+} p;
+void main(){
+    const uint lane=gl_LocalInvocationID.x;
+    const uint bank=p.stage&1u;
+    const uint own=(bank*5u+p.rank)*p.stride_words;
+    for(uint v=lane;v<p.elements/4u;v+=256u){
+        vec4 result;
+        if(p.stage==0u){
+            for(uint c=0u;c<4u;++c)
+                result[c]=float(p.rank+1u)*0.25+float((4u*v+c)%7u)*0.03125+float(p.run%8u)*0.0625;
+        }else{
+            precise vec4 sum=vec4(0.0);
+            const uint prior=(p.stage-1u)&1u;
+            for(uint r=0u;r<5u;++r){
+                const uint base=(prior*5u+r)*p.stride_words+16u;
+                sum+=uintBitsToFloat(vectors[base/4u+v]);
+            }
+            precise vec4 scaled=sum*0.125;
+            precise vec4 biased=scaled+vec4(float(p.rank+1u)*0.25);
+            for(uint c=0u;c<4u;++c)result[c]=biased[c]+float((4u*v+c)%7u)*0.03125;
+        }
+        vectors[(own+16u)/4u+v]=floatBitsToUint(result);
+        if(p.stage==p.stages)vectors[(p.output_words+p.rank*p.elements)/4u+v]=floatBitsToUint(result);
+    }
+    memoryBarrierBuffer();barrier();
+    if(lane==0u){words[own]=p.first_epoch+p.stage;words[own+2u]=p.first_epoch+p.stage;}
+}
diff --git a/tests/tp5-stream-probe.cpp b/tests/tp5-stream-probe.cpp
new file mode 100644
index 000000000..bcd998037
--- /dev/null
+++ b/tests/tp5-stream-probe.cpp
@@ -0,0 +1,69 @@
+// Read+write streaming calibration, not GEMV performance or model tok/s.
+// Four independent 64 MiB inputs and outputs exceed the RX 6800 cache.
+// Run serially under the TP5 GPU lock, never alongside a model benchmark.
+#include "ggml.h"
+#include "ggml-backend.h"
+#include "ggml-alloc.h"
+#include "ggml-vulkan.h"
+
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <vector>
+
+int main(int argc, char ** argv) {
+    if (argc != 2 || argv[1][0] < '0' || argv[1][0] > '4' || argv[1][1] != '\0') return 2;
+    const size_t device = static_cast<size_t>(argv[1][0] - '0');
+    auto * reg = ggml_backend_vk_reg();
+    if (ggml_backend_reg_dev_count(reg) <= device) return 2;
+    auto * backend = ggml_backend_dev_init(ggml_backend_reg_dev_get(reg, device), nullptr);
+    if (!backend) return 2;
+    constexpr size_t parts = 4, elements = 16 * 1024 * 1024;
+    constexpr float scale = 1.0001f;
+    auto * ctx = ggml_init({8 * 1024 * 1024, nullptr, true});
+    if (!ctx) { ggml_backend_free(backend); return 2; }
+    auto * graph = ggml_new_graph_custom(ctx, 1024, false);
+    ggml_tensor * src[parts];
+    ggml_tensor * dst[parts];
+    for (size_t i = 0; i < parts; ++i) {
+        src[i] = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, elements);
+        dst[i] = ggml_scale(ctx, src[i], scale);
+        ggml_build_forward_expand(graph, dst[i]);
+    }
+    auto * buffer = ggml_backend_alloc_ctx_tensors(ctx, backend);
+    if (!buffer) { ggml_free(ctx); ggml_backend_free(backend); return 2; }
+    std::vector<float> host(elements);
+    for (size_t i = 0; i < elements; ++i) host[i] = float(i % 1024) / 1024.0f;
+    for (auto * t : src) ggml_backend_tensor_set(t, host.data(), 0, elements * sizeof(float));
+    std::vector<double> times;
+    int result = 0;
+    for (int iteration = 0; iteration < 24; ++iteration) {
+        const auto begin = std::chrono::steady_clock::now();
+        if (ggml_backend_graph_compute(backend, graph) != GGML_STATUS_SUCCESS) { result = 1; break; }
+        ggml_backend_synchronize(backend);
+        const double ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - begin).count();
+        if (iteration >= 4) times.push_back(ms);
+    }
+    for (auto * t : dst) {
+        float observed = 0;
+        ggml_backend_tensor_get(t, &observed, (elements - 1) * sizeof(float), sizeof(float));
+        if (std::fabs(observed - host.back() * scale) > 1e-5f) result = 1;
+    }
+    if (!result && times.size() == 20) {
+        std::sort(times.begin(), times.end());
+        const double median = 0.5 * (times[9] + times[10]);
+        const size_t bytes = 2 * parts * elements * sizeof(float);
+        std::printf("{\"device\":%zu,\"status\":\"STREAM_CALIBRATION_NOT_MODEL\",\"bytes_read_plus_written\":%zu,"
+                    "\"median_ms\":%.9f,\"min_ms\":%.9f,\"p90_ms\":%.9f,\"effective_GB_s\":%.6f,\"samples_ms\":[",
+                    device, bytes, median, times.front(), times[17], bytes / (median * 1e6));
+        for (size_t i = 0; i < times.size(); ++i) std::printf("%s%.9f", i ? "," : "", times[i]);
+        std::printf("]}\n");
+    }
+    ggml_backend_synchronize(backend);
+    ggml_backend_buffer_free(buffer);
+    ggml_free(ctx);
+    ggml_backend_free(backend);
+    return result;
+}
