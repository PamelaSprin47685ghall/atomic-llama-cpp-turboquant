+                '[tp5-relay-gpu] rank=0 rows=1 span_us=15000 compute_us=9000 p2_us=4000 tail_compute_us=1000\n')
+            rows = report.profile(root)
+            self.assertEqual(len(rows), 1)
+            self.assertEqual(rows[0]['cycles'], 0)
