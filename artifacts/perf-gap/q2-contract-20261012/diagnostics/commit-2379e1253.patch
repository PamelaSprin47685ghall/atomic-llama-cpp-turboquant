+        if(expected!=0u && status[p.status_word_offset+2u]==0u) {
+            for(uint spin=0u;spin<p.spin_max;++spin) {
+                used=spin;
+                if((spin&1023u)==0u && status[p.status_word_offset+2u]!=0u) break;
+                if(inbox[0]==expected) {ready=1u;break;}
+            }
+        }
+        if(ready==0u) {
+            atomicCompSwap(status[p.status_word_offset+2u],0u,expected!=0u?expected:0xffffffffu);
+            status[p.status_word_offset+4u]=inbox[0]; used=p.spin_max;
+        }
