+            for(uint col=lane;col<p.width;col+=256u) {
+                combined[base+col]=nanv;normalized[base+col]=nanv;
+                if(stream==0u)sum_output[t*p.width+col]=nanv;
+            }
+            if(lane==0u)inverse_rho[t*4u+stream]=nanv;
+        }
+        return; // Norm never marks the mailbox as consumed/retired.
+    }
+    for(uint t=0u;t<TP5_LATE_CAPACITY_ROWS;++t) {
+        if(t>=live_rows)break;
+        if((p.width&3u)==0u) {
+            for(uint v=gl_LocalInvocationID.x;v<p.width/4u;v+=1024u) {
+                const uvec4 a=inbox128[4u+t*(p.width/4u)+v];
+                y_local[4u*v]=a.x;y_local[4u*v+1u]=a.y;
+                y_local[4u*v+2u]=a.z;y_local[4u*v+3u]=a.w;
+            }
+        }else{
