+            const uint col=lane+i*256u;
+            values[i]=col<p.width?residual[base+col]:0.0;
+        }
+        float ss=0.0;
+        for(uint i=0u;i<16u;++i) {
+            const uint col=lane+i*256u;
+            if(col<p.width) {
+                const float y=uintBitsToFloat(y_local[col]);
+                precise float product=y*s;
+                precise float value=values[i]+product;
+                values[i]=value;combined[base+col]=value;
+                if(stream==0u)sum_output[t*p.width+col]=y;
+            }
+            ss+=values[i]*values[i];
+        }
+        ss=subgroupAdd(ss);
+        if(gl_SubgroupInvocationID==0u)partials[gl_SubgroupID]=ss;
+        barrier();
+        float fold=0.0;
+        for(uint j=0u;j<8u;++j)fold+=partials[stream*8u+j];
+        const float scale=inversesqrt(fold/float(p.width)+p.epsilon);
+        if(lane==0u)inverse_rho[t*4u+stream]=scale;
+        if(lane==0u && (p.profile_spin&2u)!=0u && t<2u)
+            status[p.status_word_offset+8u+t*4u+stream]=floatBitsToUint(scale);
+        for(uint i=0u;i<16u;++i) {
+            const uint col=lane+i*256u;
+            if(col<p.width) {float norm=scale*values[i];normalized[base+col]=norm*gamma[stream*p.width+col];}
+        }
+        barrier(); // Every logical stream finished with this token's sharedY.
+    }
+}
