+        maximum.phase = GGML_PREDEFINED_TARGET;
+        maximum.epoch_lo = 1;
+        maximum.active_sequences = 1;
+        maximum.active_tokens = cap_rows;
+        maximum.active_outputs = cap_rows;
+        maximum.context_tokens = cap_rows;
